# -*- coding: utf-8 -*-
# E2E: salary list fixes (hire_date always filled; future hires excluded from past months)
import json, re, sys, io
import urllib.request
import msgpack

sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8")
BASE = "http://127.0.0.1:8088"

def call(method, path, token=None, body=None):
    req = urllib.request.Request(BASE + path, method=method)
    req.add_header("Content-Type", "application/json")
    if token:
        req.add_header("Authorization", "Bearer " + token)
    data = json.dumps(body).encode("utf-8") if body is not None else None
    with urllib.request.urlopen(req, data=data, timeout=20) as resp:
        return msgpack.unpackb(resp.read(), raw=False)

r = call("POST", "/api/system/auth/login", body={"username": "admin", "password": "admin123"})
s = json.dumps(r, default=str)
toks = re.findall(r"eyJ[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+", s)
assert toks, "no jwt: " + s[:200]
token = max(toks, key=len)
print("1. login ok")

for (y, m) in [(2026, 7), (2026, 8)]:
    r = call("GET", "/api/system/finance/salary/list?year=%d&month=%d&page=1&pageSize=50" % (y, m), token)
    assert r.get("code") == 200, str(r)[:300]
    data = r.get("data") or []
    rows = data if isinstance(data, list) else data.get("items") or []
    names = [(row.get("employeeName"), row.get("hireDate")) for row in rows]
    missing_hire = [n for n, h in names if not h]
    has_ceo = any(n and "CEO" in n for n, _ in names)
    print("%d-%02d rows=%d CEO=%s missing_hire_date=%s" % (y, m, len(rows), has_ceo, missing_hire))
    for n, h in sorted(names, key=lambda x: x[1] or ""):
        print("    %-8s hire=%s" % (n, h))

print("DONE")
