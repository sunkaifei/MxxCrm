use crate::core::kit::global::AppState;
use crate::core::kit::CONTEXT;
use crate::core::web::response::MetaResp as _;
use actix_web::{get, post, web, HttpResponse};
use base64::{engine, Engine};
use captcha::filters::{Dots, Noise, Wave};
use captcha::Captcha;
use std::collections::HashMap;
use std::time::Duration;

use crate::core::web::response::{MetaResp, MPACK};

// 定义验证码路由处理函数
#[get("/get")]
pub async fn get_captcha() -> Result<HttpResponse, Box<dyn std::error::Error>> {
    // 生成验证码图像
    let mut captcha = Captcha::new();
    captcha
        .add_chars(4)
        .apply_filter(Noise::new(0.1))
        .apply_filter(Wave::new(1.0, 10.0).horizontal())
        .view(160, 60)
        .apply_filter(Dots::new(4));
    let captcha_str = captcha.chars_as_string().to_lowercase();

    //用于验证码校验
    let uuid = uuid::Uuid::new_v4().to_string();
    // A-0.2：验证码缓存 10 分钟（原实现无 TTL 永不过期，存在重放爆破窗口）
    let result = CONTEXT.cache_service.set_string_ex(
        &format!("captcha:cache_{}", uuid.as_str()),
        &captcha_str.as_str(),
        Some(Duration::from_secs(600)),
    ).await;
    if result.is_err() {
        return Ok(HttpResponse::Ok().content_type(MPACK).body(MetaResp::<String>::fail(400, "创建验证码失败", "local")));
    }
    let png = captcha.as_png().unwrap_or_default();
    let base64_captcha = engine::general_purpose::STANDARD.encode(png);
    let mut hashmap = HashMap::new();
    hashmap.insert("captchaKey", uuid);
    hashmap.insert("captchaBase64", base64_captcha);
    // 返回验证码图像
    Ok(HttpResponse::Ok().content_type(MPACK).body(MetaResp::success(hashmap, "local")))
}

// ==================== 文字点选验证码（批2 方案：docs/09-认证登录与权限/文字点选验证码开发方案.md）====================

/// GET /pub/captcha/config - 验证码形态配置（前端登录页分派 image / click）
#[get("/config")]
pub async fn get_captcha_config(state: web::Data<AppState>) -> crate::core::errors::error::Result<HttpResponse> {
    let login_mode = crate::modules::system::service::captcha_service::get_page_captcha_mode("login").await;
    let register_mode = crate::modules::system::service::captcha_service::get_page_captcha_mode("register").await;
    use crate::core::web::response::MetaResp;
    Ok(HttpResponse::Ok().content_type(MPACK).body(MetaResp::success(
        serde_json::json!({
            "enabled": login_mode != "disabled" || register_mode != "disabled",
            "mode": if login_mode == "none" { "image".to_string() } else { login_mode.clone() },
            "login": login_mode,
            "register": register_mode,
        }),
        "local",
    )))
}

/// GET /pub/captcha/click/get - 生成文字点选图（公开）
#[get("/click/get")]
pub async fn get_click_captcha(state: web::Data<AppState>) -> crate::core::errors::error::Result<HttpResponse> {
    let db = &state.db;
    match crate::modules::system::service::captcha_service::generate_click_captcha(db).await {
        Ok(vo) => Ok(HttpResponse::Ok().content_type(MPACK).body(MetaResp::success(vo, "local"))),
        Err(msg) => Ok(HttpResponse::Ok().content_type(MPACK).body(MetaResp::<String>::fail(400, &msg, "local"))),
    }
}

#[derive(Debug, serde::Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct ClickVerifyRequest {
    pub captcha_key: String,
    pub clicks: Vec<crate::modules::system::service::captcha_service::ClickPointInput>,
    pub display_width: Option<f64>,
    pub display_height: Option<f64>,
}

/// POST /pub/captcha/click/verify - 校验点选并签发一次性登录 ticket（公开）
#[post("/click/verify")]
pub async fn verify_click_captcha(
    state: web::Data<AppState>,
    item: web::Json<ClickVerifyRequest>,
) -> crate::core::errors::error::Result<HttpResponse> {
    let db = &state.db;
    let req = item.into_inner();
    match crate::modules::system::service::captcha_service::verify_click(
        db,
        &req.captcha_key,
        &req.clicks,
        req.display_width,
        req.display_height,
    ).await {
        Ok(vo) => Ok(HttpResponse::Ok().content_type(MPACK).body(MetaResp::success(vo, "local"))),
        Err(msg) => Ok(HttpResponse::Ok().content_type(MPACK).body(MetaResp::<String>::fail(400, &msg, "local"))),
    }
}

/// 路由注册：挂载在 /api/open/captcha 之下（vite 代理 /api → 后端；/pub 前缀前端不可达）
pub fn register(cfg: &mut web::ServiceConfig) {
    cfg.service(get_captcha)
        .service(get_captcha_config)
        .service(get_click_captcha)
        .service(verify_click_captcha);
}
