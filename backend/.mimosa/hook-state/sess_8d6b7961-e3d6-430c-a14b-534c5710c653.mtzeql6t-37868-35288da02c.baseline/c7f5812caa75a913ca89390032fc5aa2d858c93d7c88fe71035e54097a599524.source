    let db = &state.db;

    // A-2.6: 统一走 user_auth 鉴权（JWT 验签 + issuer 校验 + 禁用缓存拦截）
    let user_id = match get_user_id_from_request(&req).await {
        Ok(id) => id,
        Err(resp) => return Ok(resp),
    };

    let mut req = item.into_inner();
    req.user_id = user_id;

    let result = member_fee_service::insert(db, req).await;

    match result {
