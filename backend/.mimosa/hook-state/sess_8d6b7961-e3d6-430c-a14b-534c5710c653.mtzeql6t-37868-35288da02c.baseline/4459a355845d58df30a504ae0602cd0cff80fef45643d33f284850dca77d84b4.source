# -*- coding: utf-8 -*-
"""
e2e_stage1_finance_hardening.py
财务模块阶段一（资金安全止血）E2E 验收脚本
对照：《docs/06-财务与发票/财务模块阶段一开发任务书.md》T1.1~T1.9 + d71~d74

覆盖项：
  A1 微信回调 fail-closed（伪造回调必须 4xx/5xx，绝不入账）            [T1.1]
  A2 会员下单入口已禁用（变体B止血）                                    [T1.3]
  A3 付款单号自动生成 PAY{YYYYMMDD}{seq}                                [T1.9]
  A4 付款金额非法值（1e29 超 Decimal 范围）→ 报错而非静默落 0           [T1.8]
  A5 工资条二次密码 argon2 哈希落库 + 校验通过/失败                     [T1.4]
  A6 数据库级兜底：d71 幂等唯一索引 / d72 余额 CHECK / d73 单号唯一索引 [T1.6/T1.7/T1.9]

执行前提：后端已用本代码重新编译并重启（127.0.0.1:8088）；d71~d74 已执行。
执行：python backend/scripts/e2e_stage1_finance_hardening.py
说明：微信真实退款回调（T1.2）、短信网关验签（T1.5）依赖外部系统，本脚本以
      代码审查 + 本地逻辑验证覆盖，真机联调项见任务书验收清单标注。
"""
import json
import re
import subprocess
import sys

import msgpack

BASE = "http://127.0.0.1:8088"
PG = ["psql", "-U", "postgres", "-h", "127.0.0.1", "-d", "mxxcrm_data", "-t", "-A"]

results = []


def check(name, ok, detail=""):
    results.append((name, ok, detail))
    print(("[PASS] " if ok else "[FAIL] ") + name + ("  -> " + detail if detail else ""))


def psql(sql):
    import os
    env = {"PGPASSWORD": "123456", "PATH": os.environ["PATH"],
           "SYSTEMROOT": os.environ.get("SystemRoot", ""),
           "SYSTEMDRIVE": os.environ.get("SystemDrive", "")}
    out = subprocess.run(PG + ["-c", sql], capture_output=True, env=env)
    # 中文 Windows 下 psql 输出可能为 GBK，做双重解码兜底；错误信息在 stderr，需一并返回
    def _dec(b):
        for enc in ("utf-8", "gbk"):
            try:
                return b.decode(enc)
            except UnicodeDecodeError:
                continue
        return b.decode("utf-8", errors="replace")
    text = _dec(out.stdout or b"") + "\n" + _dec(out.stderr or b"")
    return text.replace("\r", "").strip()


def login(username="admin", password="admin123"):
    """登录返回 JWT（登录接口无需验证码）"""
    import urllib.request
    req = urllib.request.Request(
        BASE + "/api/system/auth/login",
        data=json.dumps({"username": username, "password": password}).encode(),
        headers={"Content-Type": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=15) as resp:
        raw = resp.read()
    obj = msgpack.unpackb(raw, raw=False)
    data = obj.get("data") or {}
    token = data.get("accessToken") or data.get("token") or ""
    # 兜底：从原始字节里提 eyJ 开头且含两个点的最长串
    if not token:
        m = re.findall(rb"eyJ[A-Za-z0-9_\-\.]{20,}", raw)
        cands = [x for x in m if x.count(b".") == 2]
        if cands:
            token = max(cands, key=len).decode()
    return token


def api(method, path, token, payload=None):
    import urllib.request
    import urllib.error
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(BASE + path, data=data, method=method)
    req.add_header("Authorization", "Bearer " + token)
    if data:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            return resp.status, resp.read()
    except urllib.error.HTTPError as e:
        return e.code, e.read()


def mp_decode(raw):
    """msgpack 响应体解析（失败退回 JSON）"""
    try:
        return msgpack.unpackb(raw, raw=False)
    except Exception:
        try:
            return json.loads(raw.decode("utf-8", "ignore"))
        except Exception:
            return {"raw": raw[:200].decode("utf-8", "ignore")}


def main():
    # ---------- A1 微信回调 fail-closed [T1.1] ----------
    import urllib.request
    import urllib.error
    try:
        req = urllib.request.Request(
            BASE + "/api/finance/payment/wechat-notify",
            data=b'{"event_type":"TRANSACTION.SUCCESS","resource":{}}',
            method="POST",
        )
        req.add_header("Content-Type", "application/json")
        with urllib.request.urlopen(req, timeout=15) as resp:
            status, body = resp.status, resp.read()
    except urllib.error.HTTPError as e:
        status, body = e.code, e.read()
    ok = status in (401, 500)  # 无签名头 → 验签失败(401) 或 时间戳解析异常(500)，绝不 200 放行
    check("A1 微信回调 fail-closed（伪造回调被拒）", ok,
          "HTTP %s" % status)
    if status == 200:
        check("A1-b 回调响应不是 success 语义", b"SUCCESS" not in body[:100],
              body[:80].decode("utf-8", "ignore"))

    # ---------- A2 会员下单入口禁用 [T1.3 变体B] ----------
    token = login()
    check("A0 管理端登录", bool(token))
    if not token:
        sys.exit(1)
    status, raw = api("POST", "/api/user/payment/member-experience", token,
                      {"product_id": 1})
    obj = mp_decode(raw)
    body_text = json.dumps(obj, ensure_ascii=False, default=str)
    # admin 的管理端 JWT 不是 C 端用户凭据 → 应被 user_auth 拒绝；即便走到业务层也应 400 明确禁用
    ok = (status in (400, 401, 403)) or (str(obj.get("code")) not in ("200", "0", "None"))
    check("A2 会员下单入口已禁用（不再有可用下单路径）", ok,
          "HTTP %s code=%s" % (status, obj.get("code")))

    # ---------- A3 付款单号自动生成 [T1.9] ----------
    status, raw = api("POST", "/api/system/finance/payment/apply", token, {
        "purchase_order_no": "E2E-PO-STAGE1",
        "supplier_name": "E2E阶段一验收供应商",
        "payment_type": 1,
        "payment_amount": 123.45,
        "payment_method": 1,
        "remark": "e2e_stage1",
    })
    obj = mp_decode(raw)
    code = obj.get("code")
    payment_id = (obj.get("data") or {}).get("") if isinstance(obj.get("data"), dict) else None
    ok = str(code) == "200"
    check("A3-a 付款申请创建成功", ok, "HTTP %s code=%s msg=%s" % (status, code, obj.get("msg")))
    if ok:
        row = psql("SELECT id, payment_no FROM mxx_finance_payment "
                   "WHERE remark='e2e_stage1' ORDER BY id DESC LIMIT 1").split("|")
        pid, pno = (row[0], row[1]) if len(row) == 2 and row[0] else ("", "")
        import datetime
        expect_prefix = "PAY" + datetime.datetime.now().strftime("%Y%m%d")
        check("A3-b 付款单号已生成且格式正确", pno.startswith(expect_prefix) and len(pno) == len(expect_prefix) + 4,
              "payment_no=%s (id=%s)" % (pno, pid))

        # ---------- A4 非法金额拒绝 [T1.8] ----------
        status2, raw2 = api("POST", "/api/system/finance/payment/apply", token, {
            "purchase_order_no": "E2E-PO-STAGE1-BAD",
            "payment_type": 1,
            "payment_amount": 1e29,
            "payment_method": 1,
            "remark": "e2e_stage1_bad_amount",
        })
        obj2 = mp_decode(raw2)
        bad_ok = (str(obj2.get("code")) != "200") and ("非法" in json.dumps(obj2, ensure_ascii=False, default=str))
        check("A4 超范围金额(1e29)报错而非静默落0", bad_ok,
              "code=%s msg=%s" % (obj2.get("code"), obj2.get("msg")))
        # 清理坏数据不应存在
        cnt = psql("SELECT count(*) FROM mxx_finance_payment WHERE remark='e2e_stage1_bad_amount' AND payment_amount=0")
        check("A4-b 库中无 0 元脏付款单", cnt == "0", "count=%s" % cnt)

        # 清理测试付款单（仅删本脚本 E2E 前缀数据，符合 E2E 清场规范）
        psql("DELETE FROM mxx_finance_payment WHERE remark IN ('e2e_stage1') AND applicant_name IS NOT NULL "
             "AND purchase_order_no='E2E-PO-STAGE1'")

    # ---------- A5 工资条二次密码 argon2 [T1.4] ----------
    # 注：mxx_finance_payslip 无 deleted 软删列（任务书 P1-9 已记录），直接按 id 取最新
    slip = psql("SELECT id FROM mxx_finance_payslip ORDER BY id DESC LIMIT 1")
    if slip:
        sid = slip.split("\n")[0].strip()
        status, raw = api("POST", "/api/system/finance/payslip/set-password", token,
                          {"payslipId": int(sid), "password": "4321"})
        obj = mp_decode(raw)
        ok = str(obj.get("code")) == "200"
        check("A5-a 工资条设置二次密码", ok, "code=%s msg=%s" % (obj.get("code"), obj.get("msg")))
        if ok:
            h = psql("SELECT password_hash FROM mxx_finance_payslip WHERE id=%s" % sid)
            check("A5-b 哈希为 argon2id PHC 格式", h.startswith("$argon2id$"), h[:40])
            status, raw = api("POST", "/api/system/finance/payslip/verify-password", token,
                              {"payslipId": int(sid), "password": "4321"})
            obj = mp_decode(raw)
            data = obj.get("data")
            verified = data.get("verified") if isinstance(data, dict) else data
            ok_ok = str(obj.get("code")) == "200" and verified in (True, "true", 1)
            check("A5-c 正确密码校验通过", ok_ok, "data=%s" % data)
            status, raw = api("POST", "/api/system/finance/payslip/verify-password", token,
                              {"payslipId": int(sid), "password": "0000"})
            obj = mp_decode(raw)
            data = obj.get("data")
            verified = data.get("verified") if isinstance(data, dict) else data
            bad_ok = verified in (False, "false", 0)
            check("A5-d 错误密码校验拒绝", bad_ok, "data=%s" % data)
            # 还原：清除测试密码
            api("POST", "/api/system/finance/payslip/clear-password", token, {"id": int(sid)})
    else:
        print("[SKIP] A5 工资条密码——库中暂无工资条数据（生成工资条后可重跑本脚本覆盖）")

    # ---------- A6 数据库级兜底（d71/d72/d73）----------
    idx1 = psql("SELECT count(*) FROM pg_indexes WHERE indexname='uq_commission_result_trigger'")
    check("A6-a d71 提成幂等唯一索引存在", idx1 == "1")
    chk = psql("SELECT count(*) FROM pg_constraint WHERE conname='chk_pool_balance'")
    check("A6-b d72 资金池余额 CHECK 存在", chk == "1")
    idx2 = psql("SELECT count(*) FROM pg_indexes WHERE indexname='uq_finance_payment_no'")
    check("A6-c d73 付款单号唯一索引存在", idx2 == "1")
    # 行为验证：CHECK 约束真的拦截超扣
    pool_cnt = psql("SELECT count(*) FROM mxx_finance_commission_pool")
    if pool_cnt and pool_cnt != "0":
        r = psql("UPDATE mxx_finance_commission_pool SET used_amount = total_amount + 1 WHERE id = "
                 "(SELECT id FROM mxx_finance_commission_pool ORDER BY id LIMIT 1)")
        check("A6-d CHECK 约束实际拦截超扣", ("chk_pool_balance" in r) or ("错误" in r) or ("error" in r.lower()),
              r[:80])
    else:
        print("[SKIP] A6-d 资金池 CHECK 行为验证——库中暂无资金池数据")
    # 行为验证：幂等索引真的拦截重复插入（按真实列名整行复制最新一条，排除主键 id）
    has_row = psql("SELECT count(*) FROM mxx_finance_commission_result WHERE trigger_source_id IS NOT NULL")
    if has_row and has_row != "0":
        cols = [c for c in psql(
            "SELECT column_name FROM information_schema.columns "
            "WHERE table_name='mxx_finance_commission_result' ORDER BY ordinal_position").split("\n") if c and c != "id"]
        col_list = ", ".join(cols)
        ins = psql("INSERT INTO mxx_finance_commission_result (%s) "
                   "SELECT %s FROM mxx_finance_commission_result "
                   "WHERE trigger_source_id IS NOT NULL ORDER BY id DESC LIMIT 1" % (col_list, col_list))
        check("A6-e 幂等唯一索引实际拦截重复提成",
              ("uq_commission_result_trigger" in ins) or ("重复键" in ins) or ("duplicate key" in ins.lower()),
              ins.replace("\n", " ")[:80])
    else:
        print("[SKIP] A6-e 幂等索引行为验证——库中暂无带触发源的提成结果数据")

    # ---------- 汇总 ----------
    print("\n========== 阶段一 E2E 验收汇总 ==========")
    passed = sum(1 for _, ok, _ in results if ok)
    failed = [n for n, ok, _ in results if not ok]
    print("PASS %d / %d" % (passed, len(results)))
    if failed:
        print("FAILED:")
        for n in failed:
            print("  - " + n)
        sys.exit(2)
    print("全部通过")


if __name__ == "__main__":
    main()
