# -*- coding: utf-8 -*-
# E2E: finance_manager has full finance perms; base salary now calculated
import json, re, sys, io
import urllib.request
import msgpack

sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8")
BASE = "http://127.0.0.1:8088"

def call(method, path, token=None, body=None):
    req = urllib.request.Request(BASE + path, method=method)
    req.add_header("Content-Type", "application/json")
    if token:
        req.add_header("Authorization", "Bearer " + token)
    data = json.dumps(body).encode("utf-8") if body is not None else None
    with urllib.request.urlopen(req, data=data, timeout=60) as resp:
        return msgpack.unpackb(resp.read(), raw=False)

def login(username):
    r = call("POST", "/api/system/auth/login", body={"username": username, "password": "admin123"})
    s = json.dumps(r, default=str)
    toks = re.findall(r"eyJ[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+", s)
    assert toks, "login fail %s: %s" % (username, s[:200])
    return max(toks, key=len)

tok_fm = login("fin_manager")
print("1. fin_manager login ok")

# 2. 财务经理执行核算（finance:salary:manage）——8月重算
r = call("POST", "/api/system/finance/salary/calculate", tok_fm, {"year": 2026, "month": 8})
print("2. fin_manager calculate 2026-08:", r.get("code"), r.get("msg"), "count=", r.get("data"))

# 3. 核算后列表基本工资非零（占位/记录行均应有基本工资来自 salary_config）
r = call("GET", "/api/system/finance/salary/list?year=2026&month=8&page=1&pageSize=50", tok_fm)
data = r.get("data") or []
rows = data if isinstance(data, list) else data.get("items") or []
zero = [(row.get("employeeName"), row.get("baseSalary")) for row in rows
        if not row.get("baseSalary")]
print("3. August rows=%d, rows without base salary=%s" % (len(rows), zero if zero else "NONE"))
for row in sorted(rows, key=lambda x: -(x.get("baseSalary") or 0))[:5]:
    print("    %-8s base=%s total=%s" % (row.get("employeeName"), row.get("baseSalary"), row.get("totalSalary")))

# 4. 财务经理下发工资条（finance:payslip:manage）
r = call("POST", "/api/system/finance/payslip/generate", tok_fm, {"year": 2026, "month": 8})
print("4. fin_manager payslip generate:", r.get("code"), r.get("msg"))
print("DONE")
