# -*- coding: utf-8 -*-
"""用合法 PNG 替换 repro 脚本中的测试图，然后直接执行完整复现"""
import re
import struct
import subprocess
import zlib


def chunk(t, d):
    c = t + d
    return struct.pack(">I", len(d)) + c + struct.pack(">I", zlib.crc32(c) & 0xFFFFFFFF)


ihdr = chunk(b"IHDR", struct.pack(">IIBBBBB", 1, 1, 8, 2, 0, 0, 0))
idat = chunk(b"IDAT", zlib.compress(b"\x00\xff\x00\x00"))
png = b"\x89PNG\r\n\x1a\n" + ihdr + idat + chunk(b"IEND", b"")

p = "scripts/repro_banner_upload.py"
s = open(p, encoding="utf-8").read()
s = re.sub(r"png = bytes\.fromhex\([^)]+\)", lambda m: "png = " + repr(png), s, flags=re.S)
open(p, "w", encoding="utf-8", newline="\n").write(s)
print("png bytes:", len(png))

r = subprocess.run(["python", p], capture_output=True)
for enc in ("utf-8", "gbk"):
    try:
        print((r.stdout or b"").decode(enc).replace("\r", ""))
        break
    except UnicodeDecodeError:
        continue
print((r.stderr or b"").decode("utf-8", "ignore")[:300])
