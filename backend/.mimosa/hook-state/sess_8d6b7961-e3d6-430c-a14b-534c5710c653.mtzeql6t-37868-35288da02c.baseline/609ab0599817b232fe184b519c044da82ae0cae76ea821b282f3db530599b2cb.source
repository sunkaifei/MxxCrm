use actix_web::{post, web, HttpResponse, HttpRequest};
use sea_orm::DbConn;
use crate::core::errors::error::{Error, Result};
use crate::core::kit::global::AppState;
use crate::modules::finance::service::payment_record_service;
use crate::modules::finance::service::{refund_record_service, wechat_pay_service};
use crate::modules::finance::model::payment_record::{PaymentRecordDTO, PaymentRecordSaveRequest};
use crate::modules::finance::model::refund_record::RefundRecordSaveRequest;
use crate::modules::finance::model::wechat_pay::{
    WechatNotifyResponse, WechatV3Notify, WechatV3Resource, WechatV3PaymentResult,
    EVENT_TRANSACTION_SUCCESS, EVENT_TRANSACTION_REFUND, EVENT_TRANSACTION_CLOSED,
    TRADE_STATE_SUCCESS, TRADE_STATE_CLOSED, TRADE_STATE_PAYERROR,
    success_response, fail_response
};
use crate::modules::finance::model::member_product::MemberProductModel;
use crate::modules::website::model::website_order::WebsiteOrderModel;
use crate::modules::website::service::website_order_service;
use base64::{Engine as _, engine::general_purpose::STANDARD as BASE64};
use rust_decimal::prelude::ToPrimitive;

fn aes_256_gcm_decrypt(
    ciphertext: &str,
    key: &[u8],
    nonce: &[u8],
    associated_data: &str,
) -> Result<String> {
    use aes_gcm::{Aes256Gcm, KeyInit, Nonce};
    use aes_gcm::aead::Aead;

    let cipher = Aes256Gcm::new(key.into());
    let nonce = Nonce::from_slice(nonce);

    let plaintext = cipher.decrypt(
        nonce,
        aes_gcm::aead::Payload {
            msg: &BASE64.decode(ciphertext).map_err(|e| Error::from(format!("Base64解码失败: {}", e)))?,
            aad: associated_data.as_bytes(),
        },
    ).map_err(|e| Error::from(format!("AES解密失败: {}", e)))?;

    String::from_utf8(plaintext).map_err(|e| Error::from(format!("UTF-8转换失败: {}", e)))
}

#[post("/payment/wechat-notify")]
pub async fn wechat_notify(req: HttpRequest, state: web::Data<AppState>, body: web::Bytes) -> Result<HttpResponse> {
    let db = &state.db;
    log::info!("[微信支付V3回调] 收到支付回调请求");

    let body_str = String::from_utf8_lossy(&body);
    log::info!("[微信支付V3回调] 原始内容: {}", body_str);

    let timestamp = req.headers().get("Wechatpay-Timestamp")
        .and_then(|h| h.to_str().ok())
        .unwrap_or("");
    let nonce = req.headers().get("Wechatpay-Nonce")
        .and_then(|h| h.to_str().ok())
        .unwrap_or("");
    let signature = req.headers().get("Wechatpay-Signature")
        .and_then(|h| h.to_str().ok())
        .unwrap_or("");
    let serial = req.headers().get("Wechatpay-Serial")
        .and_then(|h| h.to_str().ok())
        .unwrap_or("");

    log::info!("[微信支付V3回调] 回调头 - timestamp={}, nonce={}, serial={}", timestamp, nonce, serial);

    let verify_result = wechat_pay_service::verify_wechat_v3_notify(
        db, timestamp, nonce, &body_str, signature, serial
    ).await;

    // T1.1 fail-closed：验签失败/异常一律拒绝，绝不允许"测试模式"跳过（伪造回调可直接标记订单已支付）
    match verify_result {
        Ok(true) => {
            log::info!("[微信支付V3回调] 签名验证通过");
        }
        Ok(false) => {
            log::warn!("[微信支付V3回调] 签名验证失败，拒绝处理");
            return Ok(HttpResponse::Unauthorized().json(fail_response("签名验证失败")));
        }
        Err(e) => {
            log::error!("[微信支付V3回调] 签名验证出错: {}", e);
            return Ok(HttpResponse::InternalServerError().json(fail_response("签名验证异常")));
        }
    }

    let notify: WechatV3Notify = match serde_json::from_str(&body_str) {
        Ok(n) => n,
        Err(e) => {
            log::error!("[微信支付V3回调] JSON解析失败: {}", e);
            return Ok(HttpResponse::Ok().json(fail_response("JSON解析失败")));
        }
    };

    log::info!("[微信支付V3回调] 事件类型: {}", notify.event_type);

    let api_v3_key = crate::config::section::<String>("wechat", "api_v3_key", "".to_string());
    let key_bytes = api_v3_key.as_bytes();
    if key_bytes.len() != 32 {
        return Err(Error::from(format!("APIv3密钥必须是32个字符，当前长度: {}", key_bytes.len())));
    }

    let decrypted = match aes_256_gcm_decrypt(
        &notify.resource.ciphertext,
        &key_bytes,
        notify.resource.nonce.as_bytes(),
        &notify.resource.associated_data,
    ) {
        Ok(d) => d,
        Err(e) => {
            log::error!("[微信支付V3回调] 解密失败: {}", e);
            return Ok(HttpResponse::Ok().json(fail_response("解密失败")));
        }
    };

    log::info!("[微信支付V3回调] 解密内容: {}", decrypted);

    match notify.event_type.as_str() {
        EVENT_TRANSACTION_SUCCESS => {
            let result: WechatV3PaymentResult = match serde_json::from_str(&decrypted) {
                Ok(r) => r,
                Err(e) => {
                    log::error!("[微信支付V3回调] 支付结果解析失败: {}", e);
                    return Ok(HttpResponse::Ok().json(fail_response("支付结果解析失败")));
                }
            };

            log::info!("[微信支付V3回调] 支付结果 - transaction_id={}, out_trade_no={}, trade_state={}",
                result.transaction_id, result.out_trade_no, result.trade_state);

            let out_trade_no = result.out_trade_no;
            let transaction_id = result.transaction_id;

            let record_opt = payment_record_service::get_by_order_id(db, &out_trade_no).await.ok().flatten();

            if let Some(record) = &record_opt {
                if record.status == Some(1) {
                    log::warn!("[微信支付V3回调] 订单已处理过，跳过重复通知: {}", out_trade_no);
                    // 流水已支付但订单可能尚未标记（历史中断残留），补一次幂等标记
                    if record.payment_type == Some(2) && record.member_product_id.is_none() {
                        let _ = website_order_service::mark_order_paid(db, &out_trade_no, 1, transaction_id.clone()).await;
                    }
                    return Ok(HttpResponse::Ok().json(success_response()));
                }
            }

            // 网站商品订单判定：流水 payment_type=2 且非会员商品；或无流水但网站订单表存在该单号（异常时序回调）
            let is_website_order = match &record_opt {
                Some(record) => record.payment_type == Some(2) && record.member_product_id.is_none(),
                None => WebsiteOrderModel::find_by_order_no(db, &out_trade_no)
                    .await
                    .map(|o| o.is_some())
                    .unwrap_or(false),
            };

            match result.trade_state.as_str() {
                TRADE_STATE_SUCCESS => {
                    if is_website_order {
                        let paid_result = handle_website_order_paid(db, &out_trade_no, &transaction_id, record_opt).await;
                        return Ok(match paid_result {
                            Ok(_) => {
                                log::info!("[微信支付V3回调] 网站商品订单支付成功: {}", out_trade_no);
                                HttpResponse::Ok().json(success_response())
                            }
                            Err(e) => {
                                log::error!("[微信支付V3回调] 网站商品订单支付处理失败: {}, error: {}", out_trade_no, e);
                                HttpResponse::Ok().json(fail_response("订单更新失败"))
                            }
                        });
                    }

                    let update_result = payment_record_service::update_paid(db, &out_trade_no, &transaction_id).await;
                    match update_result {
                        Ok(_) => {
                            log::info!("[微信支付V3回调] 订单支付成功: {}", out_trade_no);
                            
                            log::info!("[微信支付V3回调] 准备查询支付记录，order_id: {}", out_trade_no);
                            if let Ok(Some(record)) = payment_record_service::get_by_order_id(db, &out_trade_no).await {
                                log::info!("[微信支付V3回调] 查询到支付记录，user_id: {}, member_product_id: {:?}", 
                                        record.user_id, record.member_product_id);
                                
                                if let Some(member_product_id) = record.member_product_id {
                                    log::info!("[微信支付V3回调] 准备查询会员商品，product_id: {}", member_product_id);
                                    
                                    match MemberProductModel::find_by_id(db, member_product_id).await { Ok(Some(product)) => {
                                        log::info!("[微信支付V3回调] 查询到会员商品，product_name: {}", product.product_name);
                                    } _ => {
                                        log::error!("[微信支付V3回调] 查询会员商品失败，商品ID: {}", member_product_id);
                                    }}
                                } else {
                                    log::warn!("[微信支付V3回调] 支付记录中没有会员商品ID，跳过权益创建");
                                }
                            } else {
                                log::error!("[微信支付V3回调] 未查询到支付记录，order_id: {}", out_trade_no);
                            }
                            
                            Ok(HttpResponse::Ok().json(success_response()))
                        }
                        Err(e) => {
                            log::error!("[微信支付V3回调] 订单状态更新失败: {}", e);
                            Ok(HttpResponse::Ok().json(fail_response("订单更新失败")))
                        }
                    }
                }
                TRADE_STATE_CLOSED | TRADE_STATE_PAYERROR => {
                    let remark = format!("支付失败: {}", result.trade_state_desc);
                    if is_website_order {
                        // 网站商品订单：流水标失败即可，订单保持待付款，用户可重新发起支付
                        if record_opt.is_some() {
                            let _ = payment_record_service::update_failed(db, &out_trade_no, &remark).await;
                        }
                        log::info!("[微信支付V3回调] 网站商品订单支付关闭/失败: {}", out_trade_no);
                        return Ok(HttpResponse::Ok().json(success_response()));
                    }
                    let update_result = payment_record_service::update_failed(db, &out_trade_no, &remark).await;
                    match update_result {
                        Ok(_) => {
                            log::info!("[微信支付V3回调] 订单支付失败: {}", out_trade_no);
                            Ok(HttpResponse::Ok().json(success_response()))
                        }
                        Err(e) => {
                            log::error!("[微信支付V3回调] 订单状态更新失败: {}", e);
                            Ok(HttpResponse::Ok().json(fail_response("订单更新失败")))
                        }
                    }
                }
                _ => {
                    log::warn!("[微信支付V3回调] 未知交易状态: {}", result.trade_state);
                    Ok(HttpResponse::Ok().json(success_response()))
                }
            }
        }
        EVENT_TRANSACTION_REFUND => {
            // T1.2 退款回调闭环：解析退款结果 → 回写支付流水状态 → 登记退款记录
            log::info!("[微信支付V3回调] 收到退款通知");
            let refund: serde_json::Value = match serde_json::from_str(&decrypted) {
                Ok(v) => v,
                Err(e) => {
                    log::error!("[微信支付V3回调] 退款结果解析失败: {}", e);
                    return Ok(HttpResponse::Ok().json(fail_response("退款结果解析失败")));
                }
            };
            let out_trade_no = refund["out_trade_no"].as_str().unwrap_or("").to_string();
            let refund_status = refund["refund_status"].as_str().unwrap_or("").to_string();
            let refund_fee = refund["refund_fee"].as_i64().unwrap_or(0);
            let out_refund_no = refund["out_refund_no"].as_str().unwrap_or("").to_string();
            log::info!("[微信支付V3回调] 退款结果 - out_trade_no={}, refund_status={}, refund_fee={}分",
                out_trade_no, refund_status, refund_fee);

            if out_trade_no.is_empty() {
                log::error!("[微信支付V3回调] 退款通知缺少 out_trade_no，请人工核查");
                return Ok(HttpResponse::Ok().json(success_response()));
            }
            if refund_status != "SUCCESS" {
                log::warn!("[微信支付V3回调] 退款未成功(refund_status={})，仅记录不回写", refund_status);
                return Ok(HttpResponse::Ok().json(success_response()));
            }

            match payment_record_service::get_by_order_id(db, &out_trade_no).await {
                Ok(Some(record)) => {
                    if record.status == Some(3) {
                        log::info!("[微信支付V3回调] 流水已是已退款状态，跳过重复退款通知: {}", out_trade_no);
                        return Ok(HttpResponse::Ok().json(success_response()));
                    }
                    payment_record_service::update_refunded(db, &out_trade_no, "微信退款回调")
                        .await
                        .map_err(|e| {
                            log::error!("[微信支付V3回调] 退款状态回写失败: {}, error: {}", out_trade_no, e);
                            Error::from(format!("退款状态回写失败: {}", e))
                        })?;
                    let save = RefundRecordSaveRequest {
                        user_id: record.user_id,
                        payment_record_id: record.id,
                        amount: refund_fee as f64 / 100.0,
                        status: Some(2), // 2=退款成功（与统计口径一致）
                        transaction_id: Some(out_refund_no.clone()),
                        refund_time: Some(chrono::Local::now().format("%Y-%m-%d %H:%M:%S").to_string()),
                        reason: Some("微信退款回调".to_string()),
                        remark: Some(format!("微信退款回调自动登记，退款单号: {}", out_refund_no)),
                    };
                    if let Err(e) = refund_record_service::insert(db, save).await {
                        log::error!("[微信支付V3回调] 退款记录登记失败: {}, error: {}", out_trade_no, e);
                        return Ok(HttpResponse::Ok().json(fail_response("退款记录登记失败")));
                    }
                    log::info!("[微信支付V3回调] 退款处理完成: {}", out_trade_no);
                    Ok(HttpResponse::Ok().json(success_response()))
                }
                Ok(None) => {
                    log::error!("[微信支付V3回调] 退款通知未找到对应支付流水: {}（请人工核查）", out_trade_no);
                    Ok(HttpResponse::Ok().json(success_response()))
                }
                Err(e) => {
                    log::error!("[微信支付V3回调] 查询支付流水失败: {}, error: {}", out_trade_no, e);
                    Ok(HttpResponse::Ok().json(fail_response("查询支付流水失败")))
                }
            }
        }
        EVENT_TRANSACTION_CLOSED => {
            log::info!("[微信支付V3回调] 订单关闭通知");
            Ok(HttpResponse::Ok().json(success_response()))
        }
        _ => {
            log::warn!("[微信支付V3回调] 未知事件类型，跳过: {}", notify.event_type);
            Ok(HttpResponse::Ok().json(success_response()))
        }
    }
}

/// 网站商品订单支付成功处理：更新/补录支付流水 + 标记订单已支付
///
/// mark_order_paid 内部按 pay_status=未支付 过滤更新，重复回调天然幂等
async fn handle_website_order_paid(
    db: &DbConn,
    out_trade_no: &str,
    transaction_id: &str,
    record: Option<PaymentRecordDTO>,
) -> std::result::Result<(), String> {
    match record {
        Some(_) => {
            payment_record_service::update_paid(db, out_trade_no, transaction_id).await?;
        }
        None => {
            // 回调先于支付流水落库（异常时序）：按订单信息补录一条已支付流水
            match WebsiteOrderModel::find_by_order_no(db, out_trade_no).await {
                Ok(Some(order)) => {
                    // T1.8: 金额走 Decimal→f64 显式转换，非法金额直接拒绝，不允许静默落 0
                    let amount = order.pay_amount.to_f64().ok_or_else(|| {
                        format!("订单金额格式非法: {} (pay_amount={})", out_trade_no, order.pay_amount)
                    })?;
                    let save = PaymentRecordSaveRequest {
                        user_id: order.user_id,
                        member_product_id: None,
                        order_id: Some(out_trade_no.to_string()),
                        payment_type: Some(2),
                        amount,
                        pay_method: Some(1),
                        status: Some(1),
                        transaction_id: Some(transaction_id.to_string()),
                        pay_time: Some(chrono::Local::now().format("%Y-%m-%d %H:%M:%S").to_string()),
                        remark: Some("支付回调补录".to_string()),
                    };
                    payment_record_service::insert(db, save).await?;
                }
                Ok(None) => {
                    return Err(format!("网站订单不存在: {}", out_trade_no));
                }
                Err(e) => return Err(e.to_string()),
            }
        }
    }
    website_order_service::mark_order_paid(db, out_trade_no, 1, transaction_id.to_string())
        .await
        .map_err(|e| e.to_string())?;
    Ok(())
}
