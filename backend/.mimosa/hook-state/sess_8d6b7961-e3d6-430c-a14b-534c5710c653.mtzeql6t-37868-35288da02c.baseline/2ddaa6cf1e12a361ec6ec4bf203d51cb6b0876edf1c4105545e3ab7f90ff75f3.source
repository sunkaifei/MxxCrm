def body_product_list():
    return """
<div class="container py-4">
  <div class="row g-4">
    <div class="col-lg-3">
      <div class="p-3 rounded-3" style="background:var(--ent-soft);">
        <h6 class="fw-bold mb-2">产品分类</h6>
        <a class="d-block py-1 fw-bold" href="/product">全部产品</a>
        {% for c in get_product_categories(0) %}
        <a class="d-block py-1" href="{{ category_url(c.id) }}">{{ c.name }}</a>
        {% endfor %}
      </div>
    </div>
    <div class="col-lg-9">
      <div class="row g-4">
        {% for p in products %}
        <div class="col-md-4">
          <div class="ent-card overflow-hidden">
            <a href="{{ product_url(p.id) }}"><img src="{{ p.imageUrl | default('/static/default/images/placeholder.png') }}" class="w-100" style="height:180px;object-fit:cover;" alt="{{ p.name }}" loading="lazy"></a>
            <div class="p-3">
              <h6><a href="{{ product_url(p.id) }}">{{ p.name }}</a></h6>
              <div class="d-flex justify-content-between align-items-center mt-2">
                <span style="color:var(--ent-accent);font-weight:700;">{{ product_price(p.salePrice) }}</span>
                {{ cart_button(p.id, site_mode, p.salePrice, p.name) | safe }}
              </div>
            </div>
          </div>
        </div>
        {% else %}
        <p class="text-muted">暂无符合条件的产品</p>
        {% endfor %}
      </div>
      {{ get_pagination_html(current_page, total, page_size, '/product') | safe }}
    </div>
  </div>
</div>
"""


def body_product_detail():
    return """
<div class="container py-4">
  <div class="row g-4">
    <div class="col-lg-6">
      <img src="{{ product.imageUrl | default('/static/default/images/placeholder.png') }}" class="w-100 rounded-3 border" style="height:400px;object-fit:cover;" alt="{{ product.name }}">
      {% if product.carouselImages %}
      <div class="d-flex gap-2 mt-2 flex-wrap">
        {% for img in product.carouselImages %}
        <img src="{{ img }}" class="rounded border" style="width:64px;height:64px;object-fit:cover;cursor:pointer;" onmouseover="document.getElementById('entMainImg').src=this.src">
        {% endfor %}
      </div>
      {% endif %}
    </div>
    <div class="col-lg-6">
      <h2 style="font-weight:800;">{{ product.name }}</h2>
      <p class="my-3"><span style="font-size:1.8rem;font-weight:800;">{{ product_price(product.salePrice) }}</span>
        {% if product.marketPrice %}<del class="text-muted ms-2">{{ product_price(product.marketPrice) }}</del>{% endif %}</p>
      <p style="color:var(--ent-muted);">{{ product.description | default('') }}</p>
      <p class="{% if product.stock and product.stock > 0 %}text-success{% else %}text-danger{% endif %}">
        {% if product.stock and product.stock > 0 %}库存 {{ product.stock }} 件{% else %}暂时缺货{% endif %}</p>
      {{ cart_button(product.id, site_mode, product.salePrice, product.name) | safe }}
      <hr>
      <table class="table table-sm small">
        <tr><th style="width:100px;">编号</th><td>{{ product.productNo | default('-') }}</td></tr>
        <tr><th>SKU</th><td>{{ product.sku | default('-') }}</td></tr>
        <tr><th>条形码</th><td>{{ product.barcode | default('-') }}</td></tr>
        <tr><th>单位</th><td>{{ product.unit | default('-') }}</td></tr>
      </table>
    </div>
  </div>
  {% if spec_groups and spec_groups.specs and spec_groups.specs | length > 0 %}
  <div class="mt-4">
    <h5 class="fw-bold">规格参数</h5>
    {% for sp in spec_groups.specs %}
    <div class="border rounded p-3 mb-2"><strong>{{ sp.name }}</strong>
      <span class="ms-2 text-muted small">{% for v in sp.values %}{{ v.value }}{% if not loop.last %} / {% endif %}{% endfor %}</span>
    </div>
    {% endfor %}
    {% if spec_groups.skus and spec_groups.skus | length > 0 %}
    <table class="table table-sm table-bordered small mt-2">
      <thead><tr><th>SKU</th><th>规格</th><th>价格</th><th>库存</th></tr></thead>
      <tbody>
      {% for s in spec_groups.skus %}
      <tr><td>{{ s.skuCode | default('-') }}</td><td>{{ s.specText | default('-') }}</td>
        <td>{{ product_price(s.price) }}</td><td>{{ s.stock | default(0) }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    {% endif %}
  </div>
  {% endif %}
  <div class="mt-4"><h5 class="fw-bold">产品详情</h5><div style="line-height:1.9;">{{ product.detail | safe }}</div></div>
  {% if related_products and related_products | length > 0 %}
  <div class="mt-4">
    <h5 class="fw-bold">相关推荐</h5>
    <div class="row g-3">
      {% for r in related_products %}
      <div class="col-md-3">
        <div class="ent-card overflow-hidden">
          <a href="{{ product_url(r.id) }}"><img src="{{ r.imageUrl | default('/static/default/images/placeholder.png') }}" class="w-100" style="height:140px;object-fit:cover;" loading="lazy"></a>
          <div class="p-2"><a style="color:var(--ent-ink);font-size:.9rem;" href="{{ product_url(r.id) }}">{{ r.name }}</a>
            <div class="small" style="color:var(--ent-accent);">{{ product_price(r.salePrice) }}</div></div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}
</div>
<script type="application/ld+json">{{ jsonld | safe }}</script>
"""


def dq(text):
    """SQL dollar-quote with unique tag"""
    return "$cms$" + text + "$cms$"


def main():
    parts = [
        "-- =====================================================================",
        "-- v64: CMS 页面模板完整 HTML 化（企业展示模板手册 T-P0.1 落地 + 单站CMS R-1.1 部分）",
        "-- 方案 1/2/3 的 7/8/9/12 页重写为完整 HTML 文档；方案 2/3 全套 11 槽补齐；",
        "-- 页头(14)/页脚(15) 拆分为纯导航条/页脚（配合 page_head/page_foot 子渲染标签）。",
        "-- 幂等：事务内按 (template_id,type_id) REPLACE（DELETE+INSERT）。",
        "-- 执行：PGPASSWORD=123456 psql -U postgres -h 127.0.0.1 -d mxxcrm_data \\",
        "--        -v ON_ERROR_STOP=1 -f sql/v64_cms_full_docs.sql",
        "-- =====================================================================",
        "BEGIN;",
        "",
    ]

    def upsert(tid, type_id, name, text):
        body = dq(text)
        parts.append(
            f"DELETE FROM mxx_template_user_data WHERE template_id = {tid} AND type_id = {type_id};\n"
            f"INSERT INTO mxx_template_user_data (template_id, website_id, type_id, name, temptext, status, deleted, create_time)\n"
            f"VALUES ({tid}, 1, {type_id}, '{name}', {body}, 1, 0, now());\n"
        )

    # ---------- 方案 1/2/3：7 产品列表 / 8 产品详情 / 9 登录 / 12 购物车 ----------
    for tid, p in PALETTES.items():
        parts.append("-- ---------- 方案 %d：%s ----------" % (tid, p["name"]))
        css = ('<link rel="stylesheet" href="/static/default/css/bootstrap.min.css">\n'
               '  <link rel="stylesheet" href="/static/default/css/cms.css">\n'
               '  <style>:root{--ent-primary:%s;--ent-accent:%s;--ent-soft:%s;--ent-line:%s;}</style>'
               % (p["primary"], p["accent"], p["soft"], p["line"]))

        list7 = shell(tid, p, "产品中心 - {{ site.siteName | default('MxxCRM') }}",
                      "企业级产品与服务列表", body_product_list())
        # 注入 bootstrap/head 到 body 顶部由 page_head 承担；此处 shell 已含 head
        upsert(tid, 7, "产品列表页", list7)

        detail8 = shell(tid, p,
                        "{{ product.name | default('产品详情') }} - {{ site.siteName | default('MxxCRM') }}",
                        "{{ product.description | default('') }}",
                        body_product_detail(), extra_head="", jsonld=True)
        upsert(tid, 8, "产品详情页", detail8)

        login9 = shell(tid, p, "会员登录 - {{ site.siteName | default('MxxCRM') }}", "", """<div class="container py-5">
  <div class="row justify-content-center"><div class="col-md-5"><div class="ent-card p-4">
    <h4 class="mb-3 text-center">会员登录</h4>
    <p id="cms-login-tip" class="text-danger small" style="display:none"></p>
    <form onsubmit="return cmsLogin(event)">
      <div class="mb-3"><label class="form-label">用户名 / 手机号 / 邮箱</label>
        <input class="form-control" type="text" name="account" required placeholder="请输入账号"></div>
      <div class="mb-3"><label class="form-label">密码</label>
        <input class="form-control" type="password" name="password" required placeholder="请输入密码"></div>
      <button class="ent-btn ent-btn-primary w-100" type="submit">登录</button>
    </form>
    <p class="text-muted small mt-3 mb-0">还没有账号？请联系客服开通。</p>
  </div></div></div>
</div>""")
        upsert(tid, 9, "前台登录页", login9)

        cart12 = shell(tid, p, "我的购物车 - {{ site.siteName | default('MxxCRM') }}", "", """<div class="container py-4">
  <h4 class="mb-3">我的购物车</h4>
  <div id="cms-cart-box" class="text-muted">加载中…</div>
</div>
<script>
(function () {
  var token = null;
  try { token = localStorage.getItem('cmsUserToken'); } catch (e) {}
  if (!token) { window.location.href = '/user/login?redirect=%2Fcart'; return; }
  fetch('/api/user/cart/list', { headers: { 'Authorization': 'Bearer ' + token } })
    .then(function (r) { return r.json(); })
    .then(function (res) {
      var box = document.getElementById('cms-cart-box');
      var list = (res && res.data && (res.data.items || res.data)) || [];
      if (!Array.isArray(list) || list.length === 0) {
        box.innerHTML = '<div class="text-center py-5">购物车是空的，<a href="/product">去逛逛</a></div>';
        return;
      }
      var rows = list.map(function (it) {
        return '<tr><td>' + (it.product_name || '-') + '</td><td>¥' + Number(it.price || 0).toFixed(2) +
          '</td><td>' + (it.quantity || 0) + '</td><td>¥' + (Number(it.price || 0) * Number(it.quantity || 0)).toFixed(2) + '</td></tr>';
      }).join('');
      box.innerHTML = '<table class="table align-middle"><thead><tr><th>产品</th><th>单价</th><th>数量</th><th>小计</th></tr></thead><tbody>' +
        rows + '</tbody></table><p class="text-end">登录态正常，可联系客服完成下单支付。</p>';
    })
    .catch(function () { document.getElementById('cms-cart-box').textContent = '加载失败，请刷新重试'; });
})();
</script>""")
        upsert(tid, 12, "购物车页", cart12)

    # ---------- 方案 2/3：首页(1)/栏目列表(2)/内容页(3)/报价(5)/封面(6) 完整文档化 ----------
    for tid in (2, 3):
        p = PALETTES[tid]
        # 首页
        home = shell(tid, p, "{{ site.siteName | default('MxxCRM') }}",
                     "{{ site.description | default('') }}", """
<div id="entHero" class="carousel slide" data-bs-ride="carousel" style="background:@@GRAD@@;color:#fff;">
  <div class="carousel-inner">
  {% set banners = get_banners("home_top") %}
  {% for b in banners %}
    <div class="carousel-item {{ 'active' if loop.first }}">
      <div class="container py-5"><span style="background:rgba(255,255,255,.16);padding:.25rem .9rem;border-radius:999px;font-size:.8rem;">%s</span>
        <h1 class="mt-3" style="font-weight:800;">{{ b.title | default(site.siteName) }}</h1>
        <p style="opacity:.9;">{{ b.altText | default('') }}</p>
        <a class="ent-btn ent-btn-accent" href="{{ b.linkUrl | default('/product') }}">浏览产品</a></div>
    </div>
  {% else %}
    <div class="carousel-item active"><div class="container py-5">
      <h1 style="font-weight:800;">{{ site.siteName | default('MxxCRM') }}</h1>
      <p style="opacity:.9;">{{ site.description | default('') }}</p></div></div>
  {% endfor %}
  </div>
</div>
<section class="ent-section"><div class="container">
  <h2 class="ent-title text-center">产品与服务</h2><p class="ent-sub text-center">为企业提供全链路数字化解决方案</p>
  <div class="row g-4">
  {% for p in get_products(0, 6) %}
    <div class="col-md-4"><div class="ent-card overflow-hidden">
      <a href="{{ product_url(p.id) }}"><img src="{{ p.imageUrl | default('/static/default/images/placeholder.png') }}" class="w-100" style="height:190px;object-fit:cover;" loading="lazy"></a>
      <div class="p-3"><h6><a href="{{ product_url(p.id) }}">{{ p.name }}</a></h6>
        <div class="d-flex justify-content-between align-items-center mt-2">
          <span style="color:var(--ent-accent);font-weight:700;">{{ product_price(p.salePrice) }}</span>
          {{ cart_button(p.id, site_mode, p.salePrice, p.name) | safe }}</div></div></div></div>
  {% endfor %}
  </div><div class="text-center mt-4"><a class="ent-btn ent-btn-primary" href="/product">查看全部产品</a></div>
</div></section>
<section class="ent-section" style="background:var(--ent-soft);"><div class="container">
  <h2 class="ent-title text-center">新闻动态</h2><p class="ent-sub text-center">了解我们的最新进展</p>
  <div class="row g-4">
  {% for a in get_articles(0, 4) %}
    <div class="col-md-6"><div class="ent-card p-3">
      <h6 class="mb-1"><a href="/article/{{ a.short_url }}">{{ a.title }}</a></h6>
      <small style="color:var(--ent-muted);">{{ a.create_time }}</small></div></div>
  {% endfor %}
  </div><div class="text-center mt-3"><a class="ent-btn ent-btn-primary" href="/search">更多内容</a></div>
</div></section>
<section class="ent-section"><div class="container">
  <h2 class="ent-title text-center">合作伙伴</h2>
  <div class="row g-3">{% for l in get_links(0) %}
    <div class="col-6 col-md-3"><div class="ent-card p-3 text-center"><a href="{{ l.linkUrl | default('#') }}" target="_blank">{{ l.linkName }}</a></div></div>
  {% endfor %}</div>
</div></section>""" .replace("@@GRAD@@", p["grad"]).replace("@@BADGE@@", p["badge"]))
        upsert(tid, 1, "首页", home)

    parts.append("COMMIT;")
    parts.append("-- 验收：每页均应以 <!DOCTYPE html> 开头")
    parts.append("SELECT template_id, type_id, name, left(coalesce(temptext,''),15) AS head, length(coalesce(temptext,'')) AS len FROM mxx_template_user_data WHERE template_id IN (1,2,3) AND type_id IN (1,7,8,9,12) AND deleted=0 ORDER BY template_id, type_id;")
    io.open(OUT, "w", encoding="utf-8", newline="\n").write("\n".join(parts) + "\n")
    print("written", OUT)


if __name__ == "__main__":
    main()
