# -*- coding: utf-8 -*-
"""
gen_v64_cms_full_docs.py
生成 sql/v64_cms_full_docs.sql：
将方案 1/2/3 的产品列表(7)/产品详情(8)/登录(9)/购物车(12) 页面重写为完整 HTML 文档
（含 doctype/head/title/meta/bootstrap），并同步方案 2/3 的首页/栏目/内容/报价/封面页。
配套：page_head()/page_foot() 标签返回子渲染后的导航条/页脚（template.rs）。
幂等：按 (template_id, type_id) DELETE+INSERT，事务内执行。
"""
import os

import io
import os

OUT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "sql", "v64_cms_full_docs.sql")

PALETTES = {
    1: {"name": "默认官网", "primary": "#2563eb", "primary2": "#1d4ed8", "accent": "#7c3aed",
        "ink": "#0f172a", "muted": "#64748b", "soft": "#f8fafc", "line": "#e2e8f0",
        "grad": "linear-gradient(135deg,#2563eb,#7c3aed)", "cta": "获取专属方案", "badge": "企业级服务"},
    2: {"name": "企业展示型", "primary": "#0f2b46", "primary2": "#1d4ed8", "accent": "#d97706",
        "ink": "#0f172a", "muted": "#64748b", "soft": "#f6f8fb", "line": "#e2e8f0",
        "grad": "linear-gradient(120deg,#0f2b46 0%,#1d4ed8 70%,#3b82f6 100%)", "cta": "获取专属方案", "badge": "企业级服务"},
    3: {"name": "综合营销型", "primary": "#7f1d1d", "primary2": "#dc2626", "accent": "#f59e0b",
        "ink": "#1c1917", "muted": "#78716c", "soft": "#faf7f2", "line": "#e7e5e4",
        "grad": "linear-gradient(120deg,#7f1d1d 0%,#dc2626 65%,#f59e0b 120%)", "cta": "立即咨询享优惠", "badge": "限时特惠"},
}


def shell(tid, p, title_expr, desc_expr, body, extra_head="", jsonld=False):
    ld = ('<script type="application/ld+json">{{ jsonld | safe }}</script>\n' if jsonld else "")
    return f"""<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title_expr}</title>
  <meta name="keywords" content="{{{{ keywords | default(site.keywords | default('')) }}}}">
  <meta name="description" content="{desc_expr}">
  <link rel="stylesheet" href="/static/default/css/bootstrap.min.css">
  <link rel="stylesheet" href="/static/default/css/cms.css">
  <link rel="canonical" href="{{{{ canonical_url | default('') }}}}"/>
{extra_head}</head>
<body>
{{{{ page_head() | safe }}}}
{body}
{{{{ page_foot() | safe }}}}
<script src="/static/default/js/cms.js"></script>
</body>
</html>"""


def nav_bar():
    return """<header class="ent-navbar">
  <div class="container d-flex align-items-center justify-content-between flex-wrap gap-2">
    <a class="brand text-decoration-none" href="/">{{ site.siteName | default('MxxCRM') }}</a>
    <nav class="d-flex gap-3 flex-wrap align-items-center">
      {% for n in get_navigations("header") %}
      <a class="nav-link" href="{{ n.linkUrl | default('#') }}" {% if n.target %}target="{{ n.target }}"{% endif %}>{{ n.name }}</a>
      {% endfor %}
      <a class="nav-link" href="/product">产品中心</a>
      <form class="d-flex" method="get" action="/search" style="max-width:200px;">
        <input class="form-control form-control-sm" type="text" name="keyword" placeholder="全站搜索">
        <button class="btn btn-sm btn-outline-secondary ms-1" type="submit">搜索</button>
      </form>
    </nav>
    <div class="d-flex gap-3 align-items-center">
      {% if get_site_mode() == 2 or get_site_mode() == 3 %}
      <a class="cms-cart-entry text-decoration-none text-secondary" href="/cart">购物车<span class="cms-cart-badge"></span></a>
      <a class="text-decoration-none text-secondary" href="/user/login">登录 / 注册</a>
      {% endif %}
    </div>
  </div>
</header>
"""


def foot_bar():
    return """<footer class="ent-footer">
  <div class="container">
    <div class="row g-4">
      <div class="col-md-4">
        <h6 class="fw-bold">产品与服务</h6>
        {% for c in get_product_categories(0) %}
        <a class="d-block py-1" href="{{ category_url(c.id) }}">{{ c.name }}</a>
        {% endfor %}
      </div>
      <div class="col-md-4">
        <h6 class="fw-bold">快速导航</h6>
        {% for c in get_categories(0) %}
        <a class="d-block py-1" href="/category/{{ c.shortUrl | default('') }}">{{ c.categoryName }}</a>
        {% endfor %}
      </div>
      <div class="col-md-4">
        <h6 class="fw-bold">联系我们</h6>
        <p class="mb-1">电话：{{ tpl_var("phone") | default('-') }}</p>
        <p class="mb-1">邮箱：{{ tpl_var("email") | default('-') }}</p>
        <p class="mb-1">地址：{{ tpl_var("address") | default('-') }}</p>
      </div>
    </div>
    <hr>
    <div class="d-flex justify-content-between flex-wrap gap-2 small">
      <span>© {{ site.siteName | default('MxxCRM') }} · {{ tpl_var("icp") | default('') }}</span>
      <a href="/sitemap.html">站点地图</a>
    </div>
  </div>
</footer>
<script src="/static/default/js/cms.js"></script>
"""


