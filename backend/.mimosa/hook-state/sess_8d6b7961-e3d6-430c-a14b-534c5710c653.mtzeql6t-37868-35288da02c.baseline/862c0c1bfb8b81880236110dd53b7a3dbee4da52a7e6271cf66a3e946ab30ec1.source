use crate::core::errors::error::{Error, Result};
use crate::modules::inventory::entity::warehouse::{Entity as WarehouseEntity, ActiveModel as WarehouseActiveModel, Column as WarehouseColumn};
use crate::modules::inventory::entity::warehouse_area::{Entity as WarehouseAreaEntity, ActiveModel as WarehouseAreaActiveModel, Column as WarehouseAreaColumn};
use crate::modules::inventory::entity::{stock, inbound, outbound, stocktake, transfer};
use crate::modules::inventory::model::warehouse::{WarehouseDetailVO, WarehouseListQuery, WarehouseListVO, WarehouseSaveRequest, WarehouseUpdateRequest};
use crate::modules::inventory::model::warehouse;
use crate::modules::system::entity::admin;
use sea_orm::*;
use sea_orm::sea_query::Expr;

/// 仓库身份判定结果
pub struct WhIdentity {
    pub user_id: i64,
    pub is_super: bool,
    /// 持有 product:warehouse:view_all（仓储管理层）
    pub is_management: bool,
    /// 互看开关：开启后库管可只读查看全部仓库
    pub cross_view: bool,
}

/// 互看开关（mxx_system_config，实时查库，保存后即时生效，无需重启）
pub async fn is_cross_view_enabled() -> bool {
    matches!(
        crate::modules::system::service::config_service::find_value_by_key_from_db("warehouse_cross_view_enabled").await,
        Some(v) if v == "1"
    )
}

/// 解析当前用户在仓储域的身份（超管/管理层/库管）
pub async fn resolve_identity(db: &DatabaseConnection, user_id: i64) -> WhIdentity {
    let is_super = match crate::modules::system::service::admin_service::get_by_detail(db, &Some(user_id)).await {
        Ok(a) => a.user_type == Some(1),
        Err(_) => false,
    };
    let perms = crate::modules::system::service::permission_cache_service::get_or_load_permissions(db, user_id).await;
    let is_management = perms.iter().any(|p| p == "product:warehouse:view_all");
    let cross_view = is_cross_view_enabled().await;
    WhIdentity { user_id, is_super, is_management, cross_view }
}

/// 可见：超管/管理层/负责人/互看开启
pub fn can_view(wh: &warehouse::Model, ident: &WhIdentity) -> bool {
    ident.is_super
        || ident.is_management
        || wh.manager_id == Some(ident.user_id)
        || ident.cross_view
}

/// 可改：超管/管理层/负责人（互看永远不给写权限）
pub fn can_edit(wh: &warehouse::Model, ident: &WhIdentity) -> bool {
    ident.is_super
        || ident.is_management
        || wh.manager_id == Some(ident.user_id)
}

/// 校验可写，不满足返回业务 403 语义错误
pub fn ensure_can_edit(wh: &warehouse::Model, ident: &WhIdentity) -> Result<()> {
    if can_edit(wh, ident) {
        Ok(())
    } else {
        Err(Error::from("无权操作他人仓库"))
    }
}

pub async fn get_list(db: &DatabaseConnection, query: &WarehouseListQuery, user_id: i64) -> Result<WarehouseListVO> {
    let ident = resolve_identity(db, user_id).await;
    let scope = query.scope.clone().unwrap_or_default();

    // 未带 scope = 单据下拉的基础参考数据：全部启用仓（档案引用，不做身份过滤）
    if scope.is_empty() {
        let (models, total) = warehouse::select_page(db, query, warehouse::ScopeFilter { deleted: 0, manager_eq: None, delete_by_eq: None }).await?;
        let items = models.into_iter().map(|m| m.into()).collect();
        return Ok(WarehouseListVO { total: total as i64, items, cross_view_enabled: None, is_management: None });
    }

    let is_all_viewer = ident.is_super || ident.is_management || ident.cross_view;
    let f = match scope.as_str() {
        "all" => {
            if !is_all_viewer {
                // 库管 + 互看关闭：返回空集（不报错，前端据此隐藏 Tab）
                return Ok(WarehouseListVO { total: 0, items: vec![], cross_view_enabled: Some(ident.cross_view), is_management: Some(ident.is_super || ident.is_management) });
            }
            warehouse::ScopeFilter { deleted: 0, manager_eq: None, delete_by_eq: None }
        }
        "mine" => warehouse::ScopeFilter { deleted: 0, manager_eq: Some(user_id), delete_by_eq: None },
        "recycle" => {
            let delete_by_eq = if ident.is_super || ident.is_management { None } else { Some(user_id) };
            warehouse::ScopeFilter { deleted: 1, manager_eq: None, delete_by_eq }
        }
        _ => warehouse::ScopeFilter { deleted: 0, manager_eq: None, delete_by_eq: None },
    };

    let (models, total) = warehouse::select_page(db, query, f).await?;
    let mut items: Vec<warehouse::WarehouseVO> = models.into_iter().map(|m| m.into()).collect();

    // 回收站补删除人名称
    if scope == "recycle" {
        let ids: Vec<i64> = items.iter().filter_map(|i| i.delete_by).collect();
        let mut names: std::collections::HashMap<i64, String> = std::collections::HashMap::new();
        if !ids.is_empty() {
            if let Ok(rows) = admin::Entity::find()
                .filter(admin::Column::Id.is_in(ids))
                .all(db)
                .await
            {
                for a in rows {
                    names.insert(a.id, a.nick_name.or(a.user_name).unwrap_or_default());
                }
            }
        }
        for i in &mut items {
            if let Some(did) = i.delete_by {
                i.delete_by_name = names.get(&did).cloned();
            }
        }
    }

    Ok(WarehouseListVO {
        total: total as i64,
        items,
        cross_view_enabled: Some(ident.cross_view),
        is_management: Some(ident.is_super || ident.is_management),
    })
}

pub async fn get_detail(db: &DatabaseConnection, id: i64, user_id: i64) -> Result<WarehouseDetailVO> {
    let model = warehouse::find_by_id(db, id).await?
        .ok_or_else(|| format!("仓库不存在，ID: {}", id))?;
    let ident = resolve_identity(db, user_id).await;
    if !can_view(&model, &ident) {
        return Err(Error::from("无权查看该仓库"));
    }
    Ok(model.into())
}

pub async fn insert(db: &DatabaseConnection, data: &WarehouseSaveRequest, created_by: i64) -> Result<i64> {
    let id = warehouse::insert(db, data, created_by).await?;
    Ok(id)
}

pub async fn update(db: &DatabaseConnection, data: &WarehouseUpdateRequest, updated_by: i64) -> Result<i64> {
    let id = data.id.ok_or_else(|| "仓库ID不能为空".to_string())?;
    let model = warehouse::find_by_id(db, id).await?
        .ok_or_else(|| "仓库不存在".to_string())?;
    let ident = resolve_identity(db, updated_by).await;
    ensure_can_edit(&model, &ident)?;
    let rows = warehouse::update_by_id(db, id, data, updated_by).await?;
    Ok(rows)
}

/// 库存余额校验：非零余额即拒删（A1）
async fn stock_balance_block(db: &DatabaseConnection, ids: &[i64]) -> Result<Option<String>> {
    let rows = stock::Entity::find()
        .filter(stock::Column::WarehouseId.is_in(ids.to_vec()))
        .filter(stock::Column::Deleted.eq(0))
        .filter(
            stock::Column::Quantity.ne(0)
                .or(stock::Column::ReservedQuantity.ne(0))
                .or(stock::Column::InTransitQuantity.ne(0))
                .or(stock::Column::FrozenQuantity.ne(0)),
        )
        .all(db)
        .await
        .map_err(|e| Error::from(e.to_string()))?;
    if rows.is_empty() {
        return Ok(None);
    }
    // 按仓库聚合商品种数
    let mut per_wh: std::collections::HashMap<i64, usize> = std::collections::HashMap::new();
    for s in &rows {
        if let Some(wid) = s.warehouse_id {
            *per_wh.entry(wid).or_insert(0) += 1;
        }
    }
    let mut detail = String::new();
    for (wid, cnt) in &per_wh {
        let name = WarehouseEntity::find_by_id(*wid).one(db).await
            .ok().flatten()
            .and_then(|w| w.name)
            .unwrap_or_else(|| wid.to_string());
        detail.push_str(&format!("仓库「{}」尚有 {} 种商品库存；", name, cnt));
    }
    Ok(Some(detail))
}

/// 未完成单据校验：四类单据在途即拒删（transfer 需同时查调出/调入两侧）
async fn has_pending_docs(db: &DatabaseConnection, ids: &[i64]) -> Result<Option<String>> {
    let blocked_in = inbound::Entity::find()
        .filter(inbound::Column::WarehouseId.is_in(ids.to_vec()))
        .filter(inbound::Column::Deleted.eq(0))
        .filter(inbound::Column::Status.is_in([0, 1]))
        .one(db).await.map_err(|e| Error::from(e.to_string()))?;
    if blocked_in.is_some() {
        return Ok(Some("存在未完成的入库单".to_string()));
    }
    let blocked_out = outbound::Entity::find()
        .filter(outbound::Column::WarehouseId.is_in(ids.to_vec()))
        .filter(outbound::Column::Deleted.eq(0))
        .filter(outbound::Column::Status.is_in([0, 1, 2]))
        .one(db).await.map_err(|e| Error::from(e.to_string()))?;
    if blocked_out.is_some() {
        return Ok(Some("存在未完成的出库单".to_string()));
    }
    let blocked_tf = transfer::Entity::find()
        .filter(transfer::Column::Deleted.eq(0))
        .filter(transfer::Column::Status.is_in([0, 1, 2, 3]))
        .filter(
            transfer::Column::FromWarehouseId.is_in(ids.to_vec())
                .or(transfer::Column::ToWarehouseId.is_in(ids.to_vec())),
        )
        .one(db).await.map_err(|e| Error::from(e.to_string()))?;
    if let Some(t) = blocked_tf {
        return Ok(Some(format!("存在未完成的调拨单 {}", t.transfer_no.clone().unwrap_or_default())));
    }
    let blocked_st = stocktake::Entity::find()
        .filter(stocktake::Column::WarehouseId.is_in(ids.to_vec()))
        .filter(stocktake::Column::Deleted.eq(0))
        .filter(stocktake::Column::Status.is_in([0, 1]))
        .one(db).await.map_err(|e| Error::from(e.to_string()))?;
    if blocked_st.is_some() {
        return Ok(Some("存在未完成的盘点单".to_string()));
    }
    Ok(None)
}

pub async fn batch_delete(db: &DatabaseConnection, ids: &[i64], operator_id: i64) -> Result<i64> {
    if ids.is_empty() {
        return Err(Error::from("请选择要删除的记录"));
    }
    let ident = resolve_identity(db, operator_id).await;

    for id in ids {
        let wh = warehouse::find_by_id(db, *id).await?
            .ok_or_else(|| Error::from(format!("仓库不存在，ID: {}", id)))?;
        ensure_can_edit(&wh, &ident)?;
        // A3：必须先停用（对齐金蝶/ERPNext"先停用再删"）
        if wh.is_active != Some(false) {
            let name = wh.name.clone().unwrap_or_default();
            return Err(Error::from(format!("仓库「{}」未停用，请先停用后再删除", name)));
        }
    }

    // A1：库存余额
    if let Some(msg) = stock_balance_block(db, ids).await? {
        return Err(Error::from(format!("{}请先清库或做库存调整", msg)));
    }
    // A2：在途单据
    if let Some(msg) = has_pending_docs(db, ids).await? {
        return Err(Error::from(format!("{}，不能删除仓库", msg)));
    }

    let ids_vec = ids.to_vec();
    let res = db.transaction::<_, i64, DbErr>(|txn| {
        Box::pin(async move {
            let now = chrono::Local::now().naive_local();
            WarehouseAreaEntity::update_many()
                .set(WarehouseAreaActiveModel {
                    deleted: Set(Some(1)),
                    ..Default::default()
                })
                .filter(WarehouseAreaColumn::WarehouseId.is_in(ids_vec.clone()))
                .exec(txn)
                .await?;
            let r = WarehouseEntity::update_many()
                .set(WarehouseActiveModel {
                    deleted: Set(Some(1)),
                    delete_time: Set(Some(now)),
                    delete_by: Set(Some(operator_id)),
                    ..Default::default()
                })
                .filter(WarehouseColumn::Id.is_in(ids_vec))
                .exec(txn)
                .await?;
            Ok(r.rows_affected as i64)
        })
    })
    .await
    .map_err(|e| Error::from(e.to_string()))?;
    Ok(res)
}

/// 回收站恢复（负责人/管理层/超管）
pub async fn restore(db: &DatabaseConnection, id: i64, operator_id: i64) -> Result<i64> {
    let wh = WarehouseEntity::find_by_id(id)
        .filter(WarehouseColumn::Deleted.eq(1))
        .one(db)
        .await
        .map_err(|e| Error::from(e.to_string()))?
        .ok_or_else(|| Error::from("回收站中不存在该仓库"))?;
    let ident = resolve_identity(db, operator_id).await;
    ensure_can_edit(&wh, &ident)?;

    let now = chrono::Local::now().naive_local();
    let res = db.transaction::<_, i64, DbErr>(|txn| {
        Box::pin(async move {
            WarehouseAreaEntity::update_many()
                .set(WarehouseAreaActiveModel {
                    deleted: Set(Some(0)),
                    ..Default::default()
                })
                .filter(WarehouseAreaColumn::WarehouseId.eq(id))
                .exec(txn)
                .await?;
            WarehouseEntity::update_many()
                .col_expr(WarehouseColumn::Deleted, Expr::value(0))
                .col_expr(WarehouseColumn::DeleteTime, Expr::value(None::<chrono::NaiveDateTime>))
                .col_expr(WarehouseColumn::DeleteBy, Expr::value(None::<i64>))
                .col_expr(WarehouseColumn::UpdateTime, Expr::value(now))
                .filter(WarehouseColumn::Id.eq(id))
                .exec(txn)
                .await?;
            Ok(id)
        })
    })
    .await
    .map_err(|e| Error::from(e.to_string()))?;
    Ok(res)
}

/// 彻底删除（仅管理层/超管，回收站内；物理删除前重跑库存/单据校验）
pub async fn purge(db: &DatabaseConnection, id: i64, operator_id: i64) -> Result<i64> {
    let ident = resolve_identity(db, operator_id).await;
    if !ident.is_super && !ident.is_management {
        return Err(Error::from("无权操作他人仓库"));
    }
    WarehouseEntity::find_by_id(id)
        .filter(WarehouseColumn::Deleted.eq(1))
        .one(db)
        .await
        .map_err(|e| Error::from(e.to_string()))?
        .ok_or_else(|| Error::from("回收站中不存在该仓库"))?;

    if let Some(msg) = stock_balance_block(db, &[id]).await? {
        return Err(Error::from(format!("{}，请先清库或做库存调整", msg)));
    }
    if let Some(msg) = has_pending_docs(db, &[id]).await? {
        return Err(Error::from(format!("{}，不能删除仓库", msg)));
    }

    let res = db.transaction::<_, i64, DbErr>(|txn| {
        Box::pin(async move {
            WarehouseAreaEntity::delete_many()
                .filter(WarehouseAreaColumn::WarehouseId.eq(id))
                .exec(txn)
                .await?;
            WarehouseEntity::delete_by_id(id).exec(txn).await?;
            Ok(id)
        })
    })
    .await
    .map_err(|e| Error::from(e.to_string()))?;
    Ok(res)
}
