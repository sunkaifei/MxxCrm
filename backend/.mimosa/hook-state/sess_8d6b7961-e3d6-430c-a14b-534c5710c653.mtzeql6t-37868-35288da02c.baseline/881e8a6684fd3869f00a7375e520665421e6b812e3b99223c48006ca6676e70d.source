# -*- coding: utf-8 -*-
"""Generate d66 SQL: seed virtual HR data for all admin accounts."""
import io

# id, slug(email), gender(0男1女), birth, degree, school, prev_company, cert, probation(月,None), ratio
PEOPLE = [
    (3,  "admin",       0, "1985-06-12", "硕士", "清华大学",           "联想集团",       "PMP项目管理认证",     3, "0.80"),
    (4,  "system",      0, "1990-03-25", "本科", "北京邮电大学",       "神州数码",       "华为HCIA认证",        3, "0.80"),
    (5,  "sales-dir",   0, "1983-11-08", "硕士", "北京大学",           "华为技术",       "无",                  0, None),
    (6,  "sales-mgr",   0, "1988-07-19", "本科", "中国人民大学",       "用友网络",       "无",                  3, "0.80"),
    (7,  "salesman",    0, "1992-05-30", "大专", "北京信息职业技术学院","东华软件",      "无",                  3, "0.60"),
    (8,  "buyer",       1, "1993-12-02", "本科", "北京工商大学",       "京东集团",       "CPIM供应链认证",      3, "0.80"),
    (9,  "zhangsan",    0, "1991-09-14", "本科", "北京理工大学",       "中软国际",       "软件设计师(软考)",    3, "0.80"),
    (10, "lisi",        0, "1992-02-21", "大专", "北京联合大学",       "亚信科技",       "无",                  3, "0.80"),
    (12, "finance-a",   1, "1995-04-18", "本科", "首都经济贸易大学",   "瑞华会计师事务所","初级会计职称",       3, "0.80"),
    (13, "ceo",         0, "1980-01-27", "硕士", "复旦大学",           "新浪集团",       "无",                  0, None),
    (14, "warehouse",   0, "1987-08-08", "大专", "北京物资学院",       "顺丰速运",       "物流师职业资格",      0, None),
    (15, "doc-op",      1, "1994-10-11", "大专", "北京财贸职业学院",   "慧聪集团",       "无",                  0, None),
    (16, "hr-mgr",      1, "1989-06-06", "本科", "北京师范大学",       "智联招聘",       "人力资源管理师二级",  3, "0.80"),
    (17, "fin-mgr",     1, "1986-03-03", "本科", "中央财经大学",       "德勤华永",       "中级会计职称",        0, None),
]

NICK = {3:"超级管理员",4:"系统管理员",5:"销售总监",6:"销售经理",7:"业务员",8:"采购专员",
        9:"张三",10:"李四",12:"财务专员",13:"CEO",14:"库管",15:"制单员",16:"人事经理",17:"财务经理"}
HIRE = {3:"2026-06-15",4:"2026-06-15",5:"2026-06-15",6:"2026-06-15",7:"2026-06-15",8:"2026-06-15",
        9:"2026-07-04",10:"2026-07-04",12:"2026-07-31",13:"2026-08-09",14:"2024-01-01",15:"2024-01-01",
        16:"2026-06-15",17:"2026-07-31"}
BANKS = ["工商银行","建设银行","招商银行","中国银行","农业银行","交通银行","邮储银行"]
DEGREE_YEARS = {"大专":3,"本科":4,"硕士":3}
SCHOOL_2008 = {"清华大学":2004,"北京邮电大学":2009,"北京大学":2003,"中国人民大学":2007,
  "北京信息职业技术学院":2010,"北京工商大学":2012,"北京理工大学":2010,"北京联合大学":2011,
  "首都经济贸易大学":2014,"复旦大学":1999,"北京物资学院":2006,"北京财贸职业学院":2013,
  "北京师范大学":2008,"中央财经大学":2005}
WORK1 = {"联想集团":2010,"神州数码":2013,"华为技术":2008,"用友网络":2011,"东华软件":2015,
  "京东集团":2016,"中软国际":2014,"亚信科技":2015,"瑞华会计师事务所":2017,"新浪集团":2005,
  "顺丰速运":2010,"慧聪集团":2016,"智联招聘":2012,"德勤华永":2009}
RELATIONS = ["配偶","父亲","母亲"]
CONTACT_NAMES = ["王秀英","刘建国","陈桂芳","杨建军","赵敏","孙丽华","周涛","吴静",
  "郑国强","冯淑兰","蒋立新","韩雪梅","曹志远","许燕"]

ID_AREA = "110101"  # 北京东城（虚拟）
WEIGHTS = [7,9,10,5,8,4,2,1,6,3,7,9,10,5,8,4,2]
CHECK = "10X98765432"

def id_checksum(base17: str) -> str:
    s = sum(int(c) * w for c, w in zip(base17, WEIGHTS))
    return CHECK[s % 11]

def gen_id(birth: str, gender: int, seq: int) -> str:
    b = birth.replace("-", "")
    # 性别码：男奇女偶
    g = (seq * 2 + 1) if gender == 0 else (seq * 2)
    base17 = f"{ID_AREA}{b}{g:03d}"
    return base17 + id_checksum(base17)

def esc(s: str) -> str:
    return s.replace("'", "''")

lines = []
lines.append("-- =====================================================================")
lines.append("-- d66: 补齐员工虚拟档案数据（邮箱/手机/性别/身份证/银行卡/工作城市/")
lines.append("--       试用期/合同/简历(教育+工作+证书)/紧急联系人）")
lines.append("-- 数据全部为虚构演示数据：手机号 13910001xxx 段、身份证校验位合法但")
lines.append("--   区域/序列虚构、邮箱 @mxxdemo.com、银行卡号虚构。")
lines.append("-- 幂等：档案字段按账号覆盖更新；简历先软删后重插；紧急联系人只补缺。")
lines.append("-- 执行：PGPASSWORD=123456 psql -U postgres -h 127.0.0.1 -d mxxcrm_data \\")
lines.append("--        -v ON_ERROR_STOP=1 -f backend/scripts/d66_seed_hr_virtual_data.sql")
lines.append("-- =====================================================================")
lines.append("")
lines.append("UPDATE mxx_hr_resume SET deleted = 1 WHERE deleted = 0;")
lines.append("")

used_mobiles = set()
used_ids = set()
used_banks = set()
used_contact_mobiles = set()

for i, (aid, slug, gender, birth, degree, school, company, cert, prob_m, prob_r) in enumerate(PEOPLE):
    email = f"{slug}@mxxdemo.com"
    mobile = f"1391000{i+100:04d}"
    assert mobile not in used_mobiles; used_mobiles.add(mobile)
    idcard = gen_id(birth, gender, i + 1)
    assert idcard not in used_ids; used_ids.add(idcard)
    bank = f"6222021{i:02d}{1000000000 + i * 7919}"[:19]
    assert bank not in used_banks; used_banks.add(bank)
    bank_name = BANKS[i % len(BANKS)]
    nick = NICK[aid]
    prob_sql = f"{prob_m}, {prob_r}" if prob_m else "NULL, NULL"
    lines.append(
        f"UPDATE mxx_system_admin SET email='{email}', mobile='{mobile}', gender={gender}, "
        f"id_card_no='{idcard}', id_locked=1, bank_card_no='{bank}', bank_name='{bank_name}', "
        f"bank_account_name='{nick}', bank_locked=1, work_city_code='beijing', "
        f"contract_type=1, contract_months=36, probation_months={prob_sql.split(', ')[0]}, "
        f"probation_ratio={prob_r if prob_r else 'NULL'} "
        f"WHERE id={aid};"
    )

    # ---- 简历：教育 + 工作1-2段 + 证书 ----
    school_year = SCHOOL_2008[school]
    edu_start = f"{school_year}-09-01"
    edu_end = f"{school_year + DEGREE_YEARS[degree]}-06-30"
    lines.append(
        f"INSERT INTO mxx_hr_resume (admin_id, kind, title, org, start_date, end_date, remark, is_public, deleted, create_time) "
        f"VALUES ({aid}, 1, '{degree}', '{esc(school)}', '{edu_start}', '{edu_end}', NULL, 1, 0, NOW());"
    )
    w1_start = f"{SCHOOL_2008[school] + DEGREE_YEARS[degree]}-07-01"
    w1_end = f"{school_year + DEGREE_YEARS[degree] + 6}-06-30"
    lines.append(
        f"INSERT INTO mxx_hr_resume (admin_id, kind, title, org, start_date, end_date, remark, is_public, deleted, create_time) "
        f"VALUES ({aid}, 2, '职员', '{esc(company)}', '{w1_start}', '{w1_end}', NULL, 1, 0, NOW());"
    )
    # 第二段工作经历（部分人有）：入职前 2-4 年至今
    if i % 2 == 0:
        w2_start = f"{school_year + DEGREE_YEARS[degree] + 6}-07-01"
        w2_end = "2026-05-31"
        lines.append(
            f"INSERT INTO mxx_hr_resume (admin_id, kind, title, org, start_date, end_date, remark, is_public, deleted, create_time) "
            f"VALUES ({aid}, 2, '主管', '北京华信科技', '{w2_start}', '{w2_end}', NULL, 1, 0, NOW());"
        )
    if cert != "无":
        cert_year = school_year + DEGREE_YEARS[degree] + 3
        lines.append(
            f"INSERT INTO mxx_hr_resume (admin_id, kind, title, org, start_date, end_date, remark, is_public, deleted, create_time) "
            f"VALUES ({aid}, 3, '{esc(cert)}', '发证机构', '{cert_year}-06-01', NULL, NULL, 1, 0, NOW());"
        )

    # ---- 紧急联系人：只给没有的补 1 条 ----
    cname = CONTACT_NAMES[i]
    cmobile = f"1392000{i+100:04d}"
    assert cmobile not in used_contact_mobiles; used_contact_mobiles.add(cmobile)
    lines.append(
        f"INSERT INTO mxx_hr_emergency_contact (admin_id, name, relation, mobile, sort, deleted, create_time) "
        f"SELECT {aid}, '{esc(cname)}', '{RELATIONS[i % 3]}', '{cmobile}', 1, 0, NOW() "
        f"WHERE NOT EXISTS (SELECT 1 FROM mxx_hr_emergency_contact WHERE admin_id={aid} AND deleted=0);"
    )

sql = "\n".join(lines) + "\n"
io.open(r"C:/codework/MxxCrm/backend/scripts/d66_seed_hr_virtual_data.sql", "w", encoding="utf-8", newline="\n").write(sql)
print("generated, lines:", len(lines))
