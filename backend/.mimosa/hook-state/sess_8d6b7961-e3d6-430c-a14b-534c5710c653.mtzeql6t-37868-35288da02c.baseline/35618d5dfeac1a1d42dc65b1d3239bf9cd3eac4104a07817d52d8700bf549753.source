# -*- coding: utf-8 -*-
# E2E: salary-adjustment fixes smoke test (name/post columns, approve Json body, reject_reason)
import json, re, sys, io
import urllib.request
import msgpack

sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8")
BASE = "http://127.0.0.1:8088"

def call(method, path, token=None, body=None):
    req = urllib.request.Request(BASE + path, method=method)
    req.add_header("Content-Type", "application/json")
    if token:
        req.add_header("Authorization", "Bearer " + token)
    data = json.dumps(body).encode("utf-8") if body is not None else None
    with urllib.request.urlopen(req, data=data, timeout=15) as resp:
        raw = resp.read()
        return msgpack.unpackb(raw, raw=False)

# 1. login
r = call("POST", "/api/system/auth/login", body={"username": "admin", "password": "admin123"})
m = re.search(rb"eyJ[A-Za-z0-9_\-\.]+", msgpack.packb(r) if not isinstance(r, bytes) else b"")
s = json.dumps(r, default=str)
toks = re.findall(r"eyJ[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+", s)
assert toks, "no jwt found in login response: " + s[:300]
token = max(toks, key=len)
print("1. login ok")

# 2. list with employeeName/postName
r = call("GET", "/api/system/finance/salary-adjustment/list?page=1&pageSize=5", token)
data = r.get("data") or []
data = data.get("items") if isinstance(data, dict) else data
rows = data if isinstance(data, list) else []
print("2. list rows:", len(rows))
for row in rows[:3]:
    print("   id=%s employeeId=%s name=%r post=%r" % (
        row.get("id"), row.get("employeeId"),
        row.get("employeeName"), row.get("postName")))
assert rows and all("employeeName" in x for x in rows), "employeeName missing"

# pick an employee id for test record (from an existing row, else admin id=1)
eid = rows[0]["employeeId"] if rows else 1

# 3. create test adjustment
r = call("POST", "/api/system/finance/salary-adjustment/create", token, {
    "employeeId": eid,
    "adjustmentDate": "2026-09-01",
    "adjustmentType": 2,
    "newBaseSalary": 100.0,
    "adjustmentReason": "E2E-调薪原因测试-可删除",
})
print("3. create resp:", r.get("code"), r.get("msg"), "data(id)=", r.get("data"))
new_id = r.get("data")
assert r.get("code") == 200 and new_id, "create failed"

# 4. approve with non-existent id -> proves Json body parsed (business error, not deserialize error)
r = call("POST", "/api/system/finance/salary-adjustment/approve", token, {"id": 999999999})
msg = r.get("msg", "")
print("4. approve(bad id) resp:", r.get("code"), msg)
assert "记录不存在" in msg or "不存在" in msg, "approve Json body not parsed: " + msg

# 5. reject the test record -> reject_reason stored, adjustment_reason preserved
r = call("POST", "/api/system/finance/salary-adjustment/reject", token, {
    "id": new_id, "reason": "E2E-驳回理由测试-可删除"})
print("5. reject resp:", r.get("code"), r.get("msg"))
assert r.get("code") == 200, "reject failed"

# 6. verify via detail in list
r = call("GET", "/api/system/finance/salary-adjustment/list?page=1&pageSize=50&employeeId=%d" % eid, token)
data = r.get("data") or []
data = data.get("items") if isinstance(data, dict) else data
row = next((x for x in data if x.get("id") == new_id), None)
assert row, "test row not found"
print("6. test row: status=%s adjustmentReason=%r rejectReason=%r" % (
    row.get("status"), row.get("adjustmentReason"), row.get("rejectReason")))
assert row.get("status") == 2
assert row.get("adjustmentReason") == "E2E-调薪原因测试-可删除"
assert row.get("rejectReason") == "E2E-驳回理由测试-可删除"
print("ALL PASS")
print("TEST_ROW_ID=%d" % new_id)
