use crate::core::errors::error::Result;
use crate::core::kit::global::AppState;
use crate::core::kit::CONTEXT;
use crate::core::web::response::{MetaResp, MPACK};
use crate::modules::website::model::website_user::{WebsiteUserLoginRequest, WebsiteUserRegisterRequest};
use crate::modules::website::service::website_user_service;
use actix_web::{post, web, HttpRequest, HttpResponse};

/// POST /api/open/website/user/register - 前台用户注册
#[post("/api/open/website/user/register")]
pub async fn register(
    state: web::Data<AppState>,
    req: HttpRequest,
    body: web::Json<WebsiteUserRegisterRequest>,
) -> Result<HttpResponse> {
    let db = &state.db;

    // 验证码设置: 按 register_captcha_type 分派校验（image / click / none）
    // 非法配置值统一回退 image，禁止静默跳过校验（与后台注册口径一致，防止公网恶意刷注册）
    {
        let mode = crate::modules::system::service::captcha_service::get_page_captcha_mode("register").await;
        match mode.as_str() {
            "click" => {
                if let Err(msg) = crate::modules::system::service::captcha_service::consume_click_ticket(
                    db,
                    &body.captcha_ticket.clone().unwrap_or_default(),
                ).await {
                    return Ok(HttpResponse::Ok().content_type(MPACK).body(MetaResp::<String>::fail(400, &msg, "local")));
                }
            }
            "image" => {
                let verify_code = body.captcha_code.clone().unwrap_or_default();
                let captcha_uuid = body.captcha_key.clone().unwrap_or_default();
                if verify_code.trim().is_empty() || captcha_uuid.trim().is_empty() {
                    return Ok(HttpResponse::Ok().content_type(MPACK).body(MetaResp::<String>::fail(400, "验证码不能为空", "local")));
                }
                let captcha_cache_key = format!("captcha:cache_{}", captcha_uuid.trim());
                let cache_captcha = CONTEXT.cache_service.get_string(&captcha_cache_key).await.unwrap_or_default();
                let _ = CONTEXT.cache_service.del(&captcha_cache_key).await;
                if cache_captcha.is_empty() {
                    return Ok(HttpResponse::Ok().content_type(MPACK).body(MetaResp::<String>::fail(400, "验证码已过期，请刷新后重试", "local")));
                }
                if !cache_captcha.eq_ignore_ascii_case(verify_code.trim()) {
                    return Ok(HttpResponse::Ok().content_type(MPACK).body(MetaResp::<String>::fail(400, "验证码不正确", "local")));
                }
            }
            _ => {} // disabled / none：关闭校验（总开关关闭或显式配置不校验）
        }
    }

    let ip_address = req.peer_addr().map(|addr| addr.ip().to_string());
    let result = website_user_service::register(db, body.into_inner(), ip_address).await;
    Ok(HttpResponse::Ok()
        .content_type(MPACK)
        .body(MetaResp::<i64>::handle_result(result)))
}

/// POST /api/open/website/user/login - 前台用户登录
#[post("/api/open/website/user/login")]
pub async fn login(
    state: web::Data<AppState>,
    req: HttpRequest,
    body: web::Json<WebsiteUserLoginRequest>,
) -> Result<HttpResponse> {
    let db = &state.db;
    let ip_address = req.peer_addr().map(|addr| addr.ip().to_string());
    match website_user_service::login(db, body.into_inner(), ip_address).await {
        Ok(vo) => Ok(HttpResponse::Ok()
            .content_type(MPACK)
            .body(MetaResp::success(vo, "local"))),
        Err(e) => Ok(HttpResponse::Ok()
            .content_type(MPACK)
            .body(MetaResp::<String>::fail(400, &e.to_string(), "local"))),
    }
}
