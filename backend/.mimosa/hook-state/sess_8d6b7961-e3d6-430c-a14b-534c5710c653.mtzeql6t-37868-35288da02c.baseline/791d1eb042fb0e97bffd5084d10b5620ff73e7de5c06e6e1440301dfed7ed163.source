pub async fn lead_update_status(state: web::Data<AppState>, req: HttpRequest, form_data: web::Json<LeadStatusUpdateQuery>) -> HttpResponse {
    let db = &state.db;
    let query = form_data.0;

    if query.id.is_none() {
        return HttpResponse::Ok().content_type(MPACK).body(MetaResp::<String>::fail(400, "线索ID不能为空", "local"));
    }

    if query.status.is_none() {
        return HttpResponse::Ok().content_type(MPACK).body(MetaResp::<String>::fail(400, "状态不能为空", "local"));
    }

    let result = lead_service::update_status(&db, query.id.unwrap(), query.status.unwrap(), Some(get_current_user_id(&req))).await;
    HttpResponse::Ok().content_type(MPACK).body(MetaResp::<i64>::handle_result(result))
}

pub async fn lead_add_to_pool(state: web::Data<AppState>, req: HttpRequest, form_data: web::Json<LeadPoolReleaseRequest>) -> HttpResponse {
    let db = &state.db;
    let query = form_data.0;

    if query.id.is_none() {
        return HttpResponse::Ok().content_type(MPACK).body(MetaResp::<String>::fail(400, "线索ID不能为空", "local"));
    }

    let user_id = get_current_user_id(&req);
    let lead_id = query.id.unwrap();

    let result = lead_service::add_to_pool(
        &db,
        lead_id,
        Some(user_id),
        query.reason_type,
        query.reason.clone(),
    ).await;
    if result.is_ok() {
        // 审计埋点：退回线索池（记录退回原因，G6）
        crate::modules::system::service::audit_service::record(
            db,
            &req,
            "lead",
            "release",
            "lead",
            lead_id,
            format!("退回线索池，原因类型：{:?}", query.reason_type),
            crate::modules::system::service::audit_service::snap(vec![
                ("reason_type", serde_json::json!(query.reason_type)),
                ("reason", serde_json::json!(query.reason)),
            ]),
            None,
        ).await;
    }
    HttpResponse::Ok().content_type(MPACK).body(MetaResp::<i64>::handle_result(result))
}

/// 领取线索（单个，语义=成为负责人，不再建客户）
pub async fn lead_claim(state: web::Data<AppState>, req: HttpRequest, form_data: web::Json<InfoId>) -> HttpResponse {
    let db = &state.db;
    let query = form_data.0;

    if query.id.is_none() {
        return HttpResponse::Ok().content_type(MPACK).body(MetaResp::<String>::fail(400, "线索ID不能为空", "local"));
    }

    let lead_id = query.id.unwrap();
    match lead_pool_ops_service::claim(&db, get_current_user_id(&req), &[lead_id]).await {
        Ok(list) => match list.first() {
            Some(r) if r.success => HttpResponse::Ok().content_type(MPACK).body(MetaResp::success(true, "local")),
            Some(r) => HttpResponse::Ok().content_type(MPACK).body(MetaResp::<String>::fail(400, r.message.clone().unwrap_or_else(|| "领取失败".to_string()).as_str(), "local")),
            None => HttpResponse::Ok().content_type(MPACK).body(MetaResp::<String>::fail(400, "领取失败", "local")),
        },
        Err(e) => HttpResponse::Ok().content_type(MPACK).body(MetaResp::<String>::fail(400, &e.to_string(), "local")),
    }
}

/// 批量领取公海线索（部分成功返回逐条明细）
pub async fn lead_pool_claim(state: web::Data<AppState>, req: HttpRequest, form_data: web::Json<LeadPoolClaimRequest>) -> HttpResponse {
    let db = &state.db;
    let query = form_data.0;

    let lead_ids: Vec<i64> = query.ids.unwrap_or_default()
        .iter()
        .filter_map(|item| item.as_ref().and_then(|s| s.trim().parse().ok()))
        .collect();

    if lead_ids.is_empty() {
        return HttpResponse::Ok().content_type(MPACK).body(MetaResp::<String>::fail(400, "未获取到领取的线索ID", "local"));
    }

    match lead_pool_ops_service::claim(&db, get_current_user_id(&req), &lead_ids).await {
        Ok(list) => HttpResponse::Ok().content_type(MPACK).body(MetaResp::success(list, "local")),
        Err(e) => HttpResponse::Ok().content_type(MPACK).body(MetaResp::<Vec<PoolOpResultVO>>::fail(400, &e.to_string(), "local")),
    }
}

// ==================== 分配/退回/收回/归属历史 ====================

/// 批量分配公海线索给指定成员（管理员；多人按顺序均摊）
pub async fn lead_pool_assign(state: web::Data<AppState>, req: HttpRequest, form_data: web::Json<LeadPoolAssignRequest>) -> HttpResponse {
    let db = &state.db;
    let query = form_data.0;

    let lead_ids: Vec<i64> = query.ids.unwrap_or_default()
        .iter()
        .filter_map(|item| item.as_ref().and_then(|s| s.trim().parse().ok()))
        .collect();
    let mut to_user_ids: Vec<i64> = query.to_user_ids.unwrap_or_default()
        .iter()
        .filter_map(|item| item.as_ref().and_then(|s| s.trim().parse().ok()))
        .collect();
    if let Some(single) = query.to_user_id.as_ref().and_then(|s| s.trim().parse::<i64>().ok()) {
        if !to_user_ids.contains(&single) {
            to_user_ids.push(single);
        }
    }

    if lead_ids.is_empty() {
        return HttpResponse::Ok().content_type(MPACK).body(MetaResp::<String>::fail(400, "未获取到分配的线索ID", "local"));
    }
    if to_user_ids.is_empty() {
        return HttpResponse::Ok().content_type(MPACK).body(MetaResp::<String>::fail(400, "未获取到分配目标成员", "local"));
    }

    let (operator_id, operator_name) = get_current_user(&req);
    match lead_pool_ops_service::assign(&db, operator_id, &operator_name, &lead_ids, &to_user_ids).await {
        Ok(list) => HttpResponse::Ok().content_type(MPACK).body(MetaResp::success(list, "local")),
        Err(e) => HttpResponse::Ok().content_type(MPACK).body(MetaResp::<Vec<PoolOpResultVO>>::fail(400, &e.to_string(), "local")),
    }
}

/// 批量退回公海（负责人本人或池管理员；默认回来源池）
pub async fn lead_pool_release(state: web::Data<AppState>, req: HttpRequest, form_data: web::Json<LeadPoolReleaseBatchRequest>) -> HttpResponse {
    let db = &state.db;
    let query = form_data.0;

    let lead_ids: Vec<i64> = query.ids.unwrap_or_default()
        .iter()
        .filter_map(|item| item.as_ref().and_then(|s| s.trim().parse().ok()))
        .collect();
    if lead_ids.is_empty() {
        return HttpResponse::Ok().content_type(MPACK).body(MetaResp::<String>::fail(400, "未获取到退回的线索ID", "local"));
    }

    let target_pool_id = query.target_pool_id.as_ref().and_then(|s| s.trim().parse::<i64>().ok());
    match lead_pool_ops_service::release(&db, get_current_user_id(&req), &lead_ids, query.reason_type, &query.reason, target_pool_id).await {
        Ok(list) => HttpResponse::Ok().content_type(MPACK).body(MetaResp::success(list, "local")),
        Err(e) => HttpResponse::Ok().content_type(MPACK).body(MetaResp::<Vec<PoolOpResultVO>>::fail(400, &e.to_string(), "local")),
    }
}

/// 管理员收回线索（私海→池）
