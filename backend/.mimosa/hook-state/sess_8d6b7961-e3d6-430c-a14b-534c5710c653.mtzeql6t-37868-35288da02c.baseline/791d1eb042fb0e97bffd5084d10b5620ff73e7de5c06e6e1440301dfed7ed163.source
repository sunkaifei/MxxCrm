/// 延期审批分页
pub async fn lead_pool_retain_page(state: web::Data<AppState>, query: web::Query<LeadPoolRetainPageQuery>) -> HttpResponse {
    let db = &state.db;
    let query = query.0;

    match retain_apply_service::page(&db, &query).await {
        Ok(page_data) => {
            let page = page_data.current_page as u32;
            let total = page_data.total as u32;
            HttpResponse::Ok().content_type(MPACK).body(MetaResp::success_with_page(page_data, "local", page, total))
        },
        Err(e) => HttpResponse::Ok().content_type(MPACK).body(MetaResp::<String>::fail(400, &e.to_string(), "local")),
    }
}

/// 延期审批（通过=延长线索保留天数）
pub async fn lead_pool_retain_audit(state: web::Data<AppState>, req: HttpRequest, form_data: web::Json<LeadPoolRetainAuditRequest>) -> HttpResponse {
    let db = &state.db;
    let query = form_data.0;

    if query.id.is_none() {
        return HttpResponse::Ok().content_type(MPACK).body(MetaResp::<String>::fail(400, "申请ID不能为空", "local"));
    }

    match retain_apply_service::audit(&db, get_current_user_id(&req), query.id.unwrap(), query.approved.unwrap_or(false), query.remark).await {
        Ok(_) => HttpResponse::Ok().content_type(MPACK).body(MetaResp::success(true, "local")),
        Err(e) => HttpResponse::Ok().content_type(MPACK).body(MetaResp::<String>::fail(400, &e.to_string(), "local")),
    }
}

pub async fn lead_convert_to_customer(state: web::Data<AppState>, req: HttpRequest, form_data: web::Json<InfoId>) -> HttpResponse {
    let db = &state.db;
    let query = form_data.0;

    if query.id.is_none() {
        return HttpResponse::Ok().content_type(MPACK).body(MetaResp::<String>::fail(400, "线索ID不能为空", "local"));
    }

    match lead_service::convert_to_customer(&db, query.id.unwrap(), get_current_user_id(&req)).await {
        Ok(customer_id) => HttpResponse::Ok().content_type(MPACK).body(MetaResp::success(customer_id, "local")),
        Err(e) => HttpResponse::Ok().content_type(MPACK).body(MetaResp::<String>::fail(400, &e.to_string(), "local")),
    }
}

// ==================== 线索转移 ====================

/// 预览线索转移影响范围
pub async fn lead_transfer_preview(
    state: web::Data<AppState>,
    req: HttpRequest,
    form_data: web::Json<crate::modules::crm::service::lead_transfer_service::LeadTransferPreviewRequest>,
) -> Result<HttpResponse> {
    let db = &state.db;
    match lead_transfer_service::preview_transfer(db, &form_data.0).await {
        Ok(data) => Ok(HttpResponse::Ok()
            .content_type(MPACK)
            .body(MetaResp::success(data, "local"))),
        Err(e) => Ok(HttpResponse::Ok()
            .content_type(MPACK)
            .body(MetaResp::<String>::fail(400, &e.to_string(), "local"))),
    }
}

/// 执行线索转移
pub async fn lead_transfer(
    state: web::Data<AppState>,
    req: HttpRequest,
    form_data: web::Json<crate::modules::crm::service::lead_transfer_service::LeadTransferRequest>,
) -> Result<HttpResponse> {
    let db = &state.db;
    let (operator_id, operator_name) = get_current_user(&req);

    match lead_transfer_service::transfer_lead(
        db,
        &form_data.0,
        operator_id,
        Some(operator_name),
    )
    .await
    {
        Ok(data) => Ok(HttpResponse::Ok()
            .content_type(MPACK)
            .body(MetaResp::success(data, "local"))),
        Err(e) => Ok(HttpResponse::Ok()
            .content_type(MPACK)
            .body(MetaResp::<String>::fail(400, &e.to_string(), "local"))),
    }
}

// ==================== 路由注册（单点维护）====================

/// 注册线索模块所有路由
///
/// 修改路径、权限码、HTTP 方法只需修改本函数。
/// 调用方在 `admin_routes.rs` 中通过 `cfg.configure(lead_controller::register)` 注册。
pub fn register(cfg: &mut web::ServiceConfig) {
    cfg.service(
        web::scope("/lead")
            // POST /lead/save - 新建线索
            .route(
                "/save",
                web::post()
                    .to(lead_insert)
                    .wrap(require_permission("crm:lead:save")),
            )
            // PUT /lead/update - 修改线索
            .route(
                "/update",
                web::put()
                    .to(lead_update)
                    .wrap(require_permission("crm:lead:update")),
            )
            // DELETE /lead/bath_delete - 批量删除线索
            .route(
                "/bath_delete",
                web::delete()
                    .to(bath_delete_lead)
                    .wrap(require_permission("crm:lead:delete")),
            )
            // GET /lead/info - 线索详情
            .route(
                "/info",
                web::get()
                    .to(lead_info)
                    .wrap(require_permission("crm:lead:view")),
            )
            // GET /lead/list - 线索列表
            .route(
                "/list",
                web::get()
                    .to(lead_list)
                    .wrap(require_permission("crm:lead:list")),
            )
            // PUT /lead/update-status - 更新线索状态
            .route(
                "/update-status",
                web::put()
                    .to(lead_update_status)
                    .wrap(require_permission("crm:lead:update")),
            )
            // PUT /lead/add-to-pool - 退回公海
            .route(
                "/add-to-pool",
                web::put()
                    .to(lead_add_to_pool)
                    .wrap(require_permission("crm:lead:pool")),
            )
            // POST /lead/claim - 领取线索（语义=成为负责人）
            .route(
                "/claim",
                web::post()
                    .to(lead_claim)
                    .wrap(require_permission("crm:lead-pool:claim")),
            )
            // POST /lead/convert-to-customer - 线索转客户
            .route(
                "/convert-to-customer",
                web::post()
                    .to(lead_convert_to_customer)
                    .wrap(require_permission("crm:lead:update")),
            )
            // POST /lead/transfer/preview - 预览线索转移影响范围
            .route(
                "/transfer/preview",
                web::post()
                    .to(lead_transfer_preview)
                    .wrap(require_permission("crm:lead:transfer")),
            )
            // POST /lead/transfer - 执行线索转移
            .route(
                "/transfer",
                web::post()
                    .to(lead_transfer)
                    .wrap(require_permission("crm:lead:transfer")),
            ),
    );
    cfg.service(
        web::scope("/lead-pool")
            // GET /lead-pool/list - 公海线索列表
            .route(
                "/list",
                web::get()
                    .to(lead_pool_list)
                    .wrap(require_permission("crm:lead-pool:list")),
            )
            // GET /lead-pool/info - 公海线索详情
            .route(
                "/info",
                web::get()
                    .to(lead_pool_info)
                    .wrap(require_permission("crm:lead-pool:view")),
            )
            // DELETE /lead-pool/bath_delete - 批量删除公海线索
            .route(
                "/bath_delete",
                web::delete()
                    .to(bath_delete_lead_pool)
                    .wrap(require_permission("crm:lead-pool:delete")),
            )
            // POST /lead-pool/claim - 批量领取公海线索
            .route(
                "/claim",
                web::post()
                    .to(lead_pool_claim)
                    .wrap(require_permission("crm:lead-pool:claim")),
            )
            // POST /lead-pool/assign - 批量分配公海线索（管理员）
            .route(
                "/assign",
                web::post()
                    .to(lead_pool_assign)
                    .wrap(require_permission("crm:lead-pool:assign")),
            )
            // POST /lead-pool/release - 批量退回公海
            .route(
                "/release",
                web::post()
                    .to(lead_pool_release)
                    .wrap(require_permission("crm:lead-pool:release")),
            )
            // POST /lead-pool/recycle - 管理员收回线索
            .route(
                "/recycle",
                web::post()
                    .to(lead_pool_recycle)
                    .wrap(require_permission("crm:lead-pool:recycle")),
            )
            // GET /lead-pool/assign-history - 线索归属历史时间轴
            .route(
                "/assign-history",
                web::get()
                    .to(lead_pool_history)
                    .wrap(require_permission("crm:lead-pool:history")),
            )
            // POST /lead-pool/apply - 批量提交申领
            .route(
                "/apply",
                web::post()
                    .to(lead_pool_apply)
                    .wrap(require_permission("crm:lead-pool:apply")),
            )
            // GET /lead-pool/apply/page - 申领审批分页
            .route(
                "/apply/page",
                web::get()
                    .to(lead_pool_apply_page)
                    .wrap(require_permission("crm:lead-pool:apply-audit")),
            )
            // POST /lead-pool/apply/audit - 申领审批（通过=领取到名下）
            .route(
                "/apply/audit",
                web::post()
                    .to(lead_pool_apply_audit)
                    .wrap(require_permission("crm:lead-pool:apply-audit")),
            )
            // POST /lead-pool/retain/apply - 批量提交延期保留申请
            .route(
                "/retain/apply",
                web::post()
                    .to(lead_pool_retain_apply)
                    .wrap(require_permission("crm:lead-pool:retain")),
            )
            // GET /lead-pool/retain/page - 延期审批分页
            .route(
                "/retain/page",
                web::get()
                    .to(lead_pool_retain_page)
                    .wrap(require_permission("crm:lead-pool:retain-audit")),
            )
            // POST /lead-pool/retain/audit - 延期审批（通过=延长保留天数）
            .route(
                "/retain/audit",
                web::post()
                    .to(lead_pool_retain_audit)
                    .wrap(require_permission("crm:lead-pool:retain-audit")),
            ),
    );
}