//!
//! P1-6：客户列表导出（带自定义字段列）
//! 复用 customer_service::list 查询链路（数据权限/自定义字段筛选排序与列表接口完全同源）；
//! 表头 = 标准列 + 启用中 listVisible=1 字段 label（按 listSort 排序）；
//! 停用/删除字段不出现在导出（7.4 规则 6 / P0-22）；
//! 自定义字段输出格式化值：单选/多选 label 映射（失效项按 7.4 规则 3 兜底）、布尔是/否、成员批量映射用户名、金额数值列。

use std::collections::HashMap;

use rust_xlsxwriter::{Format, FormatAlign, Workbook};
use sea_orm::DbConn;

use crate::core::errors::error::{Error, Result};
use crate::modules::crm::model::customer::{CustomerListQuery, CustomerListVO};
use crate::modules::crm::service::customer_service;
use crate::modules::system::entity::field_def;
use crate::modules::system::model::field_def::FieldDefModel;
use crate::modules::system::service::{field_def_service, field_perm_service};

/// 导出行数上限（防全量导出拖垮内存；超限时提示用筛选条件缩小范围）
const EXPORT_MAX_ROWS: i64 = 100_000;

/// 单元格导出形态：文本或数值（数字/金额列写数值单元格，Excel 可直接求和）
enum ExportCell {
    Text(String),
    Num(f64),
}

/// 标准导出列：（表头, 敏感字段键 None=非敏感白名单字段不裁剪）
/// 手机号列对应 v45 白名单 crm_customer.personal_mobile，无可见权限的整列不导出（P2-1，v1.2 缺口修复）
const STD_COLUMNS: [(&str, Option<&str>); 12] = [
    ("客户编号", None),
    ("公司名称", None),
    ("个人姓名", None),
    ("类型", None),
    ("客户等级", None),
    ("客户来源", None),
    ("国家", None),
    ("地区", None),
    ("手机号", Some("personal_mobile")),
    ("负责人", None),
    ("创建人", None),
    ("创建时间", None),
];

/// 客户列表导出（P1-6）：返回 xlsx 二进制
pub async fn export_customers(db: &DbConn, query: &CustomerListQuery, current_user_id: i64) -> Result<Vec<u8>> {
    // 1. 复用列表查询链路：数据权限、cf 筛选/排序与列表接口完全同源，仅放大分页取全量
    let mut export_query = query.clone();
    export_query.page_num = Some(1);
    export_query.page_size = Some(EXPORT_MAX_ROWS);
    let page_data = customer_service::list(db, &export_query, current_user_id).await?;
    if page_data.total > EXPORT_MAX_ROWS {
        return Err(Error::from(format!(
            "导出数据量 {} 超过单次上限 {}，请用筛选条件缩小范围",
            page_data.total, EXPORT_MAX_ROWS
        )));
    }

    // 字段权限（P2-1，v1.2 缺口修复）：不可见的标准敏感列与自定义列整列不导出，与列表口径一致
    let (is_admin, role_keys) = field_def_service::load_user_role(db, current_user_id).await.unwrap_or((false, Vec::new()));
    let hidden_std: std::collections::HashSet<String> = field_perm_service::hidden_view_keys(db, "crm_customer", is_admin, &role_keys)
        .await
        .ok()
        .flatten()
        .unwrap_or_default();
    let hidden_cf = field_perm_service::hidden_custom_keys(db, "crm_customer", is_admin, &role_keys).await;
    let visible_std_cols: Vec<usize> = STD_COLUMNS
        .iter()
        .enumerate()
        .filter(|(_, (_, key))| !matches!(key, Some(k) if hidden_std.contains(*k)))
        .map(|(i, _)| i)
        .collect();

    // 2. 启用中且列表可见的字段定义（停用/删除不出现——7.4 规则 6；列序按 listSort；
    //    不可见角色配置的字段不出现——A8 后端口径，与列表裁剪一致）
    let defs = FieldDefModel::find_by_module(db, "crm_customer", true)
        .await
        .map_err(|e| Error::from(format!("读取字段定义失败: {}", e)))?;
    let mut cf_defs: Vec<field_def::Model> = defs
        .into_iter()
        .filter(|d| d.list_visible == Some(1))
        .filter(|d| !d.field_key.as_deref().map(|k| hidden_cf.contains(k)).unwrap_or(false))
        .collect();
    cf_defs.sort_by_key(|d| d.list_sort.unwrap_or(i32::MAX));

    // 3. 成员字段（10）：全量收集成员 id 一次性映射用户名（禁逐行查询，防 N+1）
    let member_ids: Vec<i64> = page_data
        .items
        .iter()
        .flat_map(|vo| {
            cf_defs
                .iter()
                .filter(|d| d.field_type == Some(10))
                .filter_map(|d| d.field_key.as_deref())
                .filter_map(|key| vo.custom_fields.as_ref().and_then(|cf| cf.get(key)))
                .filter_map(|v| v.as_array())
                .flatten()
                .filter_map(member_id_of)
        })
        .collect();
    let user_map = crate::modules::system::service::admin_service::build_admin_name_map(db, member_ids).await;

    // 4. 构建工作簿：表头 = 可见标准列 + 自定义字段 label
    let mut workbook = Workbook::new();
    let worksheet = workbook.add_worksheet();
    worksheet
        .set_name("客户列表")
        .map_err(|e| Error::from(e.to_string()))?;

    let header_format = Format::new()
        .set_bold()
        .set_background_color("#D9E1F2")
        .set_align(FormatAlign::Center);
    let money_format = Format::new().set_num_format("0.00");

    for (col, std_idx) in visible_std_cols.iter().enumerate() {
        worksheet
            .write_with_format(0, col as u16, STD_COLUMNS[*std_idx].0, &header_format)
            .map_err(|e| Error::from(e.to_string()))?;
    }
    let cf_base_col = visible_std_cols.len() as u16;
    for (i, d) in cf_defs.iter().enumerate() {
        worksheet
            .write_with_format(0, cf_base_col + i as u16, d.field_label.as_deref().unwrap_or(""), &header_format)
            .map_err(|e| Error::from(e.to_string()))?;
    }

    // 5. 数据行：先按 12 个标准列组装单元格，再仅写出可见列（列裁剪与表头一致）
    for (row_idx, vo) in page_data.items.iter().enumerate() {
        let row = (row_idx + 1) as u32;
        let type_str = match vo.customer_type {
            Some(1) => "企业",
            Some(2) => "个人",
            _ => "",
        };
        let cells: Vec<ExportCell> = vec![
            ExportCell::Text(vo.customer_no.as_deref().unwrap_or("").to_string()),
            ExportCell::Text(vo.company_name.as_deref().unwrap_or("").to_string()),
            ExportCell::Text(vo.person_name.as_deref().unwrap_or("").to_string()),
            ExportCell::Text(type_str.to_string()),
            ExportCell::Num(vo.level.map(|v| v as f64).unwrap_or(0.0)),
            ExportCell::Num(vo.source.map(|v| v as f64).unwrap_or(0.0)),
            ExportCell::Text(vo.country.as_deref().unwrap_or("").to_string()),
            ExportCell::Text(vo.region.as_deref().unwrap_or("").to_string()),
            ExportCell::Text(vo.personal_mobile.as_deref().unwrap_or("").to_string()),
            ExportCell::Text(vo.assignee_name.as_deref().unwrap_or("").to_string()),
            ExportCell::Text(vo.created_by_name.as_deref().unwrap_or("").to_string()),
            ExportCell::Text(vo.create_time.as_ref().map(|t| t.to_string()).unwrap_or_default()),
        ];
        for (col, std_idx) in visible_std_cols.iter().enumerate() {
            match &cells[*std_idx] {
                ExportCell::Text(s) => {
                    if !s.is_empty() {
                        worksheet.write(row, col as u16, s).map_err(xlsx_err)?;
                    }
                },
                ExportCell::Num(n) => {
                    worksheet.write_number(row, col as u16, *n).map_err(xlsx_err)?;
                },
            }
        }

        // 自定义字段列：按字段类型格式化输出
        for (i, d) in cf_defs.iter().enumerate() {
            let col = cf_base_col + i as u16;
            let key = d.field_key.as_deref().unwrap_or("");
            let cell = match vo.custom_fields.as_ref().and_then(|cf| cf.get(key)) {
                Some(v) => format_cf_value(d, v, &user_map),
                None => ExportCell::Text(String::new()),
            };
            match cell {
                ExportCell::Text(s) => {
                    if !s.is_empty() {
                        worksheet.write(row, col, s).map_err(xlsx_err)?;
                    }
                }
                ExportCell::Num(n) => {
                    if d.field_type == Some(11) {
                        worksheet
                            .write_number_with_format(row, col, n, &money_format)
                            .map_err(xlsx_err)?;
                    } else {
                        worksheet.write_number(row, col, n).map_err(xlsx_err)?;
                    }
                }
            }
        }
    }

    // 6. 统一列宽
    for col in 0..(cf_base_col + cf_defs.len() as u16) {
        worksheet.set_column_width(col, 16).map_err(xlsx_err)?;
    }

    workbook.save_to_buffer().map_err(|e| Error::from(e.to_string()))
}

/// 自定义字段值格式化（P1-6 验收：输出 label 与格式化值）
fn format_cf_value(def: &field_def::Model, value: &serde_json::Value, user_map: &HashMap<i64, String>) -> ExportCell {
    let ft = def.field_type.unwrap_or(1);
    match ft {
        // 3 数字：数值单元格
        3 => match value {
            serde_json::Value::Number(n) => ExportCell::Num(n.as_f64().unwrap_or(0.0)),
            serde_json::Value::String(s) => ExportCell::Num(s.trim().parse().unwrap_or(0.0)),
            _ => ExportCell::Text(String::new()),
        },
        // 11 金额：ISO 数字字符串 → 数值单元格（保留 Decimal 写入精度，显示 0.00）
        11 => match value.as_str().and_then(|s| s.trim().parse::<f64>().ok()) {
            Some(n) => ExportCell::Num(n),
            None => ExportCell::Text(String::new()),
        },
        // 6 单选：choices label 映射（7.4 规则 3 失效兜底）
        6 => ExportCell::Text(
            value
                .as_str()
                .map(|s| choice_label(def.options.as_ref(), s))
                .unwrap_or_default(),
        ),
        // 7 多选：逐项 label 映射后逗号连接
        7 => {
            let labels: Vec<String> = value
                .as_array()
                .map(|arr| {
                    arr.iter()
                        .map(|v| match v.as_str() {
                            Some(s) => choice_label(def.options.as_ref(), s),
                            None => v.to_string(),
                        })
                        .collect()
                })
                .unwrap_or_default();
            ExportCell::Text(labels.join(","))
        }
        // 10 成员：id → 用户名逗号连接（查不到名的兜底「用户{id}」）
        10 => {
            let names: Vec<String> = value
                .as_array()
                .map(|arr| {
                    arr.iter()
                        .filter_map(member_id_of)
                        .map(|id| user_map.get(&id).cloned().unwrap_or_else(|| format!("用户{}", id)))
                        .collect()
                })
                .unwrap_or_default();
            ExportCell::Text(names.join(","))
        }
        // 9 附件：展示文件名列表（对象取 name/fileName/url，字符串原样）
        9 => {
            let names: Vec<String> = value
                .as_array()
                .map(|arr| arr.iter().map(attachment_name).collect())
                .unwrap_or_default();
            ExportCell::Text(names.join(","))
        }
        // 8 布尔：是/否
        8 => ExportCell::Text(if value.as_bool().unwrap_or(false) { "是".to_string() } else { "否".to_string() }),
        // 1/2/4/5 及未知类型：字符串原样（日期/日期时间为 ISO 字符串，符合 7.4 渲染约定）
        _ => ExportCell::Text(match value {
            serde_json::Value::String(s) => s.clone(),
            serde_json::Value::Null => String::new(),
            other => other.to_string(),
        }),
    }
}

/// choices label 映射 + 失效兜底（7.4 规则 3）：仅 active 项参与匹配，匹配不到按「原始 value（已失效）」展示
fn choice_label(options: Option<&serde_json::Value>, value: &str) -> String {
    let active_choices = options
        .and_then(|o| o.get("choices"))
        .and_then(|c| c.as_array())
        .map(|arr| {
            arr.iter()
                .filter_map(|item| {
                    let v = item.get("value")?.as_str()?.to_string();
                    let l = item.get("label")?.as_str()?.to_string();
                    let a = item.get("active").and_then(|x| x.as_i64()).unwrap_or(1);
                    (a == 1).then_some((v, l))
                })
                .collect::<Vec<(String, String)>>()
        })
        .unwrap_or_default();
    match active_choices.iter().find(|(v, _)| v == value) {
        Some((_, l)) => l.clone(),
        None => format!("{}（已失效）", value),
    }
}

/// 成员数组元素提取 id（兼容 number 与数字字符串）
fn member_id_of(v: &serde_json::Value) -> Option<i64> {
    match v {
        serde_json::Value::Number(n) => n.as_i64(),
        serde_json::Value::String(s) => s.trim().parse::<i64>().ok(),
        _ => None,
    }
}

/// 附件数组元素提取展示名
fn attachment_name(v: &serde_json::Value) -> String {
    match v {
        serde_json::Value::String(s) => s.clone(),
        serde_json::Value::Object(obj) => obj
            .get("name")
            .or_else(|| obj.get("fileName"))
            .or_else(|| obj.get("url"))
            .and_then(|x| x.as_str())
            .unwrap_or("")
            .to_string(),
        other => other.to_string(),
    }
}

fn xlsx_err(e: rust_xlsxwriter::XlsxError) -> Error {
    Error::from(format!("xlsx 写入失败: {}", e))
}
