# -*- coding: utf-8 -*-
# E2E: calculation must not generate salary records for future hires
import json, re, sys, io
import urllib.request
import msgpack

sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8")
BASE = "http://127.0.0.1:8088"

def call(method, path, token=None, body=None):
    req = urllib.request.Request(BASE + path, method=method)
    req.add_header("Content-Type", "application/json")
    if token:
        req.add_header("Authorization", "Bearer " + token)
    data = json.dumps(body).encode("utf-8") if body is not None else None
    with urllib.request.urlopen(req, data=data, timeout=30) as resp:
        return msgpack.unpackb(resp.read(), raw=False)

r = call("POST", "/api/system/auth/login", body={"username": "admin", "password": "admin123"})
s = json.dumps(r, default=str)
toks = re.findall(r"eyJ[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+", s)
assert toks, "no jwt: " + s[:200]
token = max(toks, key=len)
print("1. login ok")

# 2. recalc June 2026 (all records are pending, allowed)
r = call("POST", "/api/system/finance/salary/calculate", token, {"year": 2026, "month": 6})
print("2. calculate 2026-06:", r.get("code"), r.get("msg"), "count=", r.get("data"))

# 3. list June and check employees
r = call("GET", "/api/system/finance/salary/list?year=2026&month=6&page=1&pageSize=50", token)
data = r.get("data") or []
rows = data if isinstance(data, list) else data.get("items") or []
names = sorted(row.get("employeeName") or "" for row in rows)
future = [n for n in names if n in ("张三", "李四", "财务专员", "财务经理", "CEO")]
print("3. June rows:", len(rows), names)
print("   future-hire leaked:", future if future else "NONE")
assert not future, "future hires leaked into June calculation"
print("ALL PASS")
