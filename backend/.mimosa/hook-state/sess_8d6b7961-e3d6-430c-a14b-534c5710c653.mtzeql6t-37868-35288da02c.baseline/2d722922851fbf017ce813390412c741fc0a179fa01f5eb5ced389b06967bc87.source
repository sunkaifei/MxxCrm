//!
//! 通用参数配置（mxx_system_config 自定义项）管理功能已下线：
//! 系统内置配置由各自专用页面维护（登录安全、出入库审核等），
//! 其余依赖方（权限缓存/员工初始密码/云存储/备份天数等）仅需读取，
//! 故本服务只保留核心查询与动态更新函数，供业务模块直接调用。
//!

use crate::core::errors::error::{Error, Result};
use crate::modules::system::model::config::{ConfigDetailVO, ConfigModel};
use sea_orm::DbConn;

/// 根据 key 更新 config_value（登录安全等系统配置动态更新用）
pub async fn update_value_by_key(db: &DbConn, key: &str, value: &str) -> Result<i64>{
    let config = ConfigModel::update_value_by_key(db, key, value).await?;
    Ok(config)
}

/// 根据键名查询
pub async fn select_by_key(db: &DbConn, key: &String)-> Result<ConfigDetailVO>{
    let config = ConfigModel::find_by_key(db, key.clone().as_str()).await?.ok_or_else(|| {
        Error::from(format!(
            "{}",
            "该系统配置信息未查到".to_string(),
        ))
    })?;
    let result = ConfigDetailVO::from(config);
    Ok(result)
}

/// 通过全局 CONTEXT 获取 db 连接，按 key 查询配置值（供无法传入 db 的场景使用，如 permission_cache_service）
pub async fn find_value_by_key_from_db(key: &str) -> Option<String> {
    let db = crate::core::kit::CONTEXT.get_db()?;
    match ConfigModel::find_by_key(&db, key).await {
        Ok(Some(config)) => config.config_value,
        _ => None,
    }
}
