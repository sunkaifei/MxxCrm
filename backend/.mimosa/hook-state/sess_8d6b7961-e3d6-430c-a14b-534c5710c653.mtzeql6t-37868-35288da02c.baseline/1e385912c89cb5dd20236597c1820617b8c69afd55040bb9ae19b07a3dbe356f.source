use sea_orm::*;
use sea_orm::sea_query::Expr;
use rust_decimal::Decimal;
use crate::core::errors::error::{Error, Result};
use crate::modules::inventory::entity::{transfer, transfer_item, stock, stock_log, warehouse, doc_change_log};
use crate::modules::inventory::model::transfer::*;
use crate::modules::inventory::service::stock_engine;
use crate::modules::inventory::service::warehouse_service;
use crate::modules::system::entity::admin;

/// 生成调拨单号：DB + yyyyMMdd + 4位流水号
pub async fn generate_transfer_no(db: &DatabaseConnection) -> Result<String> {
    let today = chrono::Local::now().format("%Y%m%d").to_string();
    let prefix = format!("DB{}", today);

    let max_no = transfer::Entity::find()
        .filter(transfer::Column::TransferNo.starts_with(&prefix))
        .order_by_desc(transfer::Column::TransferNo)
        .one(db)
        .await
        .map_err(|e| Error::from(e.to_string()))?;

    let seq = match max_no {
        Some(m) => {
            let no = m.transfer_no.unwrap_or_default();
            let seq_str = no.trim_start_matches(&prefix);
            seq_str.parse::<i32>().unwrap_or(0) + 1
        }
        None => 1,
    };

    Ok(format!("{}{:04}", prefix, seq))
}

/// 创建调拨单
pub async fn create(
    db: &DatabaseConnection,
    req: &TransferSaveRequest,
    created_by: i64,
) -> Result<i64> {
    if req.from_warehouse_id == req.to_warehouse_id {
        return Err(Error::from("源仓库和目标仓库不能相同".to_string()));
    }

    let mode = req.transfer_mode.clone().unwrap_or_else(|| "direct".to_string());

    // W12 申请模式：调入方发起，不校验源仓库存（B 看不到也不该看 A 的库存，填需求量；
    // 校验后移到调出方确认节点 confirm_adjust）
    if mode != "request" {
        // W7 直调边界：直调发起人必须是调出仓负责人（管理层/超管除外），
        // 否则提示走申请调拨——防止库管绕过隔离直调他人仓库
        let ident = crate::modules::inventory::service::warehouse_service::resolve_identity(db, created_by).await;
        if !ident.is_super && !ident.is_management {
            let src = warehouse::Entity::find_by_id(req.from_warehouse_id)
                .filter(warehouse::Column::Deleted.eq(0))
                .one(db)
                .await
                .map_err(|e| Error::from(e.to_string()))?;
            let is_src_manager = src.map(|w| w.manager_id == Some(created_by)).unwrap_or(false);
            if !is_src_manager {
                return Err(Error::from("无权直调他人仓库：你不是调出仓负责人，请使用申请调拨"));
            }
        }
        // 库存校验：检查源仓库每个产品的可用库存是否充足（只读发起人自己的仓）
        for item in &req.items {
        let stock_record = stock::Entity::find()
            .filter(stock::Column::ProductId.eq(item.product_id))
            .filter(stock::Column::WarehouseId.eq(req.from_warehouse_id))
            .filter(stock::Column::Deleted.eq(0))
            .one(db)
            .await
            .map_err(|e| Error::from(e.to_string()))?;

        match stock_record {
            Some(s) => {
                let available = s.available_quantity.unwrap_or_default();
                if item.quantity > available {
                    return Err(Error::from(format!(
                        "产品[{}]库存不足，当前可用: {}，需调拨: {}",
                        item.product_id, available, item.quantity
                    )));
                }
            }
            None => {
                return Err(Error::from(format!(
                    "产品[{}]在源仓库无库存记录",
                    item.product_id
                )));
            }
        }
        }
    }

    let transfer_no = generate_transfer_no(db).await?;
    let total_quantity: Decimal = req.items.iter()
        .map(|i| i.quantity)
        .sum();

    let transfer_id = db.transaction::<_, _, DbErr>(|txn| {
        let transfer_no = transfer_no.clone();
        let req = req.clone();
        let total_quantity = total_quantity;
        Box::pin(async move {
            // 1. 插入主表
            let id = insert_main(txn, &transfer_no, &req, total_quantity, created_by).await?;

            // 2. 插入明细
            let now = chrono::Local::now().naive_local();
            for item in &req.items {
                let item_active = transfer_item::ActiveModel {
                    transfer_id: Set(Some(id)),
                    product_id: Set(Some(item.product_id)),
                    sku_id: Set(item.sku_id),
                    product_name: Set(item.product_name.clone()),
                    product_sku: Set(item.product_sku.clone()),
                    quantity: Set(Some(item.quantity)),
                    remark: Set(item.remark.clone()),
                    deleted: Set(Some(0)),
                    create_time: Set(Some(now)),
                    update_time: Set(Some(now)),
                    ..Default::default()
                };
                item_active.insert(txn).await?;
            }

            Ok(id)
        })
    })
    .await
    .map_err(|e| Error::from(e.to_string()))?;

    Ok(transfer_id)
}

/// 编辑调拨单（仅草稿状态可编辑）
pub async fn update(
    db: &DatabaseConnection,
    id: i64,
    req: &TransferSaveRequest,
    updated_by: i64,
) -> Result<i64> {
    if req.from_warehouse_id == req.to_warehouse_id {
        return Err(Error::from("源仓库和目标仓库不能相同".to_string()));
    }

    let order = transfer::Entity::find_by_id(id)
        .filter(transfer::Column::Deleted.eq(0))
        .one(db)
        .await
        .map_err(|e| Error::from(e.to_string()))?
        .ok_or_else(|| Error::from("调拨单不存在".to_string()))?;

    if order.status.unwrap_or(0) != 0 {
        return Err(Error::from("仅草稿状态的调拨单可编辑".to_string()));
    }

    let total_quantity: Decimal = req.items.iter()
        .map(|i| i.quantity)
        .sum();

    db.transaction::<_, _, DbErr>(|txn| {
        let req = req.clone();
        let total_quantity = total_quantity;
        Box::pin(async move {
            // 1. 更新主表
            update_main(txn, id, &req, total_quantity, updated_by).await?;

            // 2. 软删除原明细
            transfer_item::Entity::update_many()
                .col_expr(transfer_item::Column::Deleted, Expr::value(1))
                .filter(transfer_item::Column::TransferId.eq(id))
                .exec(txn)
                .await?;

            // 3. 插入新明细
            let now = chrono::Local::now().naive_local();
            for item in &req.items {
                let item_active = transfer_item::ActiveModel {
                    transfer_id: Set(Some(id)),
                    product_id: Set(Some(item.product_id)),
                    product_name: Set(item.product_name.clone()),
                    product_sku: Set(item.product_sku.clone()),
                    quantity: Set(Some(item.quantity)),
                    remark: Set(item.remark.clone()),
                    deleted: Set(Some(0)),
                    create_time: Set(Some(now)),
                    update_time: Set(Some(now)),
                    ..Default::default()
                };
                item_active.insert(txn).await?;
            }

            Ok(())
        })
    })
    .await
    .map_err(|e| Error::from(e.to_string()))?;

    Ok(id)
}

/// 调拨出库（源仓库出库，在途库存增加）
pub async fn outbound(
    db: &DatabaseConnection,
    id: i64,
    updated_by: i64,
) -> Result<i64> {
    // 1. 查询调拨单
    let order = transfer::Entity::find_by_id(id)
        .filter(transfer::Column::Deleted.eq(0))
        .one(db)
        .await
        .map_err(|e| Error::from(e.to_string()))?
        .ok_or_else(|| Error::from("调拨单不存在".to_string()))?;

    // 调拨审批: 仅审批通过(status=2)的调拨单可执行出库
    if order.status.unwrap_or(0) != 2 {
        return Err(Error::from("仅审批通过的调拨单可出库（请先提交审批并通过仓管、CEO两级审批）".to_string()));
    }

    // 2. 查询明细
    let items = transfer_item::Entity::find()
        .filter(transfer_item::Column::TransferId.eq(id))
        .filter(transfer_item::Column::Deleted.eq(0))
        .all(db)
        .await
        .map_err(|e| Error::from(e.to_string()))?;

    if items.is_empty() {
        return Err(Error::from("调拨明细为空，无法出库".to_string()));
    }

    let from_warehouse_id = order.from_warehouse_id.unwrap_or_default();
    let to_warehouse_id = order.to_warehouse_id.unwrap_or_default();
    let transfer_no = order.transfer_no.clone().unwrap_or_default();

    // 3. 事务执行：扣减源仓库库存 + 增加目标仓库在途 + 写流水 + 更新状态
    db.transaction::<_, _, DbErr>(|txn| {
        let transfer_no = transfer_no.clone();
        let items = items.clone();
        Box::pin(async move {
            for item in &items {
                let product_id = item.product_id.unwrap_or_default();
                let quantity = item.quantity.unwrap_or_default();

                // 3.1 从源仓库扣减库存
                stock_engine::decrease_stock(txn, product_id, item.sku_id, from_warehouse_id, quantity).await?;

                // 3.2 增加目标仓库的 in_transit_quantity
                increase_in_transit(txn, product_id, item.sku_id, to_warehouse_id, quantity).await?;

                // 3.3 写入库存流水
                stock_engine::write_stock_log(
                    txn,
                    product_id,
                    item.sku_id,
                    from_warehouse_id,
                    None,
                    "transfer_out",
                    "transfer_out",
                    Some(id),
                    Some(&transfer_no),
                    -quantity,
                    Some(updated_by),
                    None,
                ).await?;
            }

            // 4. 更新调拨单状态为已出库(3)
            let now = chrono::Local::now().naive_local();
            transfer::Entity::update_many()
                .col_expr(transfer::Column::Status, Expr::value(3))
                .col_expr(transfer::Column::UpdatedBy, Expr::value(updated_by))
                .col_expr(transfer::Column::UpdateTime, Expr::value(now))
                .filter(transfer::Column::Id.eq(id))
                .filter(transfer::Column::Deleted.eq(0))
                .exec(txn)
                .await?;

            Ok(())
        })
    })
    .await
    .map_err(|e| Error::from(e.to_string()))?;

    Ok(id)
}

/// 调拨入库（目标仓库入库，在途库存减少）
pub async fn inbound(
    db: &DatabaseConnection,
    id: i64,
    updated_by: i64,
) -> Result<i64> {
    // 1. 查询调拨单
    let order = transfer::Entity::find_by_id(id)
        .filter(transfer::Column::Deleted.eq(0))
        .one(db)
        .await
        .map_err(|e| Error::from(e.to_string()))?
        .ok_or_else(|| Error::from("调拨单不存在".to_string()))?;

    let status = order.status.unwrap_or(0);
    if status != 3 {
        return Err(Error::from("仅已出库状态的调拨单可入库".to_string()));
    }

    // 2. 查询明细
    let items = transfer_item::Entity::find()
        .filter(transfer_item::Column::TransferId.eq(id))
        .filter(transfer_item::Column::Deleted.eq(0))
        .all(db)
        .await
        .map_err(|e| Error::from(e.to_string()))?;

    if items.is_empty() {
        return Err(Error::from("调拨明细为空，无法入库".to_string()));
    }

    let to_warehouse_id = order.to_warehouse_id.unwrap_or_default();
    let transfer_no = order.transfer_no.clone().unwrap_or_default();

    // 3. 事务执行：减少目标仓库在途 + 增加目标仓库库存 + 写流水 + 更新状态
    db.transaction::<_, _, DbErr>(|txn| {
        let transfer_no = transfer_no.clone();
        let items = items.clone();
        Box::pin(async move {
            for item in &items {
                let product_id = item.product_id.unwrap_or_default();
                let quantity = item.quantity.unwrap_or_default();

                // 3.1 减少目标仓库的 in_transit_quantity
                decrease_in_transit(txn, product_id, item.sku_id, to_warehouse_id, quantity).await?;

                // 3.2 向目标仓库增加库存
                stock_engine::increase_stock(txn, product_id, item.sku_id, to_warehouse_id, quantity, None).await?;

                // 3.3 写入库存流水
                stock_engine::write_stock_log(
                    txn,
                    product_id,
                    item.sku_id,
                    to_warehouse_id,
                    None,
                    "transfer_in",
                    "transfer_in",
                    Some(id),
                    Some(&transfer_no),
                    quantity,
                    Some(updated_by),
                    None,
                ).await?;
            }

            // 4. 更新调拨单状态为已完成(4)
            let now = chrono::Local::now().naive_local();
            transfer::Entity::update_many()
                .col_expr(transfer::Column::Status, Expr::value(4))
                .col_expr(transfer::Column::UpdatedBy, Expr::value(updated_by))
                .col_expr(transfer::Column::UpdateTime, Expr::value(now))
                .filter(transfer::Column::Id.eq(id))
                .filter(transfer::Column::Deleted.eq(0))
                .exec(txn)
                .await?;

            Ok(())
        })
    })
    .await
    .map_err(|e| Error::from(e.to_string()))?;

    Ok(id)
}

/// 取消调拨
pub async fn cancel(
    db: &DatabaseConnection,
    id: i64,
    updated_by: i64,
) -> Result<i64> {
    let order = transfer::Entity::find_by_id(id)
        .filter(transfer::Column::Deleted.eq(0))
        .one(db)
        .await
        .map_err(|e| Error::from(e.to_string()))?
        .ok_or_else(|| Error::from("调拨单不存在".to_string()))?;

    let status = order.status.unwrap_or(0);
    if status == 3 || status == 4 {
        return Err(Error::from("已完成或已取消的调拨单不可取消".to_string()));
    }

    let now = chrono::Local::now().naive_local();
    let result = transfer::Entity::update_many()
        .col_expr(transfer::Column::Status, Expr::value(4))
        .col_expr(transfer::Column::UpdatedBy, Expr::value(updated_by))
        .col_expr(transfer::Column::UpdateTime, Expr::value(now))
        .filter(transfer::Column::Id.eq(id))
        .filter(transfer::Column::Deleted.eq(0))
        .exec(db)
        .await
        .map_err(|e| Error::from(e.to_string()))?;
    Ok(result.rows_affected as i64)
}

/// 批量删除（调拨审批: 仅草稿(0)/已驳回(6)/已取消(5)可删除；审批中与审批通过后禁删）
pub async fn batch_delete(
    db: &DatabaseConnection,
    ids: &[i64],
    operator_id: i64,
) -> Result<i64> {
    let ids_vec = ids.to_vec();
    // 状态校验：审批中(1)/审批通过(2)/已出库(3)/已完成(4)禁止删除
    let rows = transfer::Entity::find()
        .filter(transfer::Column::Id.is_in(ids_vec.clone()))
        .filter(transfer::Column::Deleted.eq(0))
        .all(db)
        .await
        .map_err(|e| Error::from(e.to_string()))?;
    let blocked: Vec<String> = rows
        .iter()
        .filter(|r| matches!(r.status, Some(1) | Some(2) | Some(3) | Some(4)))
        .map(|r| format!("{}（审批中或已审批的单据不可删除）", r.transfer_no.clone().unwrap_or_default()))
        .collect();
    if !blocked.is_empty() {
        return Err(Error::from(format!("以下调拨单不可删除: {}", blocked.join("、"))));
    }
    db.transaction::<_, _, DbErr>(|txn| {
        Box::pin(async move {
            crate::modules::inventory::model::transfer::batch_delete(txn, &ids_vec, operator_id).await
        })
    })
    .await
    .map_err(|e| Error::from(e.to_string()))
}

// ==================== 调拨审批（仓管 → CEO 两级）====================

/// 提交审批（草稿/已驳回 → 审批中）：创建审批实例（transfer_approval 流：仓管 → CEO）
pub async fn submit_approval(
    db: &DatabaseConnection,
    id: i64,
    operator_id: i64,
    operator_name: &str,
) -> Result<i64> {
    let order = transfer::Entity::find_by_id(id)
        .filter(transfer::Column::Deleted.eq(0))
        .one(db)
        .await
        .map_err(|e| Error::from(e.to_string()))?
        .ok_or_else(|| Error::from("调拨单不存在".to_string()))?;

    let status = order.status.unwrap_or(0);
    if status != 0 && status != 6 {
        return Err(Error::from("仅草稿或已驳回的调拨单可提交审批".to_string()));
    }

    let transfer_no = order.transfer_no.clone().unwrap_or_default();
    let submit_req = crate::modules::approval::model::approval::ApprovalSubmitRequest {
        flow_code: "transfer_approval".to_string(),
        business_type: "transfer".to_string(),
        business_id: id,
        business_title: Some(transfer_no.clone()),
        submitter_id: operator_id,
        submitter_name: Some(operator_name.to_string()),
        extra_data: Some(serde_json::json!({
            "totalQuantity": order.total_quantity,
            "fromWarehouseId": order.from_warehouse_id,
            "toWarehouseId": order.to_warehouse_id,
        })),
        cc_user_ids: None,
        cc_reason: None,
    };
    let instance_id = crate::modules::approval::service::approval_service::ApprovalService::submit(db, &submit_req).await?;

    let now = chrono::Local::now().naive_local();
    transfer::Entity::update_many()
        .col_expr(transfer::Column::Status, Expr::value(1))
        .col_expr(transfer::Column::InstanceId, Expr::value(instance_id))
        .col_expr(transfer::Column::SubmittedBy, Expr::value(operator_id))
        .col_expr(transfer::Column::SubmitTime, Expr::value(now))
        .col_expr(transfer::Column::UpdatedBy, Expr::value(operator_id))
        .col_expr(transfer::Column::UpdateTime, Expr::value(now))
        .filter(transfer::Column::Id.eq(id))
        .filter(transfer::Column::Deleted.eq(0))
        .exec(db)
        .await
        .map_err(|e| Error::from(e.to_string()))?;
    Ok(id)
}

/// 审批通过（仓管/CEO 节点审批人调用）：推进审批引擎，实例完成后状态置审批通过(2)
pub async fn approve(
    db: &DatabaseConnection,
    id: i64,
    approver_id: i64,
    approver_name: &str,
    comment: Option<String>,
) -> Result<i64> {
    let order = transfer::Entity::find_by_id(id)
        .filter(transfer::Column::Deleted.eq(0))
        .one(db)
        .await
        .map_err(|e| Error::from(e.to_string()))?
        .ok_or_else(|| Error::from("调拨单不存在".to_string()))?;

    if order.status.unwrap_or(0) != 1 {
        return Err(Error::from("仅审批中的调拨单可进行审批操作".to_string()));
    }
    let instance_id = order
        .instance_id
        .ok_or_else(|| Error::from("审批实例不存在，请重新提交审批".to_string()))?;

    let process_req = crate::modules::approval::model::approval::ApprovalProcessRequest {
        instance_id,
        action: 1,
        approver_id,
        approver_name: Some(approver_name.to_string()),
        comment,
        ..Default::default()
    };
    crate::modules::approval::service::approval_service::ApprovalService::process(db, &process_req).await?;

    // 实例完成 → 审批通过（待出库）。引擎回调（write_back/完成分发）兜底，此处幂等同步
    let instance = crate::modules::approval::service::approval_service::ApprovalService::find_instance_by_id(db, instance_id)
        .await?
        .ok_or_else(|| Error::from("审批实例不存在".to_string()))?;
    if instance.status == 3 {
        transfer::Entity::update_many()
            .col_expr(transfer::Column::Status, Expr::value(2))
            .filter(transfer::Column::Id.eq(id))
            .filter(transfer::Column::Deleted.eq(0))
            .exec(db)
            .await
            .map_err(|e| Error::from(e.to_string()))?;
    }
    Ok(id)
}

/// 审批驳回：引擎驳回 + 状态回草稿（可编辑重提）
pub async fn reject(
    db: &DatabaseConnection,
    id: i64,
    approver_id: i64,
    approver_name: &str,
    comment: Option<String>,
) -> Result<i64> {
    let order = transfer::Entity::find_by_id(id)
        .filter(transfer::Column::Deleted.eq(0))
        .one(db)
        .await
        .map_err(|e| Error::from(e.to_string()))?
        .ok_or_else(|| Error::from("调拨单不存在".to_string()))?;

    if order.status.unwrap_or(0) != 1 {
        return Err(Error::from("仅审批中的调拨单可进行驳回操作".to_string()));
    }
    let instance_id = order
        .instance_id
        .ok_or_else(|| Error::from("审批实例不存在，请重新提交审批".to_string()))?;

    let process_req = crate::modules::approval::model::approval::ApprovalProcessRequest {
        instance_id,
        action: 2,
        approver_id,
        approver_name: Some(approver_name.to_string()),
        comment,
        ..Default::default()
    };
    crate::modules::approval::service::approval_service::ApprovalService::process(db, &process_req).await?;

    // 驳回 → 草稿（可编辑重提），清 instance_id（实例保留历史）
    transfer::Entity::update_many()
        .col_expr(transfer::Column::Status, Expr::value(0))
        .col_expr(transfer::Column::InstanceId, Expr::value(None::<i64>))
        .filter(transfer::Column::Id.eq(id))
        .filter(transfer::Column::Deleted.eq(0))
        .exec(db)
        .await
        .map_err(|e| Error::from(e.to_string()))?;
    Ok(id)
}

/// 获取调拨单详情
pub async fn get_detail(
    db: &DatabaseConnection,
    id: i64,
) -> Result<serde_json::Value> {
    let main = transfer::Entity::find_by_id(id)
        .filter(transfer::Column::Deleted.eq(0))
        .one(db)
        .await
        .map_err(|e| Error::from(e.to_string()))?
        .ok_or_else(|| Error::from("调拨单不存在".to_string()))?;

    let items = transfer_item::Entity::find()
        .filter(transfer_item::Column::TransferId.eq(id))
        .filter(transfer_item::Column::Deleted.eq(0))
        .all(db)
        .await
        .map_err(|e| Error::from(e.to_string()))?;

    // 补充仓库名称（详情页展示用）
    let mut main_value = serde_json::to_value(&main).map_err(|e| Error::from(e.to_string()))?;
    if let Some(obj) = main_value.as_object_mut() {
        if let Some(wid) = main.from_warehouse_id {
            if let Ok(Some(w)) = warehouse::Entity::find_by_id(wid).one(db).await {
                obj.insert("from_warehouse_name".to_string(), serde_json::json!(w.name));
                obj.insert("fromWarehouseName".to_string(), serde_json::json!(w.name));
            }
        }
        if let Some(wid) = main.to_warehouse_id {
            if let Ok(Some(w)) = warehouse::Entity::find_by_id(wid).one(db).await {
                obj.insert("to_warehouse_name".to_string(), serde_json::json!(w.name));
                obj.insert("toWarehouseName".to_string(), serde_json::json!(w.name));
            }
        }
        // 创建人姓名
        if let Some(uid) = main.created_by {
            if let Ok(Some(a)) = crate::modules::system::entity::admin::Entity::find_by_id(uid).one(db).await {
                let name = a.nick_name.clone().or(a.user_name.clone());
                obj.insert("createdByName".to_string(), serde_json::json!(name));
                obj.insert("created_by_name".to_string(), serde_json::json!(name));
            }
        }
    }

    Ok(serde_json::json!({
        "main": main_value,
        "items": items,
    }))
}

/// 调拨单列表查询
pub async fn get_list(
    db: &DatabaseConnection,
    query: &TransferListQuery,
    user_id: i64,
) -> Result<TransferListVO> {
    // W10 单据关系可见性：管理层/超管全量；其他人=我创建的 或 我负责仓库的进出单
    let ident = crate::modules::inventory::service::warehouse_service::resolve_identity(db, user_id).await;
    let scope = query.scope.clone().unwrap_or_default();
    let recycle = scope == "recycle";
    let vis = if ident.is_super || ident.is_management {
        None
    } else {
        let my_whs: Vec<i64> = warehouse::Entity::find()
            .filter(warehouse::Column::Deleted.eq(0))
            .filter(warehouse::Column::ManagerId.eq(user_id))
            .all(db)
            .await
            .map_err(|e| Error::from(e.to_string()))?
            .into_iter()
            .map(|w| w.id)
            .collect();
        Some(VisibilityScope { created_by: user_id, warehouse_ids: my_whs })
    };
    let deleted: i32 = if recycle { 1 } else { 0 };

    let (models, total) = select_page(db, query, vis.as_ref(), deleted)
        .await
        .map_err(|e| Error::from(e.to_string()))?;

    let mut items: Vec<TransferListItem> = models.into_iter().map(|m| m.into()).collect();

    // 补充仓库名称和创建人名称
    for item in &mut items {
        if let Some(wid) = item.from_warehouse_id {
            if let Ok(Some(wh)) = warehouse::Entity::find_by_id(wid)
                .filter(warehouse::Column::Deleted.eq(0))
                .one(db).await
            {
                item.from_warehouse_name = wh.name;
            }
        }
        if let Some(wid) = item.to_warehouse_id {
            if let Ok(Some(wh)) = warehouse::Entity::find_by_id(wid)
                .filter(warehouse::Column::Deleted.eq(0))
                .one(db).await
            {
                item.to_warehouse_name = wh.name;
            }
        }
        if let Some(cb) = item.created_by {
            if let Ok(Some(admin)) = admin::Entity::find_by_id(cb).one(db).await {
                item.created_by_name = admin.nick_name.or(admin.user_name);
            }
        }
    }

    // 回收站补删除人名称
    if recycle {
        let ids: Vec<i64> = items.iter().filter_map(|i| i.delete_by).collect();
        let mut names: std::collections::HashMap<i64, String> = std::collections::HashMap::new();
        if !ids.is_empty() {
            if let Ok(rows) = admin::Entity::find()
                .filter(admin::Column::Id.is_in(ids))
                .all(db)
                .await
            {
                for a in rows {
                    names.insert(a.id, a.nick_name.clone().or(a.user_name).unwrap_or_default());
                }
            }
        }
        for i in &mut items {
            if let Some(did) = i.delete_by {
                i.delete_by_name = names.get(&did).cloned();
            }
        }
    }

    Ok(TransferListVO { total: total as i64, items })
}

// ========== 内部辅助函数 ==========

async fn insert_main<C: ConnectionTrait>(
    db: &C,
    transfer_no: &str,
    req: &TransferSaveRequest,
    total_quantity: Decimal,
    created_by: i64,
) -> std::result::Result<i64, DbErr> {
    let now = chrono::Local::now().naive_local();
    let active = transfer::ActiveModel {
        transfer_no: Set(Some(transfer_no.to_string())),
        from_warehouse_id: Set(Some(req.from_warehouse_id)),
        to_warehouse_id: Set(Some(req.to_warehouse_id)),
        status: Set(Some(0)),
        total_quantity: Set(Some(total_quantity)),
        remark: Set(req.remark.clone()),
        transfer_mode: Set(Some(req.transfer_mode.clone().unwrap_or_else(|| "direct".to_string()))),
        deleted: Set(Some(0)),
        created_by: Set(Some(created_by)),
        updated_by: Set(Some(created_by)),
        create_time: Set(Some(now)),
        update_time: Set(Some(now)),
        ..Default::default()
    };
    let result = active.insert(db).await?;
    Ok(result.id)
}

async fn update_main<C: ConnectionTrait>(
    db: &C,
    id: i64,
    req: &TransferSaveRequest,
    total_quantity: Decimal,
    updated_by: i64,
) -> std::result::Result<i64, DbErr> {
    let now = chrono::Local::now().naive_local();
    let result = transfer::Entity::update_many()
        .col_expr(transfer::Column::FromWarehouseId, Expr::value(req.from_warehouse_id))
        .col_expr(transfer::Column::ToWarehouseId, Expr::value(req.to_warehouse_id))
        .col_expr(transfer::Column::TotalQuantity, Expr::value(total_quantity))
        .col_expr(transfer::Column::Remark, Expr::value(req.remark.clone()))
        .col_expr(transfer::Column::UpdatedBy, Expr::value(updated_by))
        .col_expr(transfer::Column::UpdateTime, Expr::value(now))
        .filter(transfer::Column::Id.eq(id))
        .filter(transfer::Column::Deleted.eq(0))
        .filter(transfer::Column::Status.eq(0))
        .exec(db)
        .await?;
    Ok(result.rows_affected as i64)
}

/// 增加目标仓库的在途库存
async fn increase_in_transit<C: ConnectionTrait>(
    db: &C,
    product_id: i64,
    sku_id: Option<i64>,
    warehouse_id: i64,
    quantity: Decimal,
) -> std::result::Result<(), DbErr> {
    let now = chrono::Local::now().naive_local();
    let existing = stock::Entity::find()
        .filter(stock::Column::ProductId.eq(product_id))
        .filter(stock_engine::sku_condition(sku_id))
        .filter(stock::Column::WarehouseId.eq(warehouse_id))
        .filter(stock::Column::Deleted.eq(0))
        .lock_exclusive()
        .one(db)
        .await?;

    match existing {
        Some(s) => {
            let current = s.in_transit_quantity.unwrap_or_default();
            let mut active: stock::ActiveModel = s.into();
            active.in_transit_quantity = Set(Some(current + quantity));
            active.update_time = Set(Some(now));
            active.update(db).await?;
        }
        None => {
            // 目标仓库无库存记录，创建一条（仅含在途数量）
            let active = stock::ActiveModel {
                product_id: Set(Some(product_id)),
                sku_id: Set(sku_id),
                warehouse_id: Set(Some(warehouse_id)),
                quantity: Set(Some(Decimal::ZERO)),
                reserved_quantity: Set(Some(Decimal::ZERO)),
                available_quantity: Set(Some(Decimal::ZERO)),
                in_transit_quantity: Set(Some(quantity)),
                frozen_quantity: Set(Some(Decimal::ZERO)),
                avg_cost: Set(Some(Decimal::ZERO)),
                last_in_cost: Set(None),
                total_cost: Set(Some(Decimal::ZERO)),
                deleted: Set(Some(0)),
                create_time: Set(Some(now)),
                update_time: Set(Some(now)),
                ..Default::default()
            };
            active.insert(db).await?;
        }
    }
    Ok(())
}

/// 减少目标仓库的在途库存
async fn decrease_in_transit<C: ConnectionTrait>(
    db: &C,
    product_id: i64,
    sku_id: Option<i64>,
    warehouse_id: i64,
    quantity: Decimal,
) -> std::result::Result<(), DbErr> {
    let now = chrono::Local::now().naive_local();
    let existing = stock::Entity::find()
        .filter(stock::Column::ProductId.eq(product_id))
        .filter(stock_engine::sku_condition(sku_id))
        .filter(stock::Column::WarehouseId.eq(warehouse_id))
        .filter(stock::Column::Deleted.eq(0))
        .lock_exclusive()
        .one(db)
        .await?;

    match existing {
        Some(s) => {
            let current = s.in_transit_quantity.unwrap_or_default();
            if current < quantity {
                return Err(DbErr::Custom(format!(
                    "在途库存不足：当前 {}，需要 {}", current, quantity
                )));
            }
            let mut active: stock::ActiveModel = s.into();
            active.in_transit_quantity = Set(Some(current - quantity));
            active.update_time = Set(Some(now));
            active.update(db).await?;
        }
        None => {
            return Err(DbErr::Custom("目标仓库库存记录不存在，无法减少在途库存".into()));
        }
    }
    Ok(())
}

/// W12 调出方确认调整（申请模式的调出方确认节点）：
/// A（调出仓负责人）校验自己库存后修正明细（删行/调减），写修改前后快照，
/// 随后通过当前审批节点流转 CEO 终审。
pub async fn confirm_adjust(
    db: &DatabaseConnection,
    id: i64,
    operator_id: i64,
    operator_name: &str,
    items: &[TransferItemRequest],
    reason: &str,
) -> Result<i64> {
    if reason.trim().is_empty() {
        return Err(Error::from("调整时必须填写理由"));
    }
    if items.is_empty() {
        return Err(Error::from("调整后的明细不能为空"));
    }
    let order = transfer::Entity::find_by_id(id)
        .filter(transfer::Column::Deleted.eq(0))
        .one(db)
        .await
        .map_err(|e| Error::from(e.to_string()))?
        .ok_or_else(|| Error::from("调拨单不存在".to_string()))?;
    if order.status.unwrap_or(0) != 1 {
        return Err(Error::from("仅审批中的调拨单可进行调出方确认"));
    }
    let instance_id = order
        .instance_id
        .ok_or_else(|| Error::from("审批实例不存在，请重新提交审批".to_string()))?;

    // 当前节点必须是调出方确认节点
    let inst = crate::modules::approval::model::approval::ApprovalModel::find_instance_by_id_raw(db, instance_id)
        .await
        .map_err(|e| Error::from(e.to_string()))?
        .ok_or_else(|| Error::from("审批实例不存在"))?;
    if inst.current_node_key.as_deref() != Some("warehouse_manager") {
        return Err(Error::from("当前节点不是调出方确认节点"));
    }

    // 仅调出仓负责人/管理层/超管可确认调整
    let ident = crate::modules::inventory::service::warehouse_service::resolve_identity(db, operator_id).await;
    if !ident.is_super && !ident.is_management {
        let src = warehouse::Entity::find_by_id(order.from_warehouse_id.unwrap_or(0))
            .one(db)
            .await
            .map_err(|e| Error::from(e.to_string()))?;
        let is_src_manager = src.map(|w| w.manager_id == Some(operator_id)).unwrap_or(false);
        if !is_src_manager {
            return Err(Error::from("仅调出仓负责人可确认调整"));
        }
    }

    // 修改前快照
    let old_items = transfer_item::Entity::find()
        .filter(transfer_item::Column::TransferId.eq(id))
        .filter(transfer_item::Column::Deleted.eq(0))
        .all(db)
        .await
        .map_err(|e| Error::from(e.to_string()))?;
    #[derive(serde::Serialize)]
    struct ItemSnap<'a> {
        product_id: i64,
        product_name: &'a Option<String>,
        quantity: Decimal,
    }
    let before_items: Vec<ItemSnap> = old_items.iter().map(|i| ItemSnap {
        product_id: i.product_id.unwrap_or(0),
        product_name: &i.product_name,
        quantity: i.quantity.unwrap_or_default(),
    }).collect();
    let before_snapshot = serde_json::json!({ "items": before_items });

    let total_quantity: Decimal = items.iter().map(|i| i.quantity).sum();
    let after_items: Vec<ItemSnap> = items.iter().map(|i| ItemSnap {
        product_id: i.product_id,
        product_name: &i.product_name,
        quantity: i.quantity,
    }).collect();
    let after_snapshot = serde_json::json!({ "items": after_items });

    let req_items: Vec<TransferItemRequest> = items.to_vec();
    let reason_owned = reason.to_string();
    let operator_name_owned = operator_name.to_string();

    db.transaction::<_, _, DbErr>(|txn| {
        let req_items = req_items.clone();
        let reason_owned = reason_owned.clone();
        let operator_name_owned = operator_name_owned.clone();
        let before_snapshot = before_snapshot.clone();
        let after_snapshot = after_snapshot.clone();
        let transfer_no = order.transfer_no.clone().unwrap_or_default();
        Box::pin(async move {
            // 软删旧明细 + 插入调整后明细
            transfer_item::Entity::update_many()
                .col_expr(transfer_item::Column::Deleted, Expr::value(1))
                .filter(transfer_item::Column::TransferId.eq(id))
                .exec(txn)
                .await?;
            let now = chrono::Local::now().naive_local();
            for item in &req_items {
                let item_active = transfer_item::ActiveModel {
                    transfer_id: Set(Some(id)),
                    product_id: Set(Some(item.product_id)),
                    sku_id: Set(item.sku_id),
                    product_name: Set(item.product_name.clone()),
                    product_sku: Set(item.product_sku.clone()),
                    quantity: Set(Some(item.quantity)),
                    remark: Set(item.remark.clone()),
                    deleted: Set(Some(0)),
                    create_time: Set(Some(now)),
                    update_time: Set(Some(now)),
                    ..Default::default()
                };
                item_active.insert(txn).await?;
            }
            // 主表总数回写
            transfer::Entity::update_many()
                .col_expr(transfer::Column::TotalQuantity, Expr::value(total_quantity))
                .col_expr(transfer::Column::UpdateTime, Expr::value(now))
                .filter(transfer::Column::Id.eq(id))
                .exec(txn)
                .await?;

            // 修改前后快照落库
            let log_active = doc_change_log::ActiveModel {
                doc_type: Set(Some("transfer".to_string())),
                doc_id: Set(Some(id)),
                doc_no: Set(Some(transfer_no)),
                action: Set(Some("调出方确认调整".to_string())),
                change_reason: Set(Some(reason_owned)),
                before_snapshot: Set(Some(before_snapshot)),
                after_snapshot: Set(Some(after_snapshot)),
                operator_id: Set(Some(operator_id)),
                operator_name: Set(Some(operator_name_owned)),
                create_time: Set(Some(now)),
                ..Default::default()
            };
            log_active.insert(txn).await?;
            Ok(())
        })
    })
    .await
    .map_err(|e| Error::from(e.to_string()))?;

    // 通过当前节点，流转 CEO 终审
    self::approve(db, id, operator_id, operator_name, Some(reason.to_string())).await
}

/// W12 调拨修改留痕查询（详情"流转记录"展示）
pub async fn change_logs(
    db: &DatabaseConnection,
    id: i64,
) -> Result<Vec<doc_change_log::Model>> {
    doc_change_log::Entity::find()
        .filter(doc_change_log::Column::DocType.eq("transfer"))
        .filter(doc_change_log::Column::DocId.eq(id))
        .order_by_desc(doc_change_log::Column::CreateTime)
        .all(db)
        .await
        .map_err(|e| Error::from(e.to_string()))
}

/// 回收站恢复（创建人/双方仓负责人/管理层）
pub async fn recycle_restore(db: &DatabaseConnection, id: i64, user_id: i64) -> Result<i64> {
    let ident = warehouse_service::resolve_identity(db, user_id).await;
    let order = transfer::Entity::find_by_id(id)
        .filter(transfer::Column::Deleted.eq(1))
        .one(db)
        .await
        .map_err(|e| Error::from(e.to_string()))?
        .ok_or_else(|| Error::from("回收站中不存在该调拨单"))?;
    if !ident.is_super && !ident.is_management && order.created_by != Some(user_id) {
        return Err(Error::from("无权操作他人单据"));
    }
    let now = chrono::Local::now().naive_local();
    transfer::Entity::update_many()
        .col_expr(transfer::Column::Deleted, Expr::value(0))
        .col_expr(transfer::Column::DeleteTime, Expr::value(None::<chrono::NaiveDateTime>))
        .col_expr(transfer::Column::DeleteBy, Expr::value(None::<i64>))
        .col_expr(transfer::Column::UpdateTime, Expr::value(now))
        .filter(transfer::Column::Id.eq(id))
        .exec(db)
        .await
        .map_err(|e| Error::from(e.to_string()))?;
    Ok(id)
}

/// 回收站彻底删除（仅管理层/超管，物理删除）
pub async fn recycle_purge(db: &DatabaseConnection, id: i64, user_id: i64) -> Result<i64> {
    let ident = warehouse_service::resolve_identity(db, user_id).await;
    if !ident.is_super && !ident.is_management {
        return Err(Error::from("无权操作他人单据"));
    }
    transfer::Entity::find_by_id(id)
        .filter(transfer::Column::Deleted.eq(1))
        .one(db)
        .await
        .map_err(|e| Error::from(e.to_string()))?
        .ok_or_else(|| Error::from("回收站中不存在该调拨单"))?;
    transfer::Entity::delete_by_id(id).exec(db).await.map_err(|e| Error::from(e.to_string()))?;
    Ok(id)
}
