use sea_orm::prelude::*;
use sea_orm::*;
use crate::core::kit::global::{Deserialize, Serialize};
use crate::modules::website::entity::{navigation, navigation::Entity as Navigation};

/// 导航保存 DTO
///
/// T-P0.1（B1 修复）：补 `#[serde(rename_all = "camelCase")]`，与 `NavigationListQuery` /
/// `NavigationDetailVO` 一致。此前缺失导致前端提交的 `navType/webUrl/parentId/dataType/isShow/
/// isNewWindowOpen` 等 camelCase 字段反序列化后全为 `None`，新增/编辑"存不对"。
#[derive(Default, Debug, Serialize, Deserialize, Clone)]
#[serde(rename_all(deserialize = "camelCase"))]
pub struct NavigationSaveDTO {
    /// 主键
    #[serde(default)]
    pub id: i64,
    /// 网站id
    pub website_id: Option<i64>,
    /// 父id
    pub parent_id: Option<i64>,
    /// 导航名称
    pub name: Option<String>,
    /// 自定义url地址
    pub web_url: Option<String>,
    /// 数据 id（关联对象的 ID）
    pub value: Option<i64>,
    /// 数据类型（custom:自定义导航, article_class:文章分类, product_class:产品分类,
    /// customview:自定义页面, article:文章, product:产品, link_group:分组标题）
    pub data_type: Option<String>,
    /// 导航类型（header/footer/sidebar/mobile/topbar）
    pub nav_type: Option<String>,
    /// 排序
    pub sort: Option<i32>,
    /// 是否显示（0否，1是）
    pub is_show: Option<i32>,
    /// 是否新窗口打开（0否，1是）
    pub is_new_window_open: Option<i32>,
    /// 链接打开方式（_self/_blank）
    pub target: Option<String>,
    /// 图标
    pub icon: Option<String>,
    /// 可见性：是否对未登录访客可见（0否，1是）
    pub visible_guest: Option<i32>,
    /// 可见性：可见设备，逗号分隔（pc,mobile；空=全部）
    pub visible_devices: Option<String>,
    /// SEO：rel 属性（nofollow/noopener 等）
    pub rel: Option<String>,
}

/// 导航列表查询参数
#[derive(Debug, Deserialize, Clone)]
#[serde(rename_all(deserialize = "camelCase"))]
pub struct NavigationListQuery {
    pub website_id: Option<i64>,
    pub nav_type: Option<String>,
    pub data_type: Option<String>,
    pub is_show: Option<i32>,
    /// 名称模糊搜索
    pub keywords: Option<String>,
    /// 页码（前端传 `page`）
    pub page: Option<u64>,
    /// 每页数量（前端传 `pageSize`）
    pub page_size: Option<u64>,
}

/// 导航详情VO
#[derive(Debug, Serialize, Deserialize, Clone)]
#[serde(rename_all(serialize = "camelCase"))]
pub struct NavigationDetailVO {
    pub id: Option<i64>,
    pub website_id: Option<i64>,
    pub parent_id: Option<i64>,
    pub name: Option<String>,
    pub web_url: Option<String>,
    pub value: Option<i64>,
    pub data_type: Option<String>,
    pub nav_type: Option<String>,
    pub sort: Option<i32>,
    pub is_show: Option<i32>,
    pub is_new_window_open: Option<i32>,
    pub target: Option<String>,
    pub icon: Option<String>,
    pub visible_guest: Option<i32>,
    pub visible_devices: Option<String>,
    pub rel: Option<String>,
    pub create_time: Option<DateTime>,
}

impl From<navigation::Model> for NavigationDetailVO {
    fn from(item: navigation::Model) -> Self {
        NavigationDetailVO {
            id: Option::from(item.id),
            website_id: item.website_id,
            parent_id: item.parent_id,
            name: item.name,
            web_url: item.web_url,
            value: item.value,
            data_type: item.data_type,
            nav_type: item.nav_type,
            sort: item.sort,
            is_show: item.is_show,
            is_new_window_open: item.is_new_window_open,
            target: item.target,
            icon: item.icon,
            visible_guest: item.visible_guest,
            visible_devices: item.visible_devices,
            rel: item.rel,
            create_time: item.create_time,
        }
    }
}

pub struct NavigationModel;

impl NavigationModel {

    /// # 新增导航设置
    /// * `db` 数据库链接
    /// * `website_id` 网站id，主要是为了防止忘了填写网站id才给单独提出来
    /// * `form_data` 需要提交的数据
    #[allow(dead_code)]
    pub async fn insert(db: &DbConn, website_id: i64, form_data: &NavigationSaveDTO) -> Result<i64, DbErr> {
        let now = chrono::Local::now().naive_local();
        let payload = navigation::ActiveModel {
            website_id:          Set(Some(website_id)),
            parent_id:           Set(Some(form_data.parent_id.unwrap_or(0))),
            name:                Set(form_data.name.to_owned()),
            web_url:             Set(form_data.web_url.to_owned()),
            value:               Set(form_data.value.to_owned()),
            data_type:           Set(form_data.data_type.to_owned()),
            nav_type:            Set(form_data.nav_type.to_owned()),
            sort:                Set(form_data.sort.to_owned()),
            is_show:             Set(form_data.is_show.to_owned()),
            is_new_window_open:  Set(form_data.is_new_window_open.to_owned()),
            target:              Set(form_data.target.to_owned()),
            icon:                Set(form_data.icon.to_owned()),
            visible_guest:       Set(form_data.visible_guest.to_owned()),
            visible_devices:     Set(form_data.visible_devices.to_owned()),
            rel:                 Set(form_data.rel.to_owned()),
            deleted:             Set(Some(0)),
            create_time:         Set(Some(now)),
            update_time:         Set(Some(now)),
            ..Default::default()
        };

        let res = Navigation::insert(payload).exec(db).await;
        Ok(res.map(|r| r.last_insert_id)?)
    }

    /// # 批量软删除（进回收站）——T-P2.4
    /// * `db` 数据库链接
    /// * `website_id` 网站id
    /// * `ids` 批量删除的id
    /// * `delete_by` 删除人（回收站可见性）
    #[allow(dead_code)]
    pub async fn batch_delete_by_ids(db: &DbConn, website_id: i64, ids: Vec<i64>, delete_by: i64) -> Result<i64, DbErr> {
        let now = chrono::Local::now().naive_local();
        let res = Navigation::update_many()
            .set(navigation::ActiveModel {
                deleted: Set(Some(1)),
                delete_by: Set(Some(delete_by)),
                delete_time: Set(Some(now)),
                update_time: Set(Some(now)),
                ..Default::default()
            })
            .filter(navigation::Column::Id.is_in(ids))
            .filter(navigation::Column::WebsiteId.eq(website_id))
            .filter(navigation::Column::Deleted.eq(0))
            .exec(db)
            .await?;
        Ok(res.rows_affected as i64)
    }

    /// # 更新导航设置
    /// * `db` 数据库链接
    /// * `website_id` 网站id
    /// * `form_data` 需要提交的数据
    #[allow(dead_code)]
    pub async fn update(db: &DbConn, website_id: i64, form_data: &NavigationSaveDTO) -> Result<i64, DbErr> {
        let now = chrono::Local::now().naive_local();
        let update_result = Navigation::update_many().set(
            navigation::ActiveModel {
                website_id:          Set(Some(website_id)),
                parent_id:           Set(Some(form_data.parent_id.unwrap_or(0))),
                name:                Set(form_data.name.to_owned()),
                web_url:             Set(form_data.web_url.to_owned()),
                value:               Set(form_data.value.to_owned()),
                data_type:           Set(form_data.data_type.to_owned()),
                nav_type:            Set(form_data.nav_type.to_owned()),
                sort:                Set(form_data.sort.to_owned()),
                is_show:             Set(form_data.is_show.to_owned()),
                is_new_window_open:  Set(form_data.is_new_window_open.to_owned()),
                target:              Set(form_data.target.to_owned()),
                icon:                Set(form_data.icon.to_owned()),
                visible_guest:       Set(form_data.visible_guest.to_owned()),
                visible_devices:     Set(form_data.visible_devices.to_owned()),
                rel:                 Set(form_data.rel.to_owned()),
                update_time:         Set(Some(now)),
                ..Default::default()
            }
        ).filter(navigation::Column::Id.eq(form_data.id))
            .filter(navigation::Column::WebsiteId.eq(website_id))
            .exec(db)
            .await?;
        Ok(update_result.rows_affected as i64)
    }

    /// # 仅更新排序（列表拖拽落库）——T-P1.3
    #[allow(dead_code)]
    pub async fn update_sort(db: &DbConn, website_id: i64, id: i64, sort: i32) -> Result<i64, DbErr> {
        let res = Navigation::update_many()
            .set(navigation::ActiveModel {
                sort: Set(Some(sort)),
                update_time: Set(Some(chrono::Local::now().naive_local())),
                ..Default::default()
            })
            .filter(navigation::Column::Id.eq(id))
            .filter(navigation::Column::WebsiteId.eq(website_id))
            .exec(db)
            .await?;
        Ok(res.rows_affected as i64)
    }

    /// # 根据名称查询（排除已删除）
    #[allow(dead_code)]
    pub async fn find_by_name_unique(db: &DbConn, website_id: &Option<i64>, data_type: &Option<String>, name: &Option<String>) -> Result<i64, DbErr> {
        let res = Navigation::find()
            .filter(navigation::Column::WebsiteId.eq(website_id.to_owned()))
            .filter(navigation::Column::DataType.eq(data_type.to_owned()))
            .filter(navigation::Column::Name.eq(name.to_owned()))
            .filter(navigation::Column::Deleted.eq(0))
            .one(db)
            .await?;
        Ok(res.map(|r| r.id).unwrap_or(0))
    }

    /// # 根据id查询（排除已删除）
    #[allow(dead_code)]
    pub async fn find_by_id(db: &DbConn, _website_id: i64, id: i64) -> Result<Option<navigation::Model>, DbErr> {
        let res = Navigation::find()
            .filter(navigation::Column::Id.eq(id))
            .filter(navigation::Column::Deleted.eq(0))
            .one(db)
            .await?;
        Ok(res)
    }

    /// # 查询所有（排除已删除，按 sort 升序）
    #[allow(dead_code)]
    pub async fn find_all(db: &DbConn, website_id: i64) -> Result<Vec<navigation::Model>, DbErr> {
        let res = Navigation::find()
            .filter(navigation::Column::WebsiteId.eq(website_id))
            .filter(navigation::Column::Deleted.eq(0))
            .order_by_asc(navigation::Column::Sort)
            .order_by_asc(navigation::Column::Id)
            .all(db)
            .await?;
        Ok(res)
    }

    /// # 分页 + 多条件查询——T-P1.4 / T-P1.6
    /// 返回 (本页数据, 总数)
    #[allow(dead_code)]
    pub async fn find_page(
        db: &DbConn,
        website_id: i64,
        query: &NavigationListQuery,
    ) -> Result<(Vec<navigation::Model>, u64), DbErr> {
        let page = std::cmp::max(query.page.unwrap_or(1), 1);
        let page_size = std::cmp::min(std::cmp::max(query.page_size.unwrap_or(20), 1), 200);

        let mut q = Navigation::find()
            .filter(navigation::Column::WebsiteId.eq(website_id))
            .filter(navigation::Column::Deleted.eq(0));

        if let Some(nt) = query.nav_type.clone().filter(|s| !s.trim().is_empty()) {
            q = q.filter(navigation::Column::NavType.eq(nt));
        }
        if let Some(dt) = query.data_type.clone().filter(|s| !s.trim().is_empty()) {
            q = q.filter(navigation::Column::DataType.eq(dt));
        }
        if let Some(show) = query.is_show {
            q = q.filter(navigation::Column::IsShow.eq(show));
        }
        if let Some(kw) = query.keywords.clone().filter(|s| !s.trim().is_empty()) {
            q = q.filter(navigation::Column::Name.contains(kw.trim()));
        }

        let paginator = q
            .order_by_asc(navigation::Column::Sort)
            .order_by_asc(navigation::Column::Id)
            .paginate(db, page_size);
        let total = paginator.num_items().await?;
        let rows = paginator.fetch_page(page - 1).await?;
        Ok((rows, total))
    }
}
