# -*- coding: utf-8 -*-
# E2E: employee number assignment fixes (start from X001, eligibility, permanent occupancy)
import json, re, sys, io
import urllib.request
import msgpack

sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8")
BASE = "http://127.0.0.1:8088"

def call(method, path, token=None, body=None):
    req = urllib.request.Request(BASE + path, method=method)
    req.add_header("Content-Type", "application/json")
    if token:
        req.add_header("Authorization", "Bearer " + token)
    data = json.dumps(body).encode("utf-8") if body is not None else None
    with urllib.request.urlopen(req, data=data, timeout=15) as resp:
        return msgpack.unpackb(resp.read(), raw=False)

r = call("POST", "/api/system/auth/login", body={"username": "admin", "password": "admin123"})
s = json.dumps(r, default=str)
toks = re.findall(r"eyJ[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+", s)
assert toks, "no jwt: " + s[:200]
token = max(toks, key=len)
print("1. login ok")

# 2. assign: expect only eligible accounts (audit=1, no number) -> rep gets X001
r = call("POST", "/api/system/admin/assign_employee_nos", token)
print("2. assign resp:", r.get("code"), r.get("msg"), "data=", r.get("data"))
assert r.get("code") == 200

# 3. assign again: no eligible left -> 0
r = call("POST", "/api/system/admin/assign_employee_nos", token)
print("3. assign(again):", r.get("code"), "data=", r.get("data"))

# 4. audit-approve zhangsan(id=9, pending) -> auto number X002
r = call("PUT", "/api/system/admin/audit/9", token, {"auditStatus": 1})
print("4. audit zhangsan:", r.get("code"), r.get("msg"))

print("DONE - verify DB state next")
