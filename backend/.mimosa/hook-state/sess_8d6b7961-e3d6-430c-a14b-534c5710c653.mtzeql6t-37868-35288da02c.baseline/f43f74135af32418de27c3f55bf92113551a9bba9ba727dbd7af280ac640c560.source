}

/// P1.1：到期自动流转（调度）：status=2 且 end_date < today → 4 + 日志
pub async fn expire_overdue(db: &DbConn) -> Result<u64> {
    let today = chrono::Local::now().date_naive();
    let targets = EntEntity::find()
        .filter(EntColumn::Deleted.eq(0))
        .filter(EntColumn::Status.eq(2))
        .filter(EntColumn::EndDate.is_not_null())
        .filter(EntColumn::EndDate.lt(today))
        .all(db).await.map_err(|e| Error::from(e.to_string()))?;
    let count = targets.len() as u64;
    for e in targets {
        EntitlementModel::update_status(db, e.id, 4).await.map_err(|e| Error::from(e.to_string()))?;
        EntitlementLogModel::log(db, e.id, log_action::EXPIRE_FLOW, Some(2), Some(4),
            None, None, Some("到期自动流转".to_string())).await.map_err(|e| Error::from(e.to_string()))?;
    }
    if count > 0 {
        log::info!("[entitlement] 到期流转完成：{} 条权益置为已到期", count);
    }
    Ok(count)
}

/// P1.2：到期提醒（30/7/1 天三档；站内信通知客户负责人）
pub async fn check_expiring(db: &DbConn, days_before: i64) -> Result<u64> {
    let today = chrono::Local::now().date_naive();
    let target = today + chrono::Duration::days(days_before);
    let ents = EntEntity::find()
        .filter(EntColumn::Deleted.eq(0))
        .filter(EntColumn::Status.eq(2))
        .filter(EntColumn::EndDate.is_not_null())
        .filter(EntColumn::EndDate.gte(today))
        .filter(EntColumn::EndDate.lte(target))
        .all(db).await.map_err(|e| Error::from(e.to_string()))?;
    let count = ents.len() as u64;
    if count == 0 {
        return Ok(0);
    }
    for e in &ents {
        let Some(cid) = e.customer_id else { continue };
        let owner_id = crate::modules::crm::entity::customer::Entity::find_by_id(cid)
            .one(db).await.ok().flatten()
            .and_then(|c| c.assigned_to);
        let Some(owner_id) = owner_id else { continue };
        let days_left = e.end_date.map(|d| (d - today).num_days()).unwrap_or(0);
        let title = format!("服务权益即将到期（剩 {} 天）", days_left);
        let content = format!(
            "权益 {}（{}）将于 {} 到期，请及时跟进续约。",
            e.entitlement_no.clone().unwrap_or_default(),
            e.product_name.clone().unwrap_or_default(),
            e.end_date.map(|d| d.format("%Y-%m-%d").to_string()).unwrap_or_default(),
        );
        let _ = crate::modules::message::service::notification_service::NotificationService::send_system_notification(
            db, owner_id, title, content, 8, Some("/sale/entitlement/list".to_string()),
        ).await;
    }
    Ok(count)
}

/// P1.7：月度统计
pub async fn summary(db: &DbConn) -> Result<serde_json::Value> {
    let today = chrono::Local::now().date_naive();
    let in30 = today + chrono::Duration::days(30);
    let month_start = NaiveDate::from_ymd_opt(today.year(), today.month(), 1).unwrap_or(today);
    let alive = EntColumn::Deleted.eq(0);
    let active_total = EntEntity::find().filter(alive.clone()).filter(EntColumn::Status.eq(2)).count(db).await
        .map_err(|e| Error::from(e.to_string()))? as i64;
    let expiring_in30 = EntEntity::find().filter(alive.clone()).filter(EntColumn::Status.eq(2))
        .filter(EntColumn::EndDate.gte(today)).filter(EntColumn::EndDate.lte(in30))
        .count(db).await.map_err(|e| Error::from(e.to_string()))? as i64;
    let expired_total = EntEntity::find().filter(alive.clone()).filter(EntColumn::Status.eq(4))
        .count(db).await.map_err(|e| Error::from(e.to_string()))? as i64;
    let renewed_this_month: i64 = match db.query_one_raw(sea_orm::Statement::from_string(
        db.get_database_backend(),
        format!(
            "SELECT count(*) AS c FROM mxx_sale_entitlement_log WHERE action = 6 AND create_time >= '{} 00:00:00'",
            month_start.format("%Y-%m-%d")
        ),
    )).await {
        Ok(Some(row)) => row.try_get::<i64>("", "c").unwrap_or(0),
        _ => 0,
    };
    let renew_rate = if expiring_in30 + renewed_this_month > 0 {
        (renewed_this_month as f64 * 100.0 / (renewed_this_month + expiring_in30) as f64).round() as i64
    } else {
        0
    };
    Ok(serde_json::json!({
        "activeTotal": active_total,
        "expiringIn30": expiring_in30,
        "expiredTotal": expired_total,
        "renewedThisMonth": renewed_this_month,
        "renewRate": renew_rate,
    }))
}
