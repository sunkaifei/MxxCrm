/// 日志 action 常量（1创建自动 2创建手动 3激活 4暂停 5取消 6续约 7删除 8还原 9配额扣减 10到期流转）
pub mod log_action {
    pub const CREATE_AUTO: i32 = 1;
    pub const CREATE_MANUAL: i32 = 2;
    pub const ACTIVATE: i32 = 3;
    pub const PAUSE: i32 = 4;
    pub const CANCEL: i32 = 5;
    pub const RENEW: i32 = 6;
    pub const DELETE: i32 = 7;
    pub const RESTORE: i32 = 8;
    pub const QUOTA_CONSUME: i32 = 9;
    pub const EXPIRE_FLOW: i32 = 10;
}

/// 单条 Model → ListVO
fn model_to_vo(m: crate::modules::sale::entity::entitlement::Model) -> EntitlementListVO {
    let end_date_naive = m.end_date;
    EntitlementListVO {
        id: m.id,
        entitlement_no: m.entitlement_no,
        order_id: m.order_id,
        customer_id: m.customer_id,
        product_id: m.product_id,
        product_name: m.product_name,
        entitlement_type: m.entitlement_type,
        entitlement_type_name: m.entitlement_type.map(|v| entitlement_type_name(v).to_string()),
        status: m.status,
        status_name: m.status.map(|v| entitlement_status_name(v).to_string()),
        start_date: m.start_date.map(|d| d.format("%Y-%m-%d").to_string()),
        end_date: m.end_date.map(|d| d.format("%Y-%m-%d").to_string()),
        duration_months: m.duration_months,
        auto_renew: m.auto_renew,
        renew_count: m.renew_count,
        remaining_days: remaining_days(end_date_naive),
        total_quota: m.total_quota,
        used_quota: m.used_quota,
        remaining_quota: m.remaining_quota,
        sla_level: m.sla_level,
        parent_entitlement_id: m.parent_entitlement_id,
        create_time: m.create_time.map(|t| t.format("%Y-%m-%d %H:%M:%S").to_string()),
        order_no: None,
        customer_name: None,
    }
}

/// P0.5：批量补全订单号/客户名（一次性 IN 查询，避免 N+1）
async fn enrich_rows(db: &DbConn, items: &mut [EntitlementListVO]) -> Result<()> {
    use crate::modules::crm::entity::customer::{Column as CustColumn, Entity as CustEntity};
    use crate::modules::sale::entity::order::{Column as OrderColumn, Entity as OrderEntity};

    let order_ids: Vec<i64> = items.iter().filter_map(|i| i.order_id).collect::<std::collections::HashSet<_>>().into_iter().collect();
    let customer_ids: Vec<i64> = items.iter().filter_map(|i| i.customer_id).collect::<std::collections::HashSet<_>>().into_iter().collect();

    let mut order_no_map = std::collections::HashMap::new();
    if !order_ids.is_empty() {
        let rows = OrderEntity::find()
            .filter(OrderColumn::Id.is_in(order_ids))
            .all(db).await.map_err(|e| Error::from(e.to_string()))?;
        for o in rows {
            if let Some(no) = o.order_no {
                order_no_map.insert(o.id, no);
            }
        }
    }
    let mut cust_map = std::collections::HashMap::new();
    if !customer_ids.is_empty() {
        let rows = CustEntity::find()
            .filter(CustColumn::Id.is_in(customer_ids))
            .all(db).await.map_err(|e| Error::from(e.to_string()))?;
        for c in rows {
            let name = c.company_name.or(c.short_name);
            if let Some(n) = name {
                cust_map.insert(c.id, n);
            }
        }
    }
    for it in items.iter_mut() {
        if let Some(oid) = it.order_id {
            it.order_no = order_no_map.get(&oid).cloned();
        }
        if let Some(cid) = it.customer_id {
            it.customer_name = cust_map.get(&cid).cloned();
        }
    }
    Ok(())
}

/// P1.5：取这批负责人名下客户的 ID 集合
async fn customer_ids_of_owners(db: &DbConn, owner_ids: &[i64]) -> Result<Vec<i64>> {
    use crate::modules::crm::entity::customer::{Column as CustColumn, Entity as CustEntity};
    let rows = CustEntity::find()
        .filter(CustColumn::AssignedTo.is_in(owner_ids.to_vec()))
        .filter(CustColumn::Deleted.eq(0))
        .all(db).await.map_err(|e| Error::from(e.to_string()))?;
    Ok(rows.into_iter().map(|c| c.id).collect())
}

/// 列表（P0.5 筛选四件套 + P1.2 autoRenew + P1.5 数据权限）
pub async fn get_list(
    db: &DbConn, query: &EntitlementListQuery
) -> Result<ResultPage<Vec<EntitlementListVO>>> {
    let page = query.page_num.unwrap_or(1).max(1);
    let page_size = query.page_size.unwrap_or(20).max(1);

    let mut cond = Condition::all();
    cond = cond.add(EntColumn::Deleted.eq(0));
    if let Some(cid) = query.customer_id { cond = cond.add(EntColumn::CustomerId.eq(cid)); }
    if let Some(oid) = query.order_id { cond = cond.add(EntColumn::OrderId.eq(oid)); }
    if let Some(s) = query.status { cond = cond.add(EntColumn::Status.eq(s)); }
    if let Some(t) = query.entitlement_type { cond = cond.add(EntColumn::EntitlementType.eq(t)); }
    // P0.5：关键词（权益编号/商品名 LIKE）
    if let Some(kw) = query.keywords.as_deref().filter(|k| !k.trim().is_empty()) {
        let like = format!("%{}%", kw.trim());
        cond = cond.add(Condition::any()
            .add(EntColumn::EntitlementNo.like(&like))
            .add(EntColumn::ProductName.like(&like)));
    }
    // P0.5：到期日期范围（end_date between）
    if let Some(sd) = query.start_date { cond = cond.add(EntColumn::EndDate.gte(sd)); }
    if let Some(ed) = query.end_date { cond = cond.add(EntColumn::EndDate.lte(ed)); }
    // P1.2：自动续约
    if let Some(ar) = query.auto_renew { cond = cond.add(EntColumn::AutoRenew.eq(ar)); }
    // P1.5：数据权限——非"全部数据"角色仅可见可访问负责人客户的权益
    if let Some(uid) = query.operator_id {
        let accessible = crate::modules::system::service::data_scope_service::get_accessible_user_ids(db, uid)
            .await.map_err(|e| Error::from(e.to_string()))?;
        if let Some(ids) = accessible {
            if ids.is_empty() {
                return Ok(ResultPage::new(Vec::new(), 0, page, page_size));
            }
            let cust_ids = customer_ids_of_owners(db, &ids).await?;
            if cust_ids.is_empty() {
                return Ok(ResultPage::new(Vec::new(), 0, page, page_size));
            }
            cond = cond.add(EntColumn::CustomerId.is_in(cust_ids));
        }
    }

    let paginator = EntEntity::find()
        .filter(cond)
        .order_by_desc(EntColumn::Id)
        .paginate(db, page_size as u64);

    let total = paginator.num_items().await.map_err(|e| Error::from(e.to_string()))? as i64;
    let rows = paginator.fetch_page((page - 1) as u64).await
        .map_err(|e| Error::from(e.to_string()))?;

    let mut items: Vec<EntitlementListVO> = rows.into_iter().map(model_to_vo).collect();
    enrich_rows(db, &mut items).await?;

    Ok(ResultPage::new(items, total, page, page_size))
}

/// 详情（P0.2 实装：完整 VO + 操作日志 + 续约链）
pub async fn get_detail(db: &DbConn, id: i64) -> Result<serde_json::Value> {
    let m = EntitlementModel::find_by_id(db, id).await
        .map_err(|e| Error::from(e.to_string()))?
        .ok_or_else(|| Error::from("权益不存在"))?;
    let mut vo = model_to_vo(m);
    enrich_rows(db, std::slice::from_mut(&mut vo)).await?;

    let logs = EntitlementLogModel::find_by_entitlement(db, id).await
        .map_err(|e| Error::from(e.to_string()))?;

    // P1.4：续约链沿 parent_entitlement_id 回溯（最多 20 层防环）
    let mut chain = Vec::new();
    let mut cur = vo.parent_entitlement_id;
    let mut depth = 0;
    while let Some(pid) = cur {
        if depth >= 20 { break; }
        depth += 1;
        match EntitlementModel::find_by_id(db, pid).await {
            Ok(Some(pm)) => {
                chain.push(serde_json::json!({
                    "id": pm.id,
                    "entitlementNo": pm.entitlement_no,
                    "status": pm.status,
                    "endDate": pm.end_date.map(|d| d.format("%Y-%m-%d").to_string()),
                    "renewCount": pm.renew_count,
                }));
                cur = pm.parent_entitlement_id;
            }
            _ => break,
        }
    }

    let mut json = serde_json::to_value(&vo).map_err(|e| Error::from(e.to_string()))?;
    if let Some(obj) = json.as_object_mut() {
        obj.insert("logs".into(), serde_json::to_value(&logs).unwrap_or_default());
        obj.insert("renewChain".into(), chain.into());
    }
    Ok(json)
}

/// 新建权益（手动，写日志 action=2）
pub async fn create(db: &DbConn, req: EntitlementSaveRequest, user_id: i64, user_name: Option<String>) -> Result<i64> {
    if req.customer_id.is_none() { return Err(Error::from("客户ID不能为空")); }
    if req.entitlement_type.is_none() { return Err(Error::from("权益类型不能为空")); }

    let date_prefix = format!("ENT{}", chrono::Local::now().format("%Y%m%d"));
    let max_seq = EntitlementModel::get_max_entitlement_no_today(db, &date_prefix).await
        .map_err(|e| Error::from(e.to_string()))?;
    let seq = max_seq.unwrap_or(0) + 1;
    let entitlement_no = format!("{}{:04}", date_prefix, seq);

    let id = EntitlementModel::insert(db, &req, Some(entitlement_no.clone()), Some(user_id)).await
        .map_err(|e| Error::from(e.to_string()))?;
    let _ = EntitlementLogModel::log(db, id, log_action::CREATE_MANUAL, None, Some(2),
        Some(user_id), user_name, Some(format!("手动创建 {}", entitlement_no))).await;
    Ok(id)
}

/// 订单确认时自动创建权益（B11 幂等 + P0.7 日志）
pub async fn create_for_order<C: ConnectionTrait>(
    db: &C, order_id: i64
) -> Result<Vec<i64>> {
    // B11 幂等：该订单已生成过权益则不再生成
    let existing = EntitlementModel::find_by_order(db, order_id).await
        .map_err(|e| Error::from(e.to_string()))?;
    if !existing.is_empty() {
        log::info!("[entitlement] 订单 {} 已存在 {} 条权益，跳过重复生成", order_id, existing.len());
        return Ok(existing.iter().map(|e| e.id).collect());
    }

    let order = OrderModel::find_by_id(db, order_id).await
        .map_err(|e| Error::from(e.to_string()))?
        .ok_or_else(|| Error::from("订单不存在"))?;
    let items = OrderItemModel::find_by_order_id(db, order_id).await
        .map_err(|e| Error::from(e.to_string()))?;
    let mut entitlement_ids = Vec::new();

    for item in items.iter() {
        let product_type = item.product_type.unwrap_or(PRODUCT_TYPE_PHYSICAL);
        if !needs_entitlement(product_type) { continue; }

        let item_id = item.id;
        let duration = item.service_duration.unwrap_or(12);
        let start_date = item.service_start_date
            .or(Some(chrono::Local::now().date_naive()));
        let end_date = start_date.map(|s| add_months(s, duration));

        let date_prefix = format!("ENT{}", chrono::Local::now().format("%Y%m%d"));
        let max_seq = EntitlementModel::get_max_entitlement_no_today(db, &date_prefix).await
            .map_err(|e| Error::from(e.to_string()))?;
        let seq = max_seq.unwrap_or(0) + 1 + entitlement_ids.len() as i64;
        let entitlement_no = format!("{}{:04}", date_prefix, seq);

        let req = EntitlementSaveRequest {
            order_id: Some(order_id),
            order_item_id: Some(item_id),
            customer_id: order.customer_id,
            product_id: item.product_id,
            product_name: item.product_name.clone(),
            entitlement_type: Some(match product_type {
                PRODUCT_TYPE_SERVICE => 1,
                PRODUCT_TYPE_SUBSCRIPTION => 2,
                _ => 1,
            }),
            start_date,
            end_date,
            duration_months: Some(duration),
            auto_renew: order.auto_renew,
            total_quota: None,
            sla_level: None,
            response_time_hours: None,
            resolution_time_hours: None,
            remark: Some("订单确认自动创建".to_string()),
        };
        let eid = EntitlementModel::insert(db, &req, Some(entitlement_no.clone()), None).await
            .map_err(|e| Error::from(e.to_string()))?;
        let _ = EntitlementLogModel::log(db, eid, log_action::CREATE_AUTO, None, Some(2),
            None, None, Some(format!("订单 {} 确认自动创建", order_id))).await;
        entitlement_ids.push(eid);
    }

    Ok(entitlement_ids)
}

/// 增加 N 月（处理跨年/月末）
fn add_months(date: NaiveDate, months: i32) -> NaiveDate {
    let total = date.year() * 12 + (date.month() as i32 - 1) + months;
    let new_year = total.div_euclid(12);
    let new_month = total.rem_euclid(12) + 1;
    let last_day_of_month = NaiveDate::from_ymd_opt(
        if new_month == 12 { new_year + 1 } else { new_year },
        if new_month == 12 { 1u32 } else { (new_month + 1) as u32 },
        1
    ).map(|d| d.pred_opt().unwrap_or(d).day())
     .unwrap_or(28);
    let day = date.day().min(last_day_of_month);
    NaiveDate::from_ymd_opt(new_year, new_month as u32, day).unwrap_or(date)
}

/// 续约（P0.1：起始日=旧 end_date+1；renew_count 原值+1；状态校验；写日志）
pub async fn renew(db: &DbConn, req: EntitlementRenewRequest, user_id: i64, user_name: Option<String>) -> Result<i64> {
    let old = EntitlementModel::find_by_id(db, req.old_entitlement_id).await
        .map_err(|e| Error::from(e.to_string()))?
        .ok_or_else(|| Error::from("原权益不存在"))?;

    let old_status = old.status.unwrap_or(0);
    if old_status == 5 {
        return Err(Error::from("已取消的权益不能续约"));
    }

    let txn = db.begin().await.map_err(|e| Error::from(e.to_string()))?;
    let from_status = old.status;
    if old_status != 4 {
        EntitlementModel::update_status(&txn, req.old_entitlement_id, 4).await
            .map_err(|e| Error::from(e.to_string()))?;
    }

    let date_prefix = format!("ENT{}", chrono::Local::now().format("%Y%m%d"));
    let max_seq = EntitlementModel::get_max_entitlement_no_today(&txn, &date_prefix).await
        .map_err(|e| Error::from(e.to_string()))?;
    let seq = max_seq.unwrap_or(0) + 1;
    let entitlement_no = format!("{}{:04}", date_prefix, seq);

    // P0.1：新权益起始日 = 旧权益 end_date + 1 天（剩余服务期不折损）；无 end_date 取今天
    let new_start = old.end_date.map(|d| d.succ_opt().unwrap_or(d))
        .unwrap_or_else(|| chrono::Local::now().date_naive());
    let duration = old.duration_months.unwrap_or(12);
    let new_end = add_months(new_start, duration);

    let new_req = EntitlementSaveRequest {
        order_id: Some(req.new_order_id),
        order_item_id: old.order_item_id,
        customer_id: old.customer_id,
        product_id: old.product_id,
        product_name: old.product_name.clone(),
        entitlement_type: old.entitlement_type,
        start_date: Some(new_start),
        end_date: Some(new_end),
        duration_months: old.duration_months,
        auto_renew: old.auto_renew,
        total_quota: old.total_quota,
        sla_level: old.sla_level.clone(),
        response_time_hours: old.response_time_hours,
        resolution_time_hours: old.resolution_time_hours,
        remark: Some(format!("续约自权益 #{}", req.old_entitlement_id)),
    };
    let new_id = EntitlementModel::insert(&txn, &new_req, Some(entitlement_no.clone()), Some(user_id)).await
        .map_err(|e| Error::from(e.to_string()))?;

    EntitlementModel::link_renewal(&txn, new_id, req.old_entitlement_id, old.renew_count).await
        .map_err(|e| Error::from(e.to_string()))?;

    EntitlementLogModel::log(&txn, req.old_entitlement_id, log_action::RENEW, from_status, Some(4),
        Some(user_id), user_name.clone(), Some(format!("续约为新权益 {}", entitlement_no))).await
        .map_err(|e| Error::from(e.to_string()))?;
    EntitlementLogModel::log(&txn, new_id, log_action::RENEW, None, Some(2),
        Some(user_id), user_name, Some(format!("自权益 #{} 续约生成", req.old_entitlement_id))).await
        .map_err(|e| Error::from(e.to_string()))?;

    txn.commit().await.map_err(|e| Error::from(e.to_string()))?;

    Ok(new_id)
}

/// P0.10：状态机白名单（1待激活 2生效中 3已暂停 4已到期 5已取消）
pub fn transition_allowed(from: i32, to: i32) -> bool {
    matches!(
        (from, to),
        (1, 2) | (2, 3) | (3, 2) | (2, 5) | (1, 5)
    )
}

/// 修改状态（P0.10 状态机 + 写日志）
pub async fn update_status(
    db: &DbConn, id: i64, status: i32,
    operator_id: Option<i64>, operator_name: Option<String>,
) -> Result<i64> {
    let m = EntitlementModel::find_by_id(db, id).await
        .map_err(|e| Error::from(e.to_string()))?
        .ok_or_else(|| Error::from("权益不存在"))?;
    let from = m.status.unwrap_or(0);
    if from == status {
        return Err(Error::from("状态未变化"));
    }
    if !transition_allowed(from, status) {
        return Err(Error::from(format!(
            "不允许的状态变更：{}({}) → {}({})。已到期权益请通过\"续约\"延续服务",
            entitlement_status_name(from), from, entitlement_status_name(status), status
        )));
    }
    let rows = EntitlementModel::update_status(db, id, status).await
        .map_err(|e| Error::from(e.to_string()))?;
    let action = match status {
        2 => log_action::ACTIVATE,
        3 => log_action::PAUSE,
        5 => log_action::CANCEL,
        _ => log_action::ACTIVATE,
    };
    EntitlementLogModel::log(db, id, action, Some(from), Some(status),
        operator_id, operator_name, None).await
        .map_err(|e| Error::from(e.to_string()))?;
    Ok(rows)
}

/// 按客户查询（P1.5：非全量权限角色仅见自己负责客户的权益）
pub async fn find_by_customer(db: &DbConn, customer_id: i64, operator_id: Option<i64>) -> Result<Vec<EntitlementListVO>> {
    if let Some(uid) = operator_id {
        let accessible = crate::modules::system::service::data_scope_service::get_accessible_user_ids(db, uid)
            .await.map_err(|e| Error::from(e.to_string()))?;
        if let Some(ids) = accessible {
            let allowed = customer_ids_of_owners(db, &ids).await?;
            if !allowed.contains(&customer_id) {
                return Err(Error::from("无权查看该客户的服务权益"));
            }
        }
    }
    let ents = EntitlementModel::find_by_customer(db, customer_id).await
        .map_err(|e| Error::from(e.to_string()))?;
    let mut items: Vec<EntitlementListVO> = ents.into_iter().map(model_to_vo).collect();
    enrich_rows(db, &mut items).await?;
    Ok(items)
}

/// P0.4：删除守卫——订单权益仅管理员；手建权益创建人 24h 内可删；生效中强拦（D1/D2）
pub async fn deletable(
    db: &DbConn, ids: &[i64], operator_id: i64,
) -> Result<()> {
    use crate::modules::crm::service::delete_guard_service;
    // 管理员口径（U3 修复）：仅超管（user_type=1）。
    // 注意不能用 is_manager(perm=delete)——持有 delete 码即视为管理员会使"订单权益仅管理员可删"循环失效
    let is_admin = delete_guard_service::is_super_admin(db, operator_id).await
        .map_err(|e| Error::from(e.to_string()))?;
    if is_admin {
        return Ok(());
    }
    for id in ids {
        let m = EntitlementModel::find_by_id(db, *id).await
            .map_err(|e| Error::from(e.to_string()))?
            .ok_or_else(|| Error::from(format!("权益 {} 不存在", id)))?;
        if m.status == Some(2) {
            return Err(Error::from(format!(
                "权益 {} 生效中，不能直接删除，请先取消",
                m.entitlement_no.clone().unwrap_or_default()
            )));
        }
        if m.create_by.is_none() {
            // 判别口径：order_id 为 NOT NULL 列，真实判据是 create_by——
            // 订单确认自动创建时 create_by=None（create_for_order），手动创建必有操作人
            return Err(Error::from(format!(
                "权益 {} 由订单生成，仅管理员可删除；如需退出服务请使用\"取消\"操作",
                m.entitlement_no.clone().unwrap_or_default()
            )));
        }
        if m.create_by == Some(operator_id) {
            if let Some(ct) = m.create_time {
                let elapsed = (chrono::Local::now().naive_local() - ct).num_hours();
                if elapsed <= 24 {
                    continue;
                }
            }
            return Err(Error::from(format!(
                "权益 {} 已超过 24 小时创建时间窗，仅管理员可删除",
                m.entitlement_no.clone().unwrap_or_default()
            )));
        }
        return Err(Error::from("仅创建人（24 小时内）或管理员可删除该权益"));
    }
    Ok(())
}

/// P0.4/P0.3：删除（守卫 + delete_by/delete_time + 日志）
pub async fn delete(db: &DbConn, ids: &[i64], operator_id: i64, operator_name: Option<String>) -> Result<i64> {
    deletable(db, ids, operator_id).await?;
    let rows = EntitlementModel::batch_delete(db, ids, Some(operator_id)).await
        .map_err(|e| Error::from(e.to_string()))?;
    for id in ids {
        let _ = EntitlementLogModel::log(db, *id, log_action::DELETE, None, None,
            Some(operator_id), operator_name.clone(), None).await;
    }
    Ok(rows)
}

/// P0.3：回收站还原
pub async fn restore(db: &DbConn, ids: &[i64], operator_id: i64, operator_name: Option<String>) -> Result<i64> {
    let rows = EntitlementModel::restore(db, ids).await
        .map_err(|e| Error::from(e.to_string()))?;
    for id in ids {
        let _ = EntitlementLogModel::log(db, *id, log_action::RESTORE, None, None,
            Some(operator_id), operator_name.clone(), Some("回收站还原".to_string())).await;
    }
    Ok(rows)
}

/// P1.3：配额扣减（事务 + FOR UPDATE + 流水 + 日志）
pub async fn consume(
    db: &DbConn, id: i64, amount: Decimal,
    biz_type: Option<i32>, biz_id: Option<i64>,
    operator_id: Option<i64>, remark: Option<String>,
) -> Result<Decimal> {
    if amount <= Decimal::ZERO {
        return Err(Error::from("扣减额度必须大于 0"));
    }
    let txn = db.begin().await.map_err(|e| Error::from(e.to_string()))?;
    let m = EntEntity::find_by_id(id)
        .lock_exclusive()
        .one(&txn).await.map_err(|e| Error::from(e.to_string()))?
        .ok_or_else(|| Error::from("权益不存在"))?;
    let remaining = m.remaining_quota.unwrap_or(Decimal::ZERO);
    if remaining < amount {
        return Err(Error::from(format!(
            "剩余额度不足：剩余 {:.2}，本次扣减 {:.2}", remaining, amount
        )));
    }
    let after = remaining - amount;
    let now = chrono::Local::now().naive_local();
    let used_total = m.used_quota.unwrap_or(Decimal::ZERO);
    let mut active: crate::modules::sale::entity::entitlement::ActiveModel = m.into();
    active.remaining_quota = sea_orm::Set(Some(after));
    active.used_quota = sea_orm::Set(Some(used_total + amount));
    active.update_time = sea_orm::Set(Some(now));
    active.update(&txn).await.map_err(|e| Error::from(e.to_string()))?;
    EntitlementUsageModel::insert(&txn, id, amount, remaining, after, biz_type, biz_id, operator_id, remark.clone()).await
        .map_err(|e| Error::from(e.to_string()))?;
    EntitlementLogModel::log(&txn, id, log_action::QUOTA_CONSUME, None, None, operator_id, None, remark).await
        .map_err(|e| Error::from(e.to_string()))?;
    txn.commit().await.map_err(|e| Error::from(e.to_string()))?;
    Ok(after)
}

/// P1.3：配额返还
pub async fn refund(
    db: &DbConn, id: i64, amount: Decimal,
    biz_type: Option<i32>, biz_id: Option<i64>,
    operator_id: Option<i64>, remark: Option<String>,
) -> Result<Decimal> {
    if amount <= Decimal::ZERO {
        return Err(Error::from("返还额度必须大于 0"));
    }
    let txn = db.begin().await.map_err(|e| Error::from(e.to_string()))?;
    let m = EntEntity::find_by_id(id)
        .lock_exclusive()
        .one(&txn).await.map_err(|e| Error::from(e.to_string()))?
        .ok_or_else(|| Error::from("权益不存在"))?;
    let remaining = m.remaining_quota.unwrap_or(Decimal::ZERO);
    let after = remaining + amount;
    let now = chrono::Local::now().naive_local();
    // P1.3 一致性：返还时 used_quota 同步扣减（保持 total = used + remaining 恒等）
    let used_after = (m.used_quota.unwrap_or(Decimal::ZERO) - amount).max(Decimal::ZERO);
    let mut active: crate::modules::sale::entity::entitlement::ActiveModel = m.into();
    active.remaining_quota = sea_orm::Set(Some(after));
    active.used_quota = sea_orm::Set(Some(used_after));
    active.update_time = sea_orm::Set(Some(now));
    active.update(&txn).await.map_err(|e| Error::from(e.to_string()))?;
    EntitlementUsageModel::insert(&txn, id, -amount, remaining, after, biz_type, biz_id, operator_id, remark).await
        .map_err(|e| Error::from(e.to_string()))?;
    txn.commit().await.map_err(|e| Error::from(e.to_string()))?;
    Ok(after)
}

