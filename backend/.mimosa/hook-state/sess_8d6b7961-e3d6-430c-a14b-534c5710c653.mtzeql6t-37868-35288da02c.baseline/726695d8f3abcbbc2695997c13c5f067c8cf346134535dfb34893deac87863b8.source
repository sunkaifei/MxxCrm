//!
//! 服务权益控制器
//!
//! ## 路由表
//!
//! | 方法   | 路径                              | 权限码                       | handler      | 说明              |
//! |--------|----------------------------------|------------------------------|--------------|------------------|
//! | GET    | /sale/entitlement/list           | sale:entitlement:list        | list         | 权益列表          |
//! | GET    | /sale/entitlement/info           | sale:entitlement:view        | info         | 权益详情（P0.2 实装） |
//! | POST   | /sale/entitlement/save           | sale:entitlement:save        | save         | 新建权益（手动）  |
//! | PUT    | /sale/entitlement/update         | sale:entitlement:update      | update       | 修改状态（P0.10 DTO 化+状态机） |
//! | POST   | /sale/entitlement/renew          | sale:entitlement:renew       | renew        | 续约（P0.9 权限码对齐） |
//! | GET    | /sale/entitlement/by-customer    | sale:entitlement:list        | by_customer  | 按客户查询        |
//! | DELETE | /sale/entitlement/delete         | sale:entitlement:delete      | delete       | 批量删除（P0.3/P0.4 守卫+回收站） |
//! | GET    | /sale/entitlement/log/list       | sale:entitlement:view        | log_list     | 操作日志（P0.7） |
//! | GET    | /sale/entitlement/usage/list     | sale:entitlement:view        | usage_list   | 配额流水（P1.3） |
//! | POST   | /sale/entitlement/usage/consume  | sale:entitlement:update      | consume      | 配额扣减（P1.3） |
//! | POST   | /sale/entitlement/usage/refund   | sale:entitlement:update      | refund       | 配额返还（P1.3） |
//! | GET    | /sale/entitlement/summary        | sale:entitlement:list        | summary      | 月度统计（P1.7） |
//!

use actix_web::{web, HttpRequest, HttpResponse};
use serde::Deserialize;
use crate::core::kit::global::AppState;
use crate::core::web::base_controller::{get_current_user, get_current_user_id};
use crate::core::web::entity::common::InfoId;
use crate::core::web::permission_guard::require_permission;
use crate::core::web::response::{MetaResp, MPACK};
use crate::modules::sale::model::entitlement::{
    EntitlementListQuery, EntitlementRenewRequest, EntitlementSaveRequest,
};
use crate::modules::sale::service::entitlement_service;

/// 权益列表
pub async fn list(
    state: web::Data<AppState>,
    req: HttpRequest,
    query: web::Query<EntitlementListQuery>,
) -> HttpResponse {
    let db = &state.db;
    let mut query = query.0;
    // P1.5 数据权限：注入当前用户
    query.operator_id = Some(get_current_user_id(&req));
    match entitlement_service::get_list(db, &query).await {
        Ok(page_data) => {
            let page = page_data.current_page as u32;
            let total = page_data.total as u32;
            HttpResponse::Ok().content_type(MPACK)
                .body(MetaResp::success_with_page(page_data, "local", page, total))
        }
        Err(e) => HttpResponse::Ok().content_type(MPACK)
            .body(MetaResp::<String>::fail(400, &e.to_string(), "local")),
    }
}

/// 权益详情（P0.2 实装）
pub async fn info(state: web::Data<AppState>, item: web::Query<InfoId>) -> HttpResponse {
    let db = &state.db;
    let item = item.0;
    let Some(id) = item.id else {
        return HttpResponse::Ok().content_type(MPACK)
            .body(MetaResp::<String>::fail(400, "权益ID不能为空", "local"));
    };
    match entitlement_service::get_detail(db, id).await {
        Ok(data) => HttpResponse::Ok().content_type(MPACK)
            .body(MetaResp::success(data, "local")),
        Err(e) => HttpResponse::Ok().content_type(MPACK)
            .body(MetaResp::<String>::fail(400, &e.to_string(), "local")),
    }
}

/// 新建权益
pub async fn save(
    state: web::Data<AppState>,
    req: HttpRequest,
    form_data: web::Json<EntitlementSaveRequest>,
) -> HttpResponse {
    let db = &state.db;
    let user_id = get_current_user_id(&req);
    let (_, username) = get_current_user(&req);
    match entitlement_service::create(db, form_data.0, user_id, Some(username)).await {
        Ok(id) => HttpResponse::Ok().content_type(MPACK)
            .body(MetaResp::success(id, "local")),
        Err(e) => HttpResponse::Ok().content_type(MPACK)
            .body(MetaResp::<String>::fail(400, &e.to_string(), "local")),
    }
}

/// P0.10：修改权益状态（DTO 化 + 状态机白名单）
#[derive(Deserialize)]
#[serde(rename_all(deserialize = "camelCase"))]
pub struct EntitlementUpdateRequest {
    pub id: i64,
    pub status: i32,
}

pub async fn update(
    state: web::Data<AppState>,
    req: HttpRequest,
    form_data: web::Json<EntitlementUpdateRequest>,
) -> HttpResponse {
    let db = &state.db;
    let dto = form_data.0;
    let (user_id, username) = get_current_user(&req);
    match entitlement_service::update_status(db, dto.id, dto.status, Some(user_id), Some(username)).await {
        Ok(rows) => HttpResponse::Ok().content_type(MPACK)
            .body(MetaResp::success(rows, "local")),
        Err(e) => HttpResponse::Ok().content_type(MPACK)
            .body(MetaResp::<String>::fail(400, &e.to_string(), "local")),
    }
}

/// 续约
pub async fn renew(
    state: web::Data<AppState>,
    req: HttpRequest,
    form_data: web::Json<EntitlementRenewRequest>,
) -> HttpResponse {
    let db = &state.db;
    let (user_id, username) = get_current_user(&req);
    match entitlement_service::renew(db, form_data.0, user_id, Some(username)).await {
        Ok(id) => HttpResponse::Ok().content_type(MPACK)
            .body(MetaResp::success(id, "local")),
        Err(e) => HttpResponse::Ok().content_type(MPACK)
            .body(MetaResp::<String>::fail(400, &e.to_string(), "local")),
    }
}

/// 按客户查询权益
pub async fn by_customer(
    state: web::Data<AppState>,
    req: HttpRequest,
    item: web::Query<InfoId>,
) -> HttpResponse {
    let db = &state.db;
    let item = item.0;
    if item.id.is_none() {
        return HttpResponse::Ok().content_type(MPACK)
            .body(MetaResp::<String>::fail(400, "客户ID不能为空", "local"));
    }
    let operator_id = get_current_user_id(&req);
    match entitlement_service::find_by_customer(db, item.id.unwrap(), Some(operator_id)).await {
        Ok(list) => HttpResponse::Ok().content_type(MPACK)
            .body(MetaResp::success(list, "local")),
        Err(e) => HttpResponse::Ok().content_type(MPACK)
            .body(MetaResp::<String>::fail(400, &e.to_string(), "local")),
    }
}

/// P0.3/P0.4：批量删除（守卫 + 回收站留痕）
pub async fn delete(
    state: web::Data<AppState>,
    req: HttpRequest,
    item: web::Json<Vec<i64>>,
) -> HttpResponse {
    let db = &state.db;
    let ids = item.into_inner();
    if ids.is_empty() {
        return HttpResponse::Ok().content_type(MPACK)
            .body(MetaResp::<String>::fail(400, "请选择要删除的记录", "local"));
    }
    let (user_id, username) = get_current_user(&req);
    match entitlement_service::delete(db, &ids, user_id, Some(username)).await {
        Ok(count) => HttpResponse::Ok().content_type(MPACK)
            .body(MetaResp::success(count, "local")),
        Err(e) => HttpResponse::Ok().content_type(MPACK)
            .body(MetaResp::<String>::fail(400, &e.to_string(), "local")),
    }
}

/// P0.3：回收站还原
pub async fn restore(
    state: web::Data<AppState>,
    req: HttpRequest,
    item: web::Json<Vec<i64>>,
) -> HttpResponse {
    let db = &state.db;
    let ids = item.into_inner();
    if ids.is_empty() {
        return HttpResponse::Ok().content_type(MPACK)
            .body(MetaResp::<String>::fail(400, "请选择要还原的记录", "local"));
    }
    let (user_id, username) = get_current_user(&req);
    match entitlement_service::restore(db, &ids, user_id, Some(username)).await {
        Ok(count) => HttpResponse::Ok().content_type(MPACK)
            .body(MetaResp::success(count, "local")),
        Err(e) => HttpResponse::Ok().content_type(MPACK)
            .body(MetaResp::<String>::fail(400, &e.to_string(), "local")),
    }
}

