/// P1.3：配额扣减
#[derive(Deserialize)]
#[serde(rename_all(deserialize = "camelCase"))]
pub struct UsageConsumeRequest {
    pub id: i64,
    pub amount: f64,
    pub biz_type: Option<i32>,
    pub biz_id: Option<i64>,
    pub remark: Option<String>,
}

pub async fn consume(
    state: web::Data<AppState>,
    req: HttpRequest,
    form_data: web::Json<UsageConsumeRequest>,
) -> HttpResponse {
    let db = &state.db;
    let dto = form_data.0;
    let user_id = get_current_user_id(&req);
    let amount = rust_decimal::Decimal::from_f64_retain(dto.amount)
        .unwrap_or(rust_decimal::Decimal::ZERO);
    if amount <= rust_decimal::Decimal::ZERO {
        return HttpResponse::Ok().content_type(MPACK)
            .body(MetaResp::<String>::fail(400, "扣减额度必须大于 0", "local"));
    }
    match entitlement_service::consume(db, dto.id, amount, dto.biz_type, dto.biz_id, Some(user_id), dto.remark).await {
        Ok(after) => HttpResponse::Ok().content_type(MPACK)
            .body(MetaResp::success(after, "local")),
        Err(e) => HttpResponse::Ok().content_type(MPACK)
            .body(MetaResp::<String>::fail(400, &e.to_string(), "local")),
    }
}

/// P1.3：配额返还
pub async fn refund(
    state: web::Data<AppState>,
    req: HttpRequest,
    form_data: web::Json<UsageConsumeRequest>,
) -> HttpResponse {
    let db = &state.db;
    let dto = form_data.0;
    let user_id = get_current_user_id(&req);
    let amount = rust_decimal::Decimal::from_f64_retain(dto.amount)
        .unwrap_or(rust_decimal::Decimal::ZERO);
    if amount <= rust_decimal::Decimal::ZERO {
        return HttpResponse::Ok().content_type(MPACK)
            .body(MetaResp::<String>::fail(400, "返还额度必须大于 0", "local"));
    }
    match entitlement_service::refund(db, dto.id, amount, dto.biz_type, dto.biz_id, Some(user_id), dto.remark).await {
        Ok(after) => HttpResponse::Ok().content_type(MPACK)
            .body(MetaResp::success(after, "local")),
        Err(e) => HttpResponse::Ok().content_type(MPACK)
            .body(MetaResp::<String>::fail(400, &e.to_string(), "local")),
    }
}

/// P1.7：月度统计
pub async fn summary(state: web::Data<AppState>) -> HttpResponse {
    let db = &state.db;
    match entitlement_service::summary(db).await {
        Ok(data) => HttpResponse::Ok().content_type(MPACK)
            .body(MetaResp::success(data, "local")),
        Err(e) => HttpResponse::Ok().content_type(MPACK)
            .body(MetaResp::<String>::fail(400, &e.to_string(), "local")),
    }
}

/// 注册服务权益模块所有路由
pub fn register(cfg: &mut web::ServiceConfig) {
    cfg.service(
        web::scope("/sale/entitlement")
            .route("/list", web::get().to(list).wrap(require_permission("sale:entitlement:list")))
            .route("/info", web::get().to(info).wrap(require_permission("sale:entitlement:view")))
            .route("/save", web::post().to(save).wrap(require_permission("sale:entitlement:save")))
            .route("/update", web::put().to(update).wrap(require_permission("sale:entitlement:update")))
            .route("/renew", web::post().to(renew).wrap(require_permission("sale:entitlement:renew")))
            .route("/delete", web::delete().to(delete).wrap(require_permission("sale:entitlement:delete")))
            .route("/restore", web::post().to(restore).wrap(require_permission("sale:entitlement:delete")))
            .route("/by-customer", web::get().to(by_customer).wrap(require_permission("sale:entitlement:list")))
            .route("/log/list", web::get().to(log_list).wrap(require_permission("sale:entitlement:view")))
            .route("/usage/list", web::get().to(usage_list).wrap(require_permission("sale:entitlement:view")))
            .route("/usage/consume", web::post().to(consume).wrap(require_permission("sale:entitlement:update")))
            .route("/usage/refund", web::post().to(refund).wrap(require_permission("sale:entitlement:update")))
            .route("/summary", web::get().to(summary).wrap(require_permission("sale:entitlement:list"))),
    );
}
